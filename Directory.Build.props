<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <AnalysisLevel>10.0</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <DropSpaceMinimumWindowsBuild>17763</DropSpaceMinimumWindowsBuild>
    <DropSpaceMinimumWindowsVersion>10.0.17763.0</DropSpaceMinimumWindowsVersion>
    <DropSpaceCompileWindowsSdkBuild>26100</DropSpaceCompileWindowsSdkBuild>
    <DropSpaceReleaseTag Condition="Exists('$(MSBuildThisFileDirectory)RELEASE_VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)RELEASE_VERSION').Trim())</DropSpaceReleaseTag>
    <DropSpaceReleaseVersion Condition="'$(DropSpaceReleaseTag)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(DropSpaceReleaseTag)', '^v', ''))</DropSpaceReleaseVersion>
    <DropSpaceVersionPrefix Condition="'$(DropSpaceReleaseVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(DropSpaceReleaseVersion)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</DropSpaceVersionPrefix>
    <DropSpacePreviewNumber Condition="'$(DropSpaceReleaseVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(DropSpaceReleaseVersion)', 'preview\.([0-9]+)$').Groups[1].Value)</DropSpacePreviewNumber>
    <DropSpaceFileVersion Condition="'$(DropSpaceVersionPrefix)' != '' and '$(DropSpacePreviewNumber)' != ''">$(DropSpaceVersionPrefix).$(DropSpacePreviewNumber)</DropSpaceFileVersion>
    <DropSpaceFileVersion Condition="'$(DropSpaceVersionPrefix)' != '' and '$(DropSpacePreviewNumber)' == ''">$(DropSpaceVersionPrefix).0</DropSpaceFileVersion>
    <DropSpacePackageRevision Condition="'$(DropSpacePreviewNumber)' != ''">$(DropSpacePreviewNumber)</DropSpacePackageRevision>
    <DropSpacePackageRevision Condition="'$(DropSpacePreviewNumber)' == ''">9999</DropSpacePackageRevision>
    <DropSpacePackageVersion Condition="'$(DropSpaceVersionPrefix)' != ''">$(DropSpaceVersionPrefix).$(DropSpacePackageRevision)</DropSpacePackageVersion>
  </PropertyGroup>
</Project>
