diff --git a/src/DropSpace.Core/Lyrics/LyricsRecordingEvidence.cs b/src/DropSpace.Core/Lyrics/LyricsRecordingEvidence.cs
new file mode 100644
--- /dev/null
+++ b/src/DropSpace.Core/Lyrics/LyricsRecordingEvidence.cs
@@ -0,0 +1,52 @@
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace DropSpace.Core.Lyrics;
+
+[JsonConverter(typeof(JsonStringEnumConverter))]
+public enum LyricsIdentityNamespace
+{
+    NetEaseSongId, QqSongMid, QqSongId, AmllQqPlatformId, KugouAudioHash,
+    KugouLyricId, LrclibEntryId, AmllDocumentId, AppleMusicId, SpotifyId, Isrc,
+}
+
+[JsonConverter(typeof(JsonStringEnumConverter))]
+public enum LyricsEvidenceOrigin { Unknown, SourceCatalogue, CommunityCatalogue, HashBoundCatalogue }
+
+[JsonConverter(typeof(JsonStringEnumConverter))]
+public enum LyricsDurationOrigin { Missing, SourceCatalogue, SourceLyricResponse, HashBoundCatalogue }
+
+// IDs remain in their declared namespace. A community recording association
+// is a cited assertion, not a guarantee of the player identity or recording version.
+public sealed record LyricsRecordingReference(LyricsIdentityNamespace Namespace, string Id, LyricsEvidenceOrigin Origin);
+public sealed record LyricsArtistCreditEvidence(string Name, string? SourceArtistId, IReadOnlyList<string> Aliases);
+
+public sealed record LyricsRecordingEvidence(string CanonicalTitle, IReadOnlyList<string> OtherTitles,
+    IReadOnlyList<LyricsArtistCreditEvidence> Credits, IReadOnlyList<LyricsRecordingReference> References,
+    LyricsEvidenceOrigin Origin, LyricsDurationOrigin DurationOrigin)
+{
+    public const string Version = "recording-evidence-v1";
+    public const int MaximumItems = 16;
+    public const int MaximumScalarBytes = 256;
+    public const int MaximumBytes = 16 * 1024;
+
+    // Invalid or oversized optional evidence must not invalidate a usable native
+    // original. It cannot enter the model input as a silently shortened credit.
+    public bool IsBounded()
+    {
+        static bool Text(string? value) => value is not null && Encoding.UTF8.GetByteCount(value) <= MaximumScalarBytes;
+        if (!Enum.IsDefined(Origin) || Origin == LyricsEvidenceOrigin.Unknown || !Enum.IsDefined(DurationOrigin) ||
+            !Text(CanonicalTitle) || string.IsNullOrWhiteSpace(CanonicalTitle) ||
+            OtherTitles is null || Credits is null || References is null ||
+            OtherTitles.Count > MaximumItems || Credits.Count > MaximumItems || References.Count > MaximumItems ||
+            OtherTitles.Any(value => !Text(value)) || Credits.Any(credit => credit is null ||
+                !Text(credit.Name) || string.IsNullOrWhiteSpace(credit.Name) ||
+                credit.SourceArtistId is not null && !Text(credit.SourceArtistId) ||
+                credit.Aliases is null || credit.Aliases.Count > MaximumItems || credit.Aliases.Any(value => !Text(value))) ||
+            References.Any(reference => reference is null || !Enum.IsDefined(reference.Namespace) ||
+                !Enum.IsDefined(reference.Origin) || reference.Origin == LyricsEvidenceOrigin.Unknown ||
+                !Text(reference.Id) || string.IsNullOrWhiteSpace(reference.Id))) return false;
+        return JsonSerializer.SerializeToUtf8Bytes(this).Length <= MaximumBytes;
+    }
+}
diff --git a/src/DropSpace.Core/Lyrics/LyricsRecordingAssessmentContract.cs b/src/DropSpace.Core/Lyrics/LyricsRecordingAssessmentContract.cs
new file mode 100644
--- /dev/null
+++ b/src/DropSpace.Core/Lyrics/LyricsRecordingAssessmentContract.cs
@@ -0,0 +1,138 @@
+using System.Text;
+using System.Text.Encodings.Web;
+using System.Text.Json;
+using DropSpace.Core.Models;
+
+namespace DropSpace.Core.Lyrics;
+
+// Executable evidence/answer contract for a future, separately qualified profile.
+// This does not replace the frozen experimental v2 prompt or enable a model.
+public sealed record LyricsRecordingAssessmentInput(string Json, IReadOnlyList<LyricsRecordingEvidenceCitation> Citations);
+public sealed record LyricsRecordingEvidenceCitation(string Id, string CandidateId, string Kind, string? AnchorId);
+
+public static class LyricsRecordingAssessmentContract
+{
+    public const string Version = "recording-assessment-evidence-v1";
+    public const int MaximumInputBytes = 8192;
+    public const int MaximumOutputBytes = 1024;
+
+    public static bool TryBuild(LyricsQuery query, LyricsCandidateSnapshot snapshot, LyricsDocument original,
+        LyricsSettings settings, string target, out LyricsRecordingAssessmentInput? input)
+    {
+        input = null;
+        static bool Scalar(string? value) => value is not null && Encoding.UTF8.GetByteCount(value) <= 256;
+        if (snapshot.Truncated || snapshot.Candidates.Count is 0 or > LyricsCandidateSelectionProtocol.MaximumCandidates ||
+            string.IsNullOrWhiteSpace(query.Artist) || !Scalar(query.Title) || !Scalar(query.Artist) ||
+            !Scalar(query.AlbumArtist) || !Scalar(query.Album) || !Scalar(target) ||
+            snapshot.Candidates.Select(candidate => candidate.Id).Distinct(StringComparer.Ordinal).Count() != snapshot.Candidates.Count)
+            return false;
+        foreach (var candidate in snapshot.Candidates)
+            if (candidate.Id.Length is < 2 or > 4 || candidate.Id[0] != 'c' || candidate.Id.Skip(1).Any(value => value is < '0' or > '9') ||
+                candidate.Document.Match is not { RecordingEvidence: { } evidence } match || !evidence.IsBounded() ||
+                !Scalar(match.Title) || !Scalar(match.Artist) || !Scalar(match.Album) || string.IsNullOrWhiteSpace(match.Artist) ||
+                !double.IsFinite(match.DurationSeconds) || match.DurationSeconds < 0 ||
+                LyricsMatcher.HasVersionConflict(query.Title, evidence.CanonicalTitle) ||
+                evidence.OtherTitles.Any(title => LyricsMatcher.HasVersionConflict(query.Title, title)) ||
+                LyricsMatcher.CandidateScore(query with { CollectSelectionCandidates = true }, match.Title, match.Artist,
+                    match.Album, match.DurationSeconds, match.ArtistAliases) < 4) return false;
+
+        // A native preview is a corroborated anchor, never a global artist identity.
+        // Legacy cache metadata without references cannot create a cross-source link.
+        var anchor = original.Match is { RecordingEvidence: { } anchorEvidence } anchorMatch &&
+            anchorEvidence.IsBounded() && !string.IsNullOrWhiteSpace(anchorMatch.Artist) &&
+            LyricsMatcher.Score(query, anchorMatch.Title, anchorMatch.Artist, anchorMatch.Album,
+                anchorMatch.DurationSeconds, anchorMatch.ArtistAliases) >= 4 ? anchorMatch : null;
+        var citations = new List<LyricsRecordingEvidenceCitation>();
+        foreach (var candidate in snapshot.Candidates)
+        {
+            var evidence = candidate.Document.Match!.RecordingEvidence!;
+            for (var index = 0; index < evidence.Credits.Count; index++)
+                citations.Add(new($"{candidate.Id}.artist.{index}", candidate.Id, "source-artist-object", null));
+            if (anchor is null) continue;
+            foreach (var reference in evidence.References.OrderBy(reference => reference.Namespace).ThenBy(reference => reference.Id, StringComparer.Ordinal))
+                if (anchor.RecordingEvidence!.References.Any(other => other.Namespace == reference.Namespace && other.Id == reference.Id) &&
+                    IsRecordingNamespace(reference.Namespace))
+                    citations.Add(new($"e{citations.Count}", candidate.Id, "shared-scoped-recording-reference", "a0"));
+        }
+        var json = JsonSerializer.Serialize(new
+        {
+            protocol = Version,
+            query = new { title = query.Title, performer = query.Artist, auxiliaryAlbumArtist = query.AlbumArtist,
+                album = query.Album, durationSeconds = query.Duration.TotalSeconds, target },
+            anchor = anchor is null ? null : new { id = "a0", origin = "native-rules-corroborated", provider = original.Provider.ToString(),
+                title = anchor.Title, artist = anchor.Artist, album = anchor.Album,
+                durationSeconds = anchor.DurationSeconds, evidence = anchor.RecordingEvidence },
+            candidates = snapshot.Candidates.Select(candidate => new
+            {
+                id = candidate.Id, provider = candidate.Document.Provider.ToString(),
+                matchedTitle = candidate.Document.Match!.Title, artist = candidate.Document.Match.Artist,
+                album = candidate.Document.Match.Album, durationSeconds = candidate.Document.Match.DurationSeconds,
+                evidence = candidate.Document.Match.RecordingEvidence,
+                targetTranslation = candidate.HasTargetTranslation,
+                sourcePriority = LyricsCandidateRules.SourceRank(candidate.Document.Provider, settings.Provider, settings.BackupProvider),
+                usableWordTiming = candidate.WordCoverage > 0,
+            }),
+            citations,
+        }, new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
+        json = json.Replace("<", "\\u003c", StringComparison.Ordinal);
+        if (Encoding.UTF8.GetByteCount(json) > MaximumInputBytes) return false;
+        input = new(json, citations.ToArray());
+        return true;
+    }
+
+    // Validate whole ordered model output without recovering an ID from prose or
+    // reordering an invalid answer and calling that AI success. Citations prove
+    // that evidence exists; they do not prove that the model understood it.
+    public static bool TryValidate(string output, LyricsRecordingAssessmentInput input, LyricsCandidateSnapshot snapshot,
+        LyricsQuery query, LyricsDocument original, LyricsSettings settings, string target, out IReadOnlyList<string> ids)
+    {
+        ids = [];
+        if (Encoding.UTF8.GetByteCount(output) > MaximumOutputBytes ||
+            !TryBuild(query, snapshot, original, settings, target, out var expected) ||
+            expected!.Json != input.Json || !expected.Citations.SequenceEqual(input.Citations)) return false;
+        try
+        {
+            using var parsed = JsonDocument.Parse(output, new JsonDocumentOptions { MaxDepth = 5 });
+            var root = parsed.RootElement;
+            if (root.ValueKind != JsonValueKind.Object || root.EnumerateObject().Count() != 1 ||
+                !root.TryGetProperty("confirmed", out var list) || list.ValueKind != JsonValueKind.Array ||
+                list.GetArrayLength() > snapshot.Candidates.Count) return false;
+            var chosen = new List<string>();
+            LyricsSelectionCandidate? previous = null;
+            foreach (var item in list.EnumerateArray())
+            {
+                if (item.ValueKind != JsonValueKind.Object || item.EnumerateObject().Count() != 2 ||
+                    !item.TryGetProperty("id", out var idField) || idField.ValueKind != JsonValueKind.String ||
+                    !item.TryGetProperty("evidence", out var evidenceField) || evidenceField.ValueKind != JsonValueKind.Array ||
+                    evidenceField.GetArrayLength() is < 1 or > 4) return false;
+                var id = idField.GetString()!;
+                if (chosen.Contains(id, StringComparer.Ordinal) || snapshot.Candidates.FirstOrDefault(candidate => candidate.Id == id) is not { } candidate)
+                    return false;
+                var cited = new HashSet<string>(StringComparer.Ordinal);
+                foreach (var field in evidenceField.EnumerateArray())
+                    if (field.ValueKind != JsonValueKind.String || !cited.Add(field.GetString()!) ||
+                        !input.Citations.Any(citation => citation.Id == field.GetString() && citation.CandidateId == id)) return false;
+                var match = candidate.Document.Match!;
+                if (string.IsNullOrWhiteSpace(query.Artist) || string.IsNullOrWhiteSpace(match.Artist) ||
+                    LyricsMatcher.CandidateScore(query with { CollectSelectionCandidates = true }, match.Title, match.Artist,
+                        match.Album, match.DurationSeconds, match.ArtistAliases) < 4) return false;
+                // World-knowledge guesses with no query-linked evidence are outside
+                // this grounded profile. A cross-reference remains a fallible assertion.
+                if (LyricsMatcher.Score(query, match.Title, match.Artist, match.Album, match.DurationSeconds, match.ArtistAliases) < 4 &&
+                    !input.Citations.Any(citation => cited.Contains(citation.Id) && citation.Kind == "shared-scoped-recording-reference")) return false;
+                if (previous is not null && LyricsCandidateRules.ComparePriority(previous, candidate, settings.Provider, settings.BackupProvider) > 0 ||
+                    original.Lines.Count > 0 && LyricsCandidateRules.ComparePriority(candidate,
+                        LyricsCandidateRules.Describe("rules", original, target), settings.Provider, settings.BackupProvider) > 0) return false;
+                chosen.Add(id);
+                previous = candidate;
+            }
+            ids = chosen.ToArray();
+            return true;
+        }
+        catch (JsonException) { return false; }
+    }
+
+    private static bool IsRecordingNamespace(LyricsIdentityNamespace space) => space is
+        LyricsIdentityNamespace.NetEaseSongId or LyricsIdentityNamespace.QqSongMid or LyricsIdentityNamespace.QqSongId or
+        LyricsIdentityNamespace.KugouAudioHash or LyricsIdentityNamespace.AppleMusicId or LyricsIdentityNamespace.SpotifyId;
+}
diff --git a/src/DropSpace.Infrastructure/Lyrics/LyricsRecordingEvidenceReader.cs b/src/DropSpace.Infrastructure/Lyrics/LyricsRecordingEvidenceReader.cs
new file mode 100644
--- /dev/null
+++ b/src/DropSpace.Infrastructure/Lyrics/LyricsRecordingEvidenceReader.cs
@@ -0,0 +1,82 @@
+using System.Text.Json;
+using DropSpace.Core.Lyrics;
+using static DropSpace.Infrastructure.Lyrics.LyricsHttpClient;
+
+namespace DropSpace.Infrastructure.Lyrics;
+
+// Reads only metadata in responses already fetched by an adapter. No extra requests,
+// artist-name mappings, access keys, contributor names or lyric text enter evidence.
+internal static class LyricsRecordingEvidenceReader
+{
+    internal static LyricsRecordingEvidence? NetEase(JsonElement song)
+    {
+        var artists = Array(song, "artists").Take(LyricsRecordingEvidence.MaximumItems + 1).ToArray();
+        if (artists.Length == 0) artists = Array(song, "ar").Take(LyricsRecordingEvidence.MaximumItems + 1).ToArray();
+        return Capture(() => new(Text(song, "name"), Strings(song, "alias", "alia", "transNames", "tns"),
+            artists.Select(artist => new LyricsArtistCreditEvidence(Text(artist, "name"),
+                Id(artist, "id"), Strings(artist, "alias", "alia", "transNames", "tns"))).ToArray(),
+            [new(LyricsIdentityNamespace.NetEaseSongId, Text(song, "id"), LyricsEvidenceOrigin.SourceCatalogue)],
+            LyricsEvidenceOrigin.SourceCatalogue,
+            Number(song, "duration") > 0 || Number(song, "dt") > 0 ? LyricsDurationOrigin.SourceCatalogue : LyricsDurationOrigin.Missing));
+    }
+
+    internal static LyricsRecordingEvidence? Qq(JsonElement song) => Capture(() => new(Text(song, "songname"), [],
+        Array(song, "singer").Take(LyricsRecordingEvidence.MaximumItems + 1).Select(artist => new LyricsArtistCreditEvidence(Text(artist, "name"),
+            Id(artist, "mid") is { } mid ? "mid:" + mid : Id(artist, "id") is { } id ? "id:" + id : null, [])).ToArray(),
+        QqReferences(song), LyricsEvidenceOrigin.SourceCatalogue,
+        Number(song, "interval") > 0 ? LyricsDurationOrigin.SourceCatalogue : LyricsDurationOrigin.Missing));
+
+    internal static LyricsRecordingEvidence? Amll(JsonElement item) => Capture(() => new(
+        Strings(item, "musicNames").FirstOrDefault() ?? "", Strings(item, "musicNames").Skip(1).ToArray(),
+        Strings(item, "artistNames").Select(name => new LyricsArtistCreditEvidence(name, null, [])).ToArray(),
+        new[] { new LyricsRecordingReference(LyricsIdentityNamespace.AmllDocumentId, Text(item, "id"), LyricsEvidenceOrigin.CommunityCatalogue) }
+            .Concat(References(item, "ncmMusicIds", LyricsIdentityNamespace.NetEaseSongId))
+            // The documented generic QQ platform field is preserved separately.
+            // Do not infer a numeric ID versus songmid namespace from string shape.
+            .Concat(References(item, "qqMusicIds", LyricsIdentityNamespace.AmllQqPlatformId))
+            .Concat(References(item, "appleMusicIds", LyricsIdentityNamespace.AppleMusicId))
+            .Concat(References(item, "spotifyIds", LyricsIdentityNamespace.SpotifyId))
+            .Concat(References(item, "isrcs", LyricsIdentityNamespace.Isrc)).ToArray(),
+        LyricsEvidenceOrigin.CommunityCatalogue, LyricsDurationOrigin.Missing));
+
+    internal static LyricsRecordingEvidence? Lrclib(JsonElement item) => Capture(() => new(Text(item, "trackName"), [],
+        [new(Text(item, "artistName"), null, [])],
+        [new(LyricsIdentityNamespace.LrclibEntryId, Text(item, "id"), LyricsEvidenceOrigin.CommunityCatalogue)],
+        LyricsEvidenceOrigin.CommunityCatalogue,
+        Number(item, "duration") > 0 ? LyricsDurationOrigin.SourceCatalogue : LyricsDurationOrigin.Missing));
+
+    internal static LyricsRecordingEvidence? Kugou(JsonElement item, string? audioHash, bool borrowedDuration) => Capture(() => new(
+        Text(item, "song"), [], [new(Text(item, "singer"), null, [])],
+        new[] { new LyricsRecordingReference(LyricsIdentityNamespace.KugouLyricId, Text(item, "id"), LyricsEvidenceOrigin.SourceCatalogue) }
+            .Concat(audioHash is null ? [] : new[] { new LyricsRecordingReference(LyricsIdentityNamespace.KugouAudioHash,
+                audioHash, LyricsEvidenceOrigin.HashBoundCatalogue) }).ToArray(),
+        LyricsEvidenceOrigin.SourceCatalogue, Number(item, "duration") > 0 ? LyricsDurationOrigin.SourceLyricResponse :
+            borrowedDuration ? LyricsDurationOrigin.HashBoundCatalogue : LyricsDurationOrigin.Missing));
+
+    private static LyricsRecordingEvidence? Capture(Func<LyricsRecordingEvidence> capture)
+    {
+        try { var evidence = capture(); return evidence.IsBounded() ? evidence : null; }
+        catch (InvalidDataException) { return null; }
+    }
+    private static string? Id(JsonElement element, string field) => Text(element, field) is { Length: > 0 } id ? id : null;
+    private static LyricsRecordingReference[] QqReferences(JsonElement item) =>
+        new[] { (LyricsIdentityNamespace.QqSongMid, "songmid"), (LyricsIdentityNamespace.QqSongId, "songid") }
+            .Where(pair => Id(item, pair.Item2) is not null)
+            .Select(pair => new LyricsRecordingReference(pair.Item1, Text(item, pair.Item2), LyricsEvidenceOrigin.SourceCatalogue)).ToArray();
+    private static IEnumerable<LyricsRecordingReference> References(JsonElement item, string field, LyricsIdentityNamespace space) =>
+        Strings(item, field).Select(id => new LyricsRecordingReference(space, id, LyricsEvidenceOrigin.CommunityCatalogue));
+    private static string[] Strings(JsonElement element, params string[] fields)
+    {
+        foreach (var field in fields)
+            if (element.TryGetProperty(field, out var values) && values.ValueKind == JsonValueKind.Array &&
+                values.GetArrayLength() > LyricsRecordingEvidence.MaximumItems)
+                throw new InvalidDataException("Optional recording evidence exceeds its bound.");
+        var result = fields.SelectMany(field => Array(element, field))
+            .Where(value => value.ValueKind == JsonValueKind.String).Select(value => value.GetString()!)
+            .Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.Ordinal)
+            .Take(LyricsRecordingEvidence.MaximumItems + 1).ToArray();
+        if (result.Length > LyricsRecordingEvidence.MaximumItems)
+            throw new InvalidDataException("Optional recording evidence exceeds its bound.");
+        return result;
+    }
+}
