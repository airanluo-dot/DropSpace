<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DropSpaceRoot Condition="'$(DropSpaceRoot)' == ''">/workspace/DropSpace</DropSpaceRoot>
    <GeneratedSource Condition="'$(GeneratedSource)' == ''">$(MSBuildThisFileDirectory)current-methods.cs.txt</GeneratedSource>
    <NoWarn>$(NoWarn);CS0649;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <Compile Include="$(DropSpaceRoot)/src/DropSpace.Core/**/*.cs" Exclude="$(DropSpaceRoot)/src/DropSpace.Core/bin/**/*.cs;$(DropSpaceRoot)/src/DropSpace.Core/obj/**/*.cs" />
    <Compile Include="$(DropSpaceRoot)/src/DropSpace.App/Views/Island/MediaRenderQueue.cs" />
    <Compile Include="Fixture.cs.txt;Program.cs.txt;$(GeneratedSource)" />
  </ItemGroup>
</Project>
