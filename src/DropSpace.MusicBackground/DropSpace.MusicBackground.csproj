<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.20348.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.20348.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.20348.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>DropSpace.App.Controls</RootNamespace>
    <DropSpaceFxcPath Condition="'$(DropSpaceFxcPath)' == '' and Exists('$(WindowsSdkVerBinPath)x64\fxc.exe')">$(WindowsSdkVerBinPath)x64\fxc.exe</DropSpaceFxcPath>
    <DropSpaceFxcPath Condition="'$(DropSpaceFxcPath)' == ''">$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.0.$(DropSpaceCompileWindowsSdkBuild).0\x64\fxc.exe</DropSpaceFxcPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="SharpGen.Runtime" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="LiquidGlass\LiquidGlass.hlsl" LogicalName="DropSpace.LiquidGlass.hlsl" />
    <EmbeddedResource Include="ThirdParty\Lyricify\AppleMusicIosBackground.hlsl" LogicalName="Lyricify.Backgrounds.AppleMusicInspired.Ios.Shared.Resources.AppleMusicIosBackground.hlsl" />
    <Content Include="ThirdParty\Lyricify\LICENSE.txt" Link="Licenses\Lyricify-Backgrounds-Apache-2.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\Lyricify\UPSTREAM.md" Link="Licenses\Lyricify-Backgrounds-NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(DropSpaceFxcPath)')">
    <GlassShader Include="VS" Profile="vs_5_0" />
    <GlassShader Include="Blur;Glass" Profile="ps_5_0" />
    <EmbeddedResource Include="@(GlassShader->'$(IntermediateOutputPath)GlassShaders\%(Identity).cso')" LogicalName="DropSpace.LiquidGlass.%(Filename).cso" />
  </ItemGroup>
  <Target Name="CompileLiquidGlassBytecode" BeforeTargets="PrepareForBuild" Condition="'@(GlassShader)' != ''"
          Inputs="LiquidGlass\LiquidGlass.hlsl;$(DropSpaceFxcPath);$(MSBuildProjectFullPath)"
          Outputs="@(GlassShader->'$(IntermediateOutputPath)GlassShaders\%(Identity).cso')">
    <MakeDir Directories="$(IntermediateOutputPath)GlassShaders" />
    <Exec Command="&quot;$(DropSpaceFxcPath)&quot; /nologo /Ges /O3 /T %(GlassShader.Profile) /E %(GlassShader.Identity) /Fo &quot;$(IntermediateOutputPath)GlassShaders\%(GlassShader.Identity).cso&quot; LiquidGlass\LiquidGlass.hlsl" />
  </Target>
</Project>
