<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="DropSpace.App.OverlayWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="DropSpace Overlay"
  mc:Ignorable="d">
  <Grid
    x:Name="Root"
    AllowDrop="True"
    Background="Transparent"
    DragEnter="OnDragEnter"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <Border
      x:Name="Surface"
      HorizontalAlignment="Center"
      VerticalAlignment="Top"
      Width="340"
      Height="64"
      Background="#F20D0D11"
      BorderBrush="#38FFFFFF"
      BorderThickness="1"
      CornerRadius="32"
      RenderTransformOrigin="0.5,0.5"
      PointerEntered="OnSurfacePointerEntered"
      PointerExited="OnSurfacePointerExited">
      <Border.RenderTransform>
        <TranslateTransform x:Name="SurfaceTranslation" />
      </Border.RenderTransform>

      <Grid>
        <Button
          x:Name="CompactPanel"
          Padding="18,0"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch"
          AutomationProperties.Name="展开 DropSpace 顶部面板"
          Background="Transparent"
          BorderThickness="0"
          Click="OnCompactClicked">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" CornerRadius="16" Background="#267C5CFC">
              <FontIcon FontSize="17" Foreground="White" Glyph="&#xECC8;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock
                MaxWidth="230"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{Binding CompactTitle}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="11" Foreground="#BFFFFFFF" Text="Temporary Space" />
            </StackPanel>
            <FontIcon Grid.Column="2" VerticalAlignment="Center" Foreground="#BFFFFFFF" Glyph="&#xE70D;" />
          </Grid>
        </Button>

        <StackPanel
          x:Name="DragPanel"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="4"
          Visibility="Collapsed">
          <TextBlock
            HorizontalAlignment="Center"
            FontSize="17"
            FontWeight="SemiBold"
            Foreground="White"
            Text="{Binding DragTitle}" />
          <TextBlock
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="#BFFFFFFF"
            Text="{Binding DragSubtitle}" />
        </StackPanel>

        <Grid x:Name="ExpandedPanel" Padding="18,14,18,16" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White" Text="Temporary Space" />
              <TextBlock FontSize="12" Foreground="#BFFFFFFF" Text="最近项目 · 可直接拖到 Explorer" />
            </StackPanel>
            <Button
              Grid.Column="1"
              Width="34"
              Height="34"
              AutomationProperties.Name="收起顶部面板"
              Background="Transparent"
              BorderThickness="0"
              Click="OnCollapseClicked">
              <FontIcon Foreground="White" Glyph="&#xE70E;" />
            </Button>
          </Grid>

          <ListView
            x:Name="OverlayItemsList"
            Grid.Row="1"
            Margin="0,12,0,10"
            CanDragItems="True"
            DragItemsStarting="OnDragItemsStarting"
            IsItemClickEnabled="False"
            ItemsSource="{Binding RecentItems}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="48" Padding="8,5" ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="36" Height="36" CornerRadius="8" Background="#18FFFFFF">
                    <Grid>
                      <Image
                        Width="34"
                        Height="34"
                        Source="{Binding Thumbnail}"
                        Stretch="UniformToFill"
                        Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                      <FontIcon
                        Foreground="White"
                        Glyph="{Binding Glyph}"
                        Visibility="{Binding Thumbnail, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                      MaxWidth="320"
                      FontWeight="SemiBold"
                      Foreground="White"
                      Text="{Binding Title}"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      MaxWidth="320"
                      FontSize="11"
                      Foreground="#AFFFFFFF"
                      Text="{Binding Preview}"
                      TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                    <Button
                      Padding="9,4"
                      AutomationProperties.Name="打开项目"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="OnOpenItemClicked"
                      Foreground="White"
                      Tag="{Binding}">
                      <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                    </Button>
                    <Button
                      Padding="9,4"
                      AutomationProperties.Name="固定项目"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="OnPinItemClicked"
                      Foreground="White"
                      Tag="{Binding}">
                      <FontIcon FontSize="13" Glyph="&#xE718;" />
                    </Button>
                    <Button
                      Padding="9,4"
                      AutomationProperties.Name="从 DropSpace 移除"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="OnRemoveItemClicked"
                      Foreground="White"
                      Tag="{Binding}">
                      <FontIcon FontSize="13" Glyph="&#xE711;" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#AFFFFFFF" Text="移除引用不会删除原始文件" />
            <Button Grid.Column="1" Content="打开 DropSpace" Click="OnOpenMainWindowClicked" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
