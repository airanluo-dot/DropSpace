<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="DropSpace.App.OverlayWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:services="using:DropSpace.App.Services"

  mc:Ignorable="d">
  <Grid
    x:Name="Root"
    Background="Transparent">
    <Border
      x:Name="ShadowSurface"
      HorizontalAlignment="Center"
      VerticalAlignment="Top"
      Width="340"
      Height="64"
      Background="#AA000000"
      CornerRadius="32"
      IsHitTestVisible="False"
      Opacity="0"
      RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <CompositeTransform x:Name="ShadowTransform" />
      </Border.RenderTransform>
    </Border>
    <Border
      x:Name="Surface"
      HorizontalAlignment="Center"
      VerticalAlignment="Top"
      Width="340"
      Height="64"
      Background="#F20D0D11"
      BorderThickness="0"
      CornerRadius="32"
      AllowDrop="True"
      DragEnter="OnSurfaceDragEnter"
      DragOver="OnSurfaceDragOver"
      DragLeave="OnSurfaceDragLeave"
      Drop="OnSurfaceDrop"
      Opacity="0"
      RenderTransformOrigin="0.5,0.5"
      PointerEntered="OnSurfacePointerEntered"
      PointerExited="OnSurfacePointerExited">
      <Border.RenderTransform>
        <CompositeTransform x:Name="SurfaceTransform" />
      </Border.RenderTransform>

      <Grid>
        <Button
          x:Name="CompactPanel"
 services:XamlResourceOverride.Uid="OverlayCompactPanel"
          Padding="18,0"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch"
          Background="Transparent"
          BorderThickness="0"
          Click="OnCompactClicked">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" CornerRadius="16" Background="#267C5CFC">
              <FontIcon FontSize="17" Foreground="White" Glyph="&#xECC8;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock
                MaxWidth="230"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{Binding CompactTitle}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="CompactSubtitleText" services:XamlResourceOverride.Uid="OverlayCompactSubtitle" FontSize="11" Foreground="#BFFFFFFF" />
            </StackPanel>
            <FontIcon Grid.Column="2" VerticalAlignment="Center" Foreground="#BFFFFFFF" Glyph="&#xE70D;" />
          </Grid>
        </Button>

        <StackPanel
          x:Name="DragPanel"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="4"
          Opacity="0"
          Visibility="Collapsed">
          <TextBlock
            HorizontalAlignment="Center"
            FontSize="17"
            FontWeight="SemiBold"
            Foreground="White"
            Text="{Binding DragTitle}" />
          <TextBlock
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="#BFFFFFFF"
            Text="{Binding DragSubtitle}" />
        </StackPanel>

        <Grid x:Name="ExpandedPanel" Padding="18,14,18,16" Opacity="0" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="ExpandedTitleText" services:XamlResourceOverride.Uid="OverlayExpandedTitle" FontSize="18" FontWeight="SemiBold" Foreground="White" />
              <TextBlock x:Name="ExpandedSubtitleText" services:XamlResourceOverride.Uid="OverlayExpandedSubtitle" FontSize="12" Foreground="#BFFFFFFF" />
            </StackPanel>
            <Button
 services:XamlResourceOverride.Uid="OverlayCollapseButton"
              Grid.Column="1"
              Width="34"
              Height="34"
              Background="Transparent"
              BorderThickness="0"
              Click="OnCollapseClicked">
              <FontIcon Foreground="White" Glyph="&#xE70E;" />
            </Button>
          </Grid>

          <ListView
            x:Name="OverlayItemsList"
            Grid.Row="1"
            Margin="0,12,0,10"
            CanDragItems="True"
            DragItemsStarting="OnDragItemsStarting"
            IsItemClickEnabled="False"
            ItemsSource="{Binding RecentItems}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="48" Padding="8,5" ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="36" Height="36" CornerRadius="8" Background="#18FFFFFF">
                    <Grid>
                      <Image
                        Width="34"
                        Height="34"
                        Source="{Binding Thumbnail}"
                        Stretch="UniformToFill"
                        Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                      <FontIcon
                        Foreground="White"
                        Glyph="{Binding Glyph}"
                        Visibility="{Binding Thumbnail, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                      MaxWidth="320"
                      FontWeight="SemiBold"
                      Foreground="White"
                      Text="{Binding Title}"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      MaxWidth="320"
                      FontSize="11"
                      Foreground="#AFFFFFFF"
                      Text="{Binding Preview}"
                      TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                    <Button
 services:XamlResourceOverride.Uid="OverlayOpenItemButton"
                      Padding="9,4"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="OnOpenItemClicked"
                      Foreground="White"
                      Tag="{Binding}">
                      <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                    </Button>
                    <Button
 services:XamlResourceOverride.Uid="OverlayPinItemButton"
                      Padding="9,4"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="OnPinItemClicked"
                      Foreground="White"
                      Tag="{Binding}">
                      <FontIcon FontSize="13" Glyph="&#xE718;" />
                    </Button>
                    <Button
 services:XamlResourceOverride.Uid="OverlayRemoveItemButton"
                      Padding="9,4"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="OnRemoveItemClicked"
                      Foreground="White"
                      Tag="{Binding}">
                      <FontIcon FontSize="13" Glyph="&#xE711;" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RemoveHintText" services:XamlResourceOverride.Uid="OverlayRemoveHint" VerticalAlignment="Center" FontSize="11" Foreground="#AFFFFFFF" />
            <Button x:Name="OpenMainButton" services:XamlResourceOverride.Uid="OverlayOpenMainButton" Grid.Column="1" Click="OnOpenMainWindowClicked" />
          </Grid>
        </Grid>

        <Border
          Margin="8"
          Padding="20"
          IsHitTestVisible="False"
          Background="#337C5CFC"
          BorderBrush="#FF9B87FF"
          BorderThickness="2"
          CornerRadius="22"
          Visibility="{Binding IsExpandedDropTargetActive, Converter={StaticResource BoolToVisibilityConverter}}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
            <FontIcon FontSize="24" Foreground="White" Glyph="&#xECC8;" />
            <TextBlock x:Name="DropTargetTitleText" services:XamlResourceOverride.Uid="OverlayDropTargetTitle" FontSize="17" FontWeight="SemiBold" Foreground="White" />
            <TextBlock services:XamlResourceOverride.Uid="OverlayDropTargetSubtitle" FontSize="12" Foreground="#DFFFFFFF" />
          </StackPanel>
        </Border>

        <Border
          x:Name="PlacementEditSurface"
          Background="Transparent"
          IsHitTestVisible="False"
          Visibility="Collapsed"
          PointerPressed="OnPlacementEditPointerPressed"
          PointerMoved="OnPlacementEditPointerMoved"
          PointerReleased="OnPlacementEditPointerReleased"
          PointerCaptureLost="OnPlacementEditPointerCaptureLost">
          <TextBlock
            x:Name="PlacementEditHintText"
            services:XamlResourceOverride.Uid="OverlayPlacementEditHint"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="#DFFFFFFF" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
