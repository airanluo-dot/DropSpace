<UserControl
    x:Class="DropSpace.App.Views.Island.MediaCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    UseLayoutRounding="False">
  <UserControl.Resources>
    <x:Double x:Key="CompactMusicAccessorySize">24</x:Double>
    <Style x:Key="CompactSpectrumBarStyle" TargetType="Rectangle">
      <Setter Property="Width" Value="2.5" />
      <Setter Property="RadiusX" Value="1.25" />
      <Setter Property="RadiusY" Value="1.25" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{ThemeResource DropSpaceOverlayForegroundPrimaryBrush}" />
    </Style>
  </UserControl.Resources>
  <Grid x:Name="Layout" ColumnSpacing="12" VerticalAlignment="Center">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border x:Name="ArtworkHost" Width="{StaticResource CompactMusicAccessorySize}" Height="{StaticResource CompactMusicAccessorySize}" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
      <Image Source="{Binding Artwork}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <Grid x:Name="LyricViewport" MinHeight="28" VerticalAlignment="Center" SizeChanged="OnViewportSizeChanged">
      <Grid.Clip><RectangleGeometry x:Name="ViewportClip" /></Grid.Clip>
      <Canvas x:Name="LyricScrollHost">
      <Grid x:Name="LyricCanvas" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Grid.RenderTransform><CompositeTransform x:Name="LyricTranslation" /></Grid.RenderTransform>
        <TextBlock x:Name="BaseLine" Padding="2,0" UseLayoutRounding="False" FontSize="13" TextWrapping="NoWrap" Foreground="{ThemeResource DropSpaceOverlayForegroundSecondaryBrush}" />
        <TextBlock x:Name="HighlightLine" Padding="2,0" UseLayoutRounding="False" FontSize="13" TextWrapping="NoWrap" Foreground="{ThemeResource DropSpaceOverlayForegroundPrimaryBrush}" AutomationProperties.AccessibilityView="Raw">
          <TextBlock.Clip><RectangleGeometry x:Name="HighlightClip" /></TextBlock.Clip>
        </TextBlock>
      </Grid>
      </Canvas>
      <StackPanel x:Name="InterludeDots" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
        <Ellipse x:Name="InterludeDot0" Width="4" Height="4" Fill="{ThemeResource DropSpaceOverlayForegroundPrimaryBrush}" />
        <Ellipse x:Name="InterludeDot1" Width="4" Height="4" Fill="{ThemeResource DropSpaceOverlayForegroundPrimaryBrush}" />
        <Ellipse x:Name="InterludeDot2" Width="4" Height="4" Fill="{ThemeResource DropSpaceOverlayForegroundPrimaryBrush}" />
      </StackPanel>
    </Grid>
    <Grid x:Name="SecondaryViewport" SizeChanged="OnSecondaryViewportSizeChanged" Visibility="Collapsed">
      <Grid.Clip><RectangleGeometry x:Name="SecondaryViewportClip" /></Grid.Clip>
      <Canvas x:Name="SecondaryScrollHost">
      <TextBlock x:Name="SecondaryLine" Padding="2,0" UseLayoutRounding="False" HorizontalAlignment="Left" FontSize="11" TextWrapping="NoWrap" Foreground="{ThemeResource DropSpaceOverlayForegroundSecondaryBrush}" Visibility="Collapsed">
        <TextBlock.RenderTransform><CompositeTransform x:Name="SecondaryTranslation" /></TextBlock.RenderTransform>
      </TextBlock>
      </Canvas>
    </Grid>
    </StackPanel>
    <StackPanel x:Name="SpectrumBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                Width="{StaticResource CompactMusicAccessorySize}" Height="{StaticResource CompactMusicAccessorySize}"
                Spacing="1.8" AutomationProperties.AccessibilityView="Raw">
      <Rectangle Style="{StaticResource CompactSpectrumBarStyle}" />
      <Rectangle Style="{StaticResource CompactSpectrumBarStyle}" />
      <Rectangle Style="{StaticResource CompactSpectrumBarStyle}" />
      <Rectangle Style="{StaticResource CompactSpectrumBarStyle}" />
      <Rectangle Style="{StaticResource CompactSpectrumBarStyle}" />
      <Rectangle Style="{StaticResource CompactSpectrumBarStyle}" />
    </StackPanel>
  </Grid>
</UserControl>
