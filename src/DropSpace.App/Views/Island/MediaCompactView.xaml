<UserControl
    x:Class="DropSpace.App.Views.Island.MediaCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Layout" ColumnSpacing="12" VerticalAlignment="Center">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border x:Name="ArtworkHost" Width="24" Height="24" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
      <Image Source="{Binding Artwork}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
    </Border>
    <Grid x:Name="LyricViewport" Grid.Column="1" MinHeight="28" VerticalAlignment="Center" SizeChanged="OnViewportSizeChanged">
      <Grid.Clip><RectangleGeometry x:Name="ViewportClip" /></Grid.Clip>
      <Grid x:Name="LyricCanvas" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Grid.RenderTransform><CompositeTransform x:Name="LyricTranslation" /></Grid.RenderTransform>
        <TextBlock x:Name="BaseLine" FontSize="13" TextWrapping="NoWrap" Foreground="{StaticResource DropSpaceOverlayForegroundSecondaryBrush}" />
        <TextBlock x:Name="HighlightLine" FontSize="13" TextWrapping="NoWrap" Foreground="{StaticResource DropSpaceOverlayForegroundPrimaryBrush}" AutomationProperties.AccessibilityView="Raw">
          <TextBlock.Clip><RectangleGeometry x:Name="HighlightClip" /></TextBlock.Clip>
        </TextBlock>
      </Grid>
    </Grid>
    <StackPanel x:Name="SpectrumBars" Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Height="22" AutomationProperties.AccessibilityView="Raw">
      <Rectangle x:Name="Band0" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource DropSpaceOverlayForegroundPrimaryBrush}" VerticalAlignment="Center" />
      <Rectangle x:Name="Band1" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource DropSpaceOverlayForegroundPrimaryBrush}" VerticalAlignment="Center" />
      <Rectangle x:Name="Band2" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource DropSpaceOverlayForegroundPrimaryBrush}" VerticalAlignment="Center" />
      <Rectangle x:Name="Band3" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource DropSpaceOverlayForegroundPrimaryBrush}" VerticalAlignment="Center" />
      <Rectangle x:Name="Band4" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource DropSpaceOverlayForegroundPrimaryBrush}" VerticalAlignment="Center" />
      <Rectangle x:Name="Band5" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource DropSpaceOverlayForegroundPrimaryBrush}" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
