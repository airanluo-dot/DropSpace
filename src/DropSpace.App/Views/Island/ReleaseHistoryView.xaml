<UserControl
    x:Class="DropSpace.App.Views.Island.ReleaseHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:services="using:DropSpace.App.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="PageLayout" Padding="32,20,32,18" RowSpacing="14" SizeChanged="OnLayoutSizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Heading" FontSize="36" FontWeight="Bold" TextWrapping="Wrap"
                 Foreground="{ThemeResource DropSpaceOverlayForegroundPrimaryBrush}" AutomationProperties.HeadingLevel="Level1"/>
      <Button x:Name="CloseButton" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource DropSpaceIconButtonStyle}"
              Click="OnCloseClick" Width="36" Height="36" AutomationProperties.AutomationId="CloseReleaseHistory">
        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource DropSpaceOverlayForegroundPrimaryBrush}"/>
      </Button>
    </Grid>
    <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsTabStop="True">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ItemsRepeater x:Name="Entries">
          <ItemsRepeater.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,19,12,21">
                <Grid ColumnSpacing="18" SizeChanged="OnEntrySizeChanged">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Width="195" HorizontalAlignment="Left" Spacing="3">
                    <TextBlock x:Name="VersionLabel" services:BrandText.Key="{Binding Version}" Style="{StaticResource BrandTextStyle}"
                               Text="{Binding Version}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Left"
                               AutomationProperties.HeadingLevel="Level2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ChannelLabel" services:BrandText.Key="{Binding Version}" Style="{StaticResource BrandTextStyle}"
                               Text="{Binding Channel}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="DateLabel" services:BrandText.Key="{Binding Version}" Style="{StaticResource BrandTextStyle}"
                               Text="{Binding Date}" HorizontalAlignment="Left" Visibility="{Binding DateVisibility}"/>
                  </StackPanel>
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Notes}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,2,0,6" ColumnSpacing="8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <TextBlock Text="•" Foreground="{ThemeResource DropSpaceOverlayForegroundSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
                          <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="15"
                                     Foreground="{ThemeResource DropSpaceOverlayForegroundPrimaryBrush}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <Button x:Name="LoadMore" Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,12"
                Style="{StaticResource SubtleButtonStyle}" Click="OnLoadMore" AutomationProperties.AutomationId="LoadMoreReleaseHistory">
          <TextBlock x:Name="LoadMoreLabel" Style="{StaticResource BrandTextStyle}" FontWeight="SemiBold"/>
        </Button>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
