<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="DropSpaceContentMaxWidth">1120</x:Double>
  <x:Double x:Key="DropSpaceRowMinHeight">76</x:Double>
  <Thickness x:Key="DropSpacePagePadding">28,22,28,28</Thickness>
  <Thickness x:Key="DropSpaceCompactPadding">16,14,16,18</Thickness>
  <CornerRadius x:Key="DropSpaceSurfaceRadius">10</CornerRadius>
  <SolidColorBrush x:Key="DropSpaceAccentSoftBrush" Color="#183B82F6" />
  <x:Double x:Key="DropSpaceMotionFasterMilliseconds">83</x:Double>
  <x:Double x:Key="DropSpaceMotionFastMilliseconds">167</x:Double>
  <x:Double x:Key="DropSpaceMotionNormalMilliseconds">250</x:Double>
  <x:Double x:Key="DropSpaceMotionSlowMilliseconds">333</x:Double>
  <CornerRadius x:Key="DropSpaceOverlayRadius">32</CornerRadius>
  <SolidColorBrush x:Key="DropSpaceOverlayFallbackBrush" Color="#F20D0D11" />
  <SolidColorBrush x:Key="DropSpaceOverlayStrokeBrush" Color="#42FFFFFF" />
  <SolidColorBrush x:Key="DropSpaceOverlayInteractionBrush" Color="#18FFFFFF" />
  <Style x:Key="DropSpaceSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="DropSpaceItemButtonStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="13" />
  </Style>
</ResourceDictionary>
