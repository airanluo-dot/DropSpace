<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Per-theme island resources keep simultaneous main/island appearances independent. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="DropSpaceOverlayForegroundPrimaryBrush" Color="{ThemeResource SystemBaseHighColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayForegroundSecondaryBrush" Color="{ThemeResource SystemBaseMediumHighColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayForegroundDisabledBrush" Color="{ThemeResource SystemBaseMediumColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlaySurfaceFallbackBrush" Color="{ThemeResource SystemAltLowColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayStrokeBrush" Color="{ThemeResource SystemBaseHighColor}" Opacity="0.26" />
      <SolidColorBrush x:Key="DropSpaceOverlayAccentBrush" Color="{ThemeResource SystemAccentColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayInteractionBrush" Color="{ThemeResource SystemBaseHighColor}" Opacity="0.10" />
      <SolidColorBrush x:Key="DropSpaceOverlayDropTargetBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.20" />
      <SolidColorBrush x:Key="DropSpaceOverlayFocusBrush" Color="{ThemeResource SystemAccentColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayFallbackBrush" Color="{ThemeResource SystemAltLowColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="DropSpaceOverlayForegroundPrimaryBrush" Color="{ThemeResource SystemBaseHighColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayForegroundSecondaryBrush" Color="{ThemeResource SystemBaseMediumHighColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayForegroundDisabledBrush" Color="{ThemeResource SystemBaseMediumColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlaySurfaceFallbackBrush" Color="{ThemeResource SystemAltLowColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayStrokeBrush" Color="{ThemeResource SystemBaseHighColor}" Opacity="0.26" />
      <SolidColorBrush x:Key="DropSpaceOverlayAccentBrush" Color="{ThemeResource SystemAccentColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayInteractionBrush" Color="{ThemeResource SystemBaseHighColor}" Opacity="0.10" />
      <SolidColorBrush x:Key="DropSpaceOverlayDropTargetBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.20" />
      <SolidColorBrush x:Key="DropSpaceOverlayFocusBrush" Color="{ThemeResource SystemAccentColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayFallbackBrush" Color="{ThemeResource SystemAltLowColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="DropSpaceOverlayForegroundPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayForegroundSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayForegroundDisabledBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlaySurfaceFallbackBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayInteractionBrush" Color="{ThemeResource SystemColorWindowTextColor}" Opacity="0.10" />
      <SolidColorBrush x:Key="DropSpaceOverlayDropTargetBrush" Color="{ThemeResource SystemColorHighlightColor}" Opacity="0.20" />
      <SolidColorBrush x:Key="DropSpaceOverlayFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="DropSpaceOverlayFallbackBrush" Color="{ThemeResource SystemColorWindowColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <x:Double x:Key="DropSpaceContentMaxWidth">1120</x:Double>
  <x:Double x:Key="DropSpaceRowMinHeight">76</x:Double>
  <Thickness x:Key="DropSpacePagePadding">28,22,28,28</Thickness>
  <Thickness x:Key="DropSpaceCompactPadding">16,14,16,18</Thickness>
  <CornerRadius x:Key="DropSpaceSurfaceRadius">10</CornerRadius>
  <CornerRadius x:Key="DropSpaceCardRadius">8</CornerRadius>
  <Thickness x:Key="DropSpaceHeaderPadding">28,20,28,14</Thickness>
  <Thickness x:Key="DropSpaceStatusMargin">28,0,28,10</Thickness>
  <Thickness x:Key="DropSpaceCollectionPadding">28,0,28,28</Thickness>
  <Thickness x:Key="DropSpaceSettingsPadding">28,0,28,32</Thickness>
  <x:Double x:Key="DropSpaceOverlayCompactWidth">340</x:Double>
  <x:Double x:Key="DropSpaceOverlayCompactHeight">64</x:Double>
  <CornerRadius x:Key="DropSpaceOverlayRadius">32</CornerRadius>
  <!-- ThemeResource setters resolve for the destination control, including window theme overrides. -->
  <Style x:Key="DropSpaceCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
  </Style>
  <Style x:Key="DropSpaceSecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="DropSpaceWidgetEditorCellStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
  </Style>
  <Style x:Key="DropSpaceWidgetEditorDropPreviewStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
  </Style>
  <Style x:Key="DropSpaceWidgetEditorButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
  </Style>
  <Style x:Key="DropSpaceWidgetEditorSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource DropSpaceWidgetEditorButtonStyle}">
    <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
  </Style>
  <Style x:Key="DropSpaceWidgetEditorSizeStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
  </Style>
  <Style x:Key="DropSpaceWidgetEditorSelectedSizeStyle" TargetType="Border" BasedOn="{StaticResource DropSpaceWidgetEditorSizeStyle}">
    <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
  </Style>
  <Style x:Key="DropSpaceOverlayWidgetTileStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="DropSpaceSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="DropSpaceItemButtonStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="13" />
  </Style>
</ResourceDictionary>
