<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="DropSpace.App.Views.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:services="using:DropSpace.App.Services"
  Background="Transparent"
  mc:Ignorable="d">
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnSpaceAccelerator" />
    <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnClipboardAccelerator" />
    <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnPinnedAccelerator" />
    <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
    <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="OnSettingsAccelerator" />
    <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="OnUndoAccelerator" />
  </Page.KeyboardAccelerators>

  <NavigationView
    x:Name="Navigation"
    IsBackButtonVisible="Collapsed"
    IsSettingsVisible="False"
    PaneDisplayMode="LeftCompact"
    SelectionChanged="OnNavigationSelectionChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem x:Name="SpaceNavigationItem" services:XamlResourceOverride.Uid="NavSpace" Icon="Folder" Tag="Space" />
      <NavigationViewItem x:Name="ClipboardNavigationItem" services:XamlResourceOverride.Uid="NavClipboard" Icon="Paste" Tag="Clipboard" />
      <NavigationViewItem x:Name="PinnedNavigationItem" services:XamlResourceOverride.Uid="NavPinned" Icon="Pin" Tag="Pinned" />
    </NavigationView.MenuItems>
    <NavigationView.FooterMenuItems>
      <NavigationViewItem x:Name="SettingsNavigationItem" services:XamlResourceOverride.Uid="NavSettings" Icon="Setting" Tag="Settings" />
    </NavigationView.FooterMenuItems>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid x:Name="ResponsiveHeader" Padding="28,20,28,14" ColumnSpacing="20" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="HeaderWidthStates">
            <VisualState x:Name="NarrowHeader">
              <VisualState.StateTriggers>
                <AdaptiveTrigger MinWindowWidth="0" />
              </VisualState.StateTriggers>
              <VisualState.Setters>
                <Setter Target="HeaderText.(Grid.ColumnSpan)" Value="3" />
                <Setter Target="SearchBox.(Grid.Row)" Value="1" />
                <Setter Target="SearchBox.(Grid.Column)" Value="0" />
                <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="2" />
                <Setter Target="SearchBox.HorizontalAlignment" Value="Stretch" />
                <Setter Target="SearchColumn.Width" Value="0" />
                <Setter Target="AddButton.(Grid.Row)" Value="1" />
                <Setter Target="AddButton.(Grid.Column)" Value="2" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="WideHeader">
              <VisualState.StateTriggers>
                <AdaptiveTrigger MinWindowWidth="860" />
              </VisualState.StateTriggers>
              <VisualState.Setters>
                <Setter Target="HeaderText.(Grid.ColumnSpan)" Value="1" />
                <Setter Target="SearchBox.(Grid.Row)" Value="0" />
                <Setter Target="SearchBox.(Grid.Column)" Value="1" />
                <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="1" />
                <Setter Target="SearchColumn.Width" Value="320" />
                <Setter Target="AddButton.(Grid.Row)" Value="0" />
                <Setter Target="AddButton.(Grid.Column)" Value="2" />
              </VisualState.Setters>
            </VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="SearchColumn" Width="320" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="HeaderText" MinWidth="0" Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ItemCountText}" />
          </StackPanel>
          <TextBlock MaxWidth="520" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding PageDescription}" TextWrapping="WrapWholeWords" />
          <TextBlock
            x:Name="ClipboardStatusText"
            Margin="0,5,0,0"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
            Text="{Binding ClipboardStatusText}"
            Visibility="Collapsed" />
        </StackPanel>

        <AutoSuggestBox
          x:Name="SearchBox"
 services:XamlResourceOverride.Uid="SearchBox"
          Grid.Column="1"
          VerticalAlignment="Top"
          QueryIcon="Find"
          TextChanged="OnSearchTextChanged"
          KeyDown="OnSearchKeyDown" />

        <DropDownButton
          x:Name="AddButton"
 services:XamlResourceOverride.Uid="AddButton"
          Grid.Column="2"
          VerticalAlignment="Top"
          >
          <DropDownButton.Flyout>
            <MenuFlyout>
              <MenuFlyoutItem services:XamlResourceOverride.Uid="AddFilesMenuItem" Click="OnAddFilesClicked">
                <MenuFlyoutItem.Icon>
                  <SymbolIcon Symbol="Document" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem services:XamlResourceOverride.Uid="AddFolderMenuItem" Click="OnAddFolderClicked">
                <MenuFlyoutItem.Icon>
                  <SymbolIcon Symbol="Folder" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem services:XamlResourceOverride.Uid="AddTextUrlMenuItem" Click="OnAddTextUrlClicked">
                <MenuFlyoutItem.Icon>
                  <SymbolIcon Symbol="Edit" />
                </MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
      </Grid>

      <StackPanel Grid.Row="1" Margin="28,0,28,10" Spacing="6">
        <InfoBar
          IsClosable="True"
          IsOpen="{Binding HasStatusMessage, Mode=OneWay}"
          Message="{Binding StatusMessage}"
          Severity="Informational" />
        <InfoBar
          x:Name="UndoInfoBar"
          IsClosable="False"
          IsOpen="{Binding HasUndo, Mode=OneWay}"
          Message="{Binding UndoMessage}"
          Severity="Informational">
          <InfoBar.ActionButton>
            <Button services:XamlResourceOverride.Uid="UndoButton" Click="OnUndoClicked" />
          </InfoBar.ActionButton>
        </InfoBar>
      </StackPanel>

      <Grid
        x:Name="CollectionSurface"
        Grid.Row="2"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Visibility="{Binding IsCollectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid Padding="28,0,28,28">
          <ListView
            x:Name="ItemsList"
 services:XamlResourceOverride.Uid="ItemsList"
            CanDragItems="True"
            DoubleTapped="OnItemDoubleTapped"
            DragItemsStarting="OnDragItemsStarting"
            IsItemClickEnabled="False"
            ItemsSource="{Binding Items}"
            KeyDown="OnItemsListKeyDown"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            SelectionMode="Extended"
            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="76" Padding="12,9" ColumnSpacing="12" Visibility="{Binding IsBatchMemberVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border
                    Width="48"
                    Height="48"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                    <Grid>
                      <Image
                        Width="44"
                        Height="44"
                        Source="{Binding Thumbnail}"
                        Stretch="UniformToFill"
                        Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                      <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="22"
                        Glyph="{Binding Glyph}"
                        Visibility="{Binding Thumbnail, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                    </Grid>
                  </Border>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding IsBatchHeader, Converter={StaticResource BoolToVisibilityConverter}}">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{Binding BatchLabel}" />
                      <Button Padding="6,1" Background="Transparent" BorderThickness="0" Content="{Binding BatchToggleLabel}" Click="OnToggleBatchClicked" Tag="{Binding}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock
                        MaxWidth="440"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                      <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SourceLabel}" />
                      <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding KindLabel}" />
                    </StackPanel>
                    <TextBlock
                      MaxWidth="560"
                      FontSize="13"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="{Binding Preview}"
                      TextTrimming="CharacterEllipsis" />
                    <ItemsControl ItemsSource="{Binding PrimaryQuickActions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button
                            AutomationProperties.Name="{Binding AutomationName}"
                            Click="OnPrimaryQuickActionClicked"
                            Content="{Binding Label}"
                            Padding="8,3"
                            Tag="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding CreatedLabel}" />
                      <TextBlock FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{Binding StatusLabel}" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <Button services:XamlResourceOverride.Uid="PinBatchButton" Click="OnPinBatchClicked" Style="{StaticResource DropSpaceItemButtonStyle}" Tag="{Binding}" Visibility="{Binding IsBatchHeader, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button services:XamlResourceOverride.Uid="RemoveBatchButton" Click="OnRemoveBatchClicked" Style="{StaticResource DropSpaceItemButtonStyle}" Tag="{Binding}" Visibility="{Binding IsBatchHeader, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
 services:XamlResourceOverride.Uid="OpenItemButton"
                      Click="OnOpenItemClicked"
                      IsEnabled="{Binding CanOpen}"
                      Style="{StaticResource DropSpaceItemButtonStyle}"
                      Tag="{Binding}" />
                    <Button
 services:XamlResourceOverride.Uid="CopyItemButton"
                      Click="OnCopyItemClicked"
                      IsEnabled="{Binding CanCopy}"
                      Style="{StaticResource DropSpaceItemButtonStyle}"
                      Tag="{Binding}" />
                    <Button
 services:XamlResourceOverride.Uid="PinItemButton"
                      Click="OnPinItemClicked"
                      Content="{Binding PinActionLabel}"
                      Style="{StaticResource DropSpaceItemButtonStyle}"
                      Tag="{Binding}" />
                    <Button
 services:XamlResourceOverride.Uid="LocateItemButton"
                      Click="OnLocateItemClicked"
                      Style="{StaticResource DropSpaceItemButtonStyle}"
                      Tag="{Binding}"
                      Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
 services:XamlResourceOverride.Uid="ExportItemButton"
                      Click="OnExportItemClicked"
                      Style="{StaticResource DropSpaceItemButtonStyle}"
                      Tag="{Binding}"
                      Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
 services:XamlResourceOverride.Uid="MoreItemButton"
                      Style="{StaticResource DropSpaceItemButtonStyle}"
                      Tag="{Binding}">
                      <Button.Content>
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                      </Button.Content>
                      <Button.Flyout>
                        <MenuFlyout Opened="OnMoreItemFlyoutOpened">
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="ShowInFolderMenuItem" Click="OnShowInFolderClicked" Tag="{Binding}" />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="PreviewItemMenuItem" Click="OnPreviewItemClicked" Tag="{Binding}" />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="ActionHashSha256" Click="OnQuickActionClicked" CommandParameter="HashSha256" Tag="{Binding}" />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="ActionCompressZip" Click="OnQuickActionClicked" CommandParameter="CompressZip" Tag="{Binding}" />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="ActionGenerateQr" Click="OnQuickActionClicked" CommandParameter="GenerateQr" Tag="{Binding}" />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="ActionResizeImageMenuItem" Click="OnQuickActionClicked" CommandParameter="ResizeImage" Tag="{Binding}" />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="ActionConvertImage" Click="OnQuickActionClicked" CommandParameter="ConvertImage" Tag="{Binding}" />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="ActionStripMetadata" Click="OnQuickActionClicked" CommandParameter="StripMetadata" Tag="{Binding}" />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="SendToDeviceAction" Click="OnQuickActionClicked" CommandParameter="SendToDevice" Tag="{Binding}" />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="CreateNearbyLinkAction" Click="OnQuickActionClicked" CommandParameter="CreateNearbyLink" Tag="{Binding}" />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="CreateSecureInternetLinkAction" Click="OnQuickActionClicked" CommandParameter="CreateSecureInternetLink" Tag="{Binding}" />
                          <MenuFlyoutSeparator />
                          <MenuFlyoutItem services:XamlResourceOverride.Uid="RemoveItemMenuItem" Click="OnRemoveItemClicked" Tag="{Binding}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="420"
            Spacing="12"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon HorizontalAlignment="Center" FontSize="42" Glyph="&#xE8B7;" />
            <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
              x:Name="EmptyDescription"
              HorizontalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          </StackPanel>

          <Border
            x:Name="DropHint"
            Margin="4"
            Background="{ThemeResource LayerFillColorAltBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="12"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
              <FontIcon FontSize="40" Glyph="&#xECC8;" />
              <TextBlock services:XamlResourceOverride.Uid="DropHintTitle" FontSize="20" FontWeight="SemiBold" />
              <TextBlock services:XamlResourceOverride.Uid="DropHintDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Border>

          <ProgressRing
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsActive="{Binding IsBusy}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>
      </Grid>

      <ScrollViewer
        Grid.Row="2"
        Padding="28,0,28,32"
        Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="28">
          <StackPanel Spacing="12">
            <TextBlock services:XamlResourceOverride.Uid="ClipboardPrivacySection" Style="{StaticResource DropSpaceSectionTitleStyle}" />
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="PauseRecordingTitle" FontWeight="SemiBold" />
                <TextBlock services:XamlResourceOverride.Uid="PauseRecordingDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="PauseToggle" services:XamlResourceOverride.Uid="PauseToggle" Grid.Column="1" Toggled="OnPauseToggled" />
            </Grid>
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="CaptureImagesTitle" FontWeight="SemiBold" />
                <TextBlock services:XamlResourceOverride.Uid="CaptureImagesDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="CaptureImagesToggle" services:XamlResourceOverride.Uid="CaptureImagesToggle" Grid.Column="1" Toggled="OnCaptureImagesToggled" />
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
              </Grid.ColumnDefinitions>
              <TextBlock services:XamlResourceOverride.Uid="MaxImageMegabytesLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
              <NumberBox x:Name="MaxImageMegabytesNumber" Grid.Column="1" Minimum="1" Maximum="256" SpinButtonPlacementMode="Compact" ValueChanged="OnClipboardLimitsChanged" />
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
              </Grid.ColumnDefinitions>
              <TextBlock services:XamlResourceOverride.Uid="MaxImageMegapixelsLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
              <NumberBox x:Name="MaxImageMegapixelsNumber" Grid.Column="1" Minimum="1" Maximum="200" SpinButtonPlacementMode="Compact" ValueChanged="OnClipboardLimitsChanged" />
            </Grid>
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="CaptureFilesTitle" FontWeight="SemiBold" />
                <TextBlock services:XamlResourceOverride.Uid="CaptureFilesDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="CaptureFilesToggle" services:XamlResourceOverride.Uid="CaptureFilesToggle" Grid.Column="1" Toggled="OnCaptureFilesToggled" />
            </Grid>
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="CaptureFoldersTitle" FontWeight="SemiBold" />
                <TextBlock services:XamlResourceOverride.Uid="CaptureFoldersDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="CaptureFoldersToggle" services:XamlResourceOverride.Uid="CaptureFoldersToggle" Grid.Column="1" Toggled="OnCaptureFoldersToggled" />
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
              </Grid.ColumnDefinitions>
              <TextBlock services:XamlResourceOverride.Uid="MaxClipboardFileItemsLabel" VerticalAlignment="Center" />
              <NumberBox x:Name="MaxClipboardFileItemsNumber" Grid.Column="1" Minimum="1" Maximum="1000" SpinButtonPlacementMode="Compact" ValueChanged="OnClipboardLimitsChanged" />
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
              </Grid.ColumnDefinitions>
              <TextBlock services:XamlResourceOverride.Uid="MaxClipboardFileMegabytesLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
              <NumberBox x:Name="MaxClipboardFileMegabytesNumber" Grid.Column="1" Minimum="1" Maximum="1048576" SpinButtonPlacementMode="Compact" ValueChanged="OnClipboardLimitsChanged" />
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="MaxClipboardFileTotalMegabytesLabel" TextWrapping="Wrap" />
                <TextBlock services:XamlResourceOverride.Uid="MaxClipboardFileTotalMegabytesDescription" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <NumberBox x:Name="MaxClipboardFileTotalMegabytesNumber" Grid.Column="1" Minimum="1" Maximum="4194304" SpinButtonPlacementMode="Compact" ValueChanged="OnClipboardLimitsChanged" />
            </Grid>
            <InfoBar
 services:XamlResourceOverride.Uid="ClipboardPrivacyWarning"
              IsClosable="False"
              IsOpen="True"
              Severity="Warning" />
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock services:XamlResourceOverride.Uid="DevicesSharingSection" Style="{StaticResource DropSpaceSectionTitleStyle}" />
            <TextBlock services:XamlResourceOverride.Uid="DevicesSharingDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="DeviceHandoffTitle" FontWeight="SemiBold" />
                <TextBlock services:XamlResourceOverride.Uid="DeviceHandoffDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="DeviceHandoffToggle" services:XamlResourceOverride.Uid="DeviceHandoffToggle" Grid.Column="1" Toggled="OnDeviceHandoffToggled" />
            </Grid>
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="CrossDeviceClipboardTitle" FontWeight="SemiBold" />
                <TextBlock services:XamlResourceOverride.Uid="CrossDeviceClipboardDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="CrossDeviceClipboardToggle" services:XamlResourceOverride.Uid="CrossDeviceClipboardToggle" Grid.Column="1" Toggled="OnCrossDeviceClipboardToggled" />
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="DefaultClipboardSyncModeTitle" FontWeight="SemiBold" />
                <TextBlock services:XamlResourceOverride.Uid="DefaultClipboardSyncModeDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox x:Name="DefaultClipboardSyncModeCombo" Grid.Column="1" SelectionChanged="OnDefaultClipboardSyncModeChanged">
                <ComboBoxItem services:XamlResourceOverride.Uid="ClipboardSyncModeOff" Tag="Off" />
                <ComboBoxItem services:XamlResourceOverride.Uid="ClipboardSyncModeManual" Tag="Manual" />
                <ComboBoxItem services:XamlResourceOverride.Uid="ClipboardSyncModeTextUrl" Tag="AutomaticTextAndUrl" />
                <ComboBoxItem services:XamlResourceOverride.Uid="ClipboardSyncModeTextUrlImage" Tag="AutomaticTextUrlAndImage" />
              </ComboBox>
            </Grid>
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="NearbySharingTitle" FontWeight="SemiBold" />
                <TextBlock services:XamlResourceOverride.Uid="NearbySharingDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="NearbySharingToggle" services:XamlResourceOverride.Uid="NearbySharingToggle" Grid.Column="1" Toggled="OnNearbySharingToggled" />
            </Grid>
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="InternetSharingTitle" FontWeight="SemiBold" />
                <TextBlock services:XamlResourceOverride.Uid="InternetSharingDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="InternetSharingToggle" services:XamlResourceOverride.Uid="InternetSharingToggle" Grid.Column="1" Toggled="OnInternetSharingToggled" />
            </Grid>
            <TextBlock x:Name="DeviceStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="RefreshDevicesButton" services:XamlResourceOverride.Uid="RefreshDevicesButton" Click="OnRefreshDevicesClicked" />
              <Button x:Name="PairDeviceButton" services:XamlResourceOverride.Uid="PairDeviceButton" Click="OnPairDeviceClicked" />
            </StackPanel>
            <ListView x:Name="DiscoveredDevicesList" MaxHeight="180" SelectionMode="Single">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE770;" />
                    <TextBlock Text="{Binding DisplayName}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Platform}" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock services:XamlResourceOverride.Uid="RetentionSection" Style="{StaticResource DropSpaceSectionTitleStyle}" />
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
              </Grid.ColumnDefinitions>
              <TextBlock services:XamlResourceOverride.Uid="RetentionDaysLabel" VerticalAlignment="Center" />
              <NumberBox x:Name="RetentionDaysNumber" Grid.Column="1" Minimum="1" Maximum="3650" SpinButtonPlacementMode="Compact" ValueChanged="OnRetentionChanged" />
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
              </Grid.ColumnDefinitions>
              <TextBlock services:XamlResourceOverride.Uid="RetentionCountLabel" VerticalAlignment="Center" />
              <NumberBox x:Name="RetentionCountNumber" Grid.Column="1" Minimum="10" Maximum="100000" SpinButtonPlacementMode="Compact" ValueChanged="OnRetentionChanged" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock services:XamlResourceOverride.Uid="AppearanceSection" Style="{StaticResource DropSpaceSectionTitleStyle}" />
            <StackPanel x:Name="QuickActionsSettingsPanel" Spacing="10" />
            <Border
              Padding="16"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8">
              <StackPanel Spacing="10">
                <TextBlock services:XamlResourceOverride.Uid="DropTrayCompatibilityTitle" FontWeight="SemiBold" />
                <TextBlock
 services:XamlResourceOverride.Uid="DropTrayCompatibilityDescription"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  TextWrapping="Wrap" />
                <TextBlock
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="{Binding WindowsShareIntegrationStatus}"
                  TextWrapping="Wrap" />
                <TextBlock
 services:XamlResourceOverride.Uid="DropTrayApiNotice"
                  FontSize="12"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                  TextWrapping="Wrap" />
                <Button
 services:XamlResourceOverride.Uid="OpenDropTraySettingsButton"
                  HorizontalAlignment="Left"
                  Click="OnOpenDropTraySettingsClicked" />
              </StackPanel>
            </Border>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock services:XamlResourceOverride.Uid="FileDragWakeModeTitle" />
                <TextBlock
 services:XamlResourceOverride.Uid="FileDragWakeModeDescription"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox
                x:Name="FileDragWakeModeCombo"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnFileDragWakeModeChanged">
                <ComboBoxItem services:XamlResourceOverride.Uid="FileDragWakeModeSmart" Tag="SmartExperimental" />
                <ComboBoxItem services:XamlResourceOverride.Uid="FileDragWakeModeClassic" Tag="ClassicTopEdge" />
                <ComboBoxItem services:XamlResourceOverride.Uid="FileDragWakeModeDisabled" Tag="Disabled" />
              </ComboBox>
            </Grid>
            <InfoBar
 services:XamlResourceOverride.Uid="ExperimentalDragDetectionInfo"
              IsClosable="False"
              IsOpen="True"
              Severity="Informational" />
            <Button services:XamlResourceOverride.Uid="CopyDragCompatibilityReportButton" HorizontalAlignment="Left" Click="OnCopyDragCompatibilityReportClicked" />
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="StartWithWindowsTitle" />
                <TextBlock services:XamlResourceOverride.Uid="StartWithWindowsDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="StartWithWindowsToggle" services:XamlResourceOverride.Uid="StartWithWindowsToggle" Grid.Column="1" Toggled="OnStartWithWindowsToggled" />
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="LanguageTitle" />
                <TextBlock services:XamlResourceOverride.Uid="LanguageDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox x:Name="LanguageCombo" services:XamlResourceOverride.Uid="LanguageCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnLanguageChanged">
                <ComboBoxItem services:XamlResourceOverride.Uid="LanguageSystem" Tag="System" />
                <ComboBoxItem services:XamlResourceOverride.Uid="LanguageEnglish" Tag="English" />
                <ComboBoxItem services:XamlResourceOverride.Uid="LanguageSimplifiedChinese" Tag="SimplifiedChinese" />
              </ComboBox>
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>
              <TextBlock services:XamlResourceOverride.Uid="ThemeTitle" VerticalAlignment="Center" />
              <ComboBox x:Name="ThemeCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged">
                <ComboBoxItem services:XamlResourceOverride.Uid="ThemeSystem" Tag="System" />
                <ComboBoxItem services:XamlResourceOverride.Uid="ThemeLight" Tag="Light" />
                <ComboBoxItem services:XamlResourceOverride.Uid="ThemeDark" Tag="Dark" />
              </ComboBox>
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="MotionTitle" />
                <TextBlock services:XamlResourceOverride.Uid="MotionDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox x:Name="OverlayMotionCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnOverlayMotionChanged">
                <ComboBoxItem services:XamlResourceOverride.Uid="MotionSystem" Tag="System" />
                <ComboBoxItem services:XamlResourceOverride.Uid="MotionFull" Tag="Full" />
                <ComboBoxItem services:XamlResourceOverride.Uid="MotionReduced" Tag="Reduced" />
              </ComboBox>
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="MonitorTitle" />
                <TextBlock services:XamlResourceOverride.Uid="MonitorDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox x:Name="OverlayMonitorCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnOverlayMonitorChanged">
                <ComboBoxItem services:XamlResourceOverride.Uid="MonitorAutomatic" Tag="Automatic" />
                <ComboBoxItem services:XamlResourceOverride.Uid="MonitorPrimary" Tag="Primary" />
              </ComboBox>
            </Grid>
            <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
              <StackPanel Spacing="10">
                <TextBlock services:XamlResourceOverride.Uid="IslandPlacementTitle" FontWeight="SemiBold" />
                <TextBlock services:XamlResourceOverride.Uid="IslandPlacementDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="OverlayPlacementPersistenceWarningText" services:XamlResourceOverride.Uid="OverlayPlacementPersistenceWarning" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <ComboBox x:Name="OverlayPlacementModeCombo" SelectionChanged="OnOverlayPlacementModeChanged">
                  <ComboBoxItem services:XamlResourceOverride.Uid="IslandPlacementAutomatic" Tag="Automatic" />
                  <ComboBoxItem x:Name="OverlayPlacementCustomItem" services:XamlResourceOverride.Uid="IslandPlacementCustom" Tag="Custom" />
                </ComboBox>
                <ComboBox x:Name="OverlayPlacementMonitorCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="OnOverlayPlacementMonitorChanged" />
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <NumberBox x:Name="OverlayPlacementXNumber" services:XamlResourceOverride.Uid="IslandPlacementX" Header="X" SmallChange="1" SpinButtonPlacementMode="Compact" KeyDown="OnPlacementNumberKeyDown" />
                  <NumberBox x:Name="OverlayPlacementYNumber" services:XamlResourceOverride.Uid="IslandPlacementY" Grid.Column="1" Header="Y" SmallChange="1" SpinButtonPlacementMode="Compact" KeyDown="OnPlacementNumberKeyDown" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="AdjustIslandPlacementButton" services:XamlResourceOverride.Uid="AdjustIslandPlacementButton" Click="OnAdjustIslandPlacementClicked" />
                  <Button x:Name="ApplyIslandPlacementButton" services:XamlResourceOverride.Uid="ApplyIslandPlacementButton" Click="OnApplyIslandPlacementClicked" />
                  <Button services:XamlResourceOverride.Uid="ResetIslandPlacementButton" Click="OnResetIslandPlacementClicked" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="QuickPanelHotkeyTitle" />
                <TextBlock services:XamlResourceOverride.Uid="QuickPanelHotkeyDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBox x:Name="QuickPanelHotkeyText" Grid.Column="1" LostFocus="OnQuickPanelHotkeyLostFocus" />
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock services:XamlResourceOverride.Uid="SmartDragExclusionsTitle" />
              <TextBlock services:XamlResourceOverride.Uid="SmartDragExclusionsDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              <TextBox x:Name="SmartDragExclusionsText" LostFocus="OnSmartDragExclusionsLostFocus" />
            </StackPanel>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="CloseBehaviorTitle" />
                <TextBlock services:XamlResourceOverride.Uid="CloseBehaviorDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <ComboBox x:Name="CloseBehaviorCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnCloseBehaviorChanged">
                <ComboBoxItem services:XamlResourceOverride.Uid="CloseBehaviorHideToTray" Tag="HideToTray" />
                <ComboBoxItem services:XamlResourceOverride.Uid="CloseBehaviorExit" Tag="Exit" />
              </ComboBox>
            </Grid>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock services:XamlResourceOverride.Uid="UpdatesSection" Style="{StaticResource DropSpaceSectionTitleStyle}" />
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="AutoCheckUpdatesTitle" />
                <TextBlock services:XamlResourceOverride.Uid="AutoCheckUpdatesDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="AutoCheckUpdatesToggle" Grid.Column="1" Toggled="OnAutoCheckUpdatesToggled" />
            </Grid>
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="AutoDownloadUpdatesTitle" />
                <TextBlock services:XamlResourceOverride.Uid="AutoDownloadUpdatesDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="AutoDownloadUpdatesToggle" Grid.Column="1" Toggled="OnAutoDownloadUpdatesToggled" />
            </Grid>
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="AutoInstallUpdatesTitle" />
                <TextBlock services:XamlResourceOverride.Uid="AutoInstallUpdatesDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch
                x:Name="AutoInstallUpdatesToggle"
                Grid.Column="1"
                IsEnabled="{Binding TrustedAutoInstallAvailable}"
                Toggled="OnAutoInstallUpdatesToggled" />
            </Grid>
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock services:XamlResourceOverride.Uid="UpdateChannelTitle" />
                <TextBlock services:XamlResourceOverride.Uid="UpdateChannelDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox x:Name="UpdateChannelCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnUpdateChannelChanged">
                <ComboBoxItem services:XamlResourceOverride.Uid="UpdateChannelStable" Tag="Stable" />
                <ComboBoxItem services:XamlResourceOverride.Uid="UpdateChannelPreview" Tag="Preview" />
              </ComboBox>
            </Grid>
            <Border
              Padding="16"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{Binding CurrentVersionDisplayText}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding DeploymentModeText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding UpdateProgressText}" />
                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding LastUpdateCheckDisplayText}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button services:XamlResourceOverride.Uid="CheckUpdatesButton" IsEnabled="{Binding CanCheckForUpdates}" Click="OnCheckForUpdatesClicked" />
                  <Button services:XamlResourceOverride.Uid="DownloadUpdateButton" Visibility="{Binding CanDownloadUpdate, Converter={StaticResource BoolToVisibilityConverter}}" Click="OnDownloadUpdateClicked" />
                  <Button services:XamlResourceOverride.Uid="InstallUpdateButton" Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVisibilityConverter}}" Click="OnInstallUpdateClicked" />
                  <Button services:XamlResourceOverride.Uid="OpenUpdateLocationButton" Visibility="{Binding CanOpenUpdateLocation, Converter={StaticResource BoolToVisibilityConverter}}" Click="OnOpenUpdateLocationClicked" />
                  <Button services:XamlResourceOverride.Uid="ViewReleaseNotesButton" Visibility="{Binding CanViewReleaseNotes, Converter={StaticResource BoolToVisibilityConverter}}" Click="OnViewReleaseNotesClicked" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock services:XamlResourceOverride.Uid="LocalDataSection" Style="{StaticResource DropSpaceSectionTitleStyle}" />
            <TextBlock services:XamlResourceOverride.Uid="StorageLocationTitle" FontWeight="SemiBold" />
            <TextBox IsReadOnly="True" Text="{Binding StoragePath}" TextWrapping="Wrap" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding StorageSummaryText}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button services:XamlResourceOverride.Uid="ClearLastHourButton" Click="OnClearLastHourClicked" />
              <Button services:XamlResourceOverride.Uid="ClearTodayButton" Click="OnClearTodayClicked" />
              <Button services:XamlResourceOverride.Uid="ClearAllButton" Click="OnClearAllClicked" />
            </StackPanel>
            <TextBlock services:XamlResourceOverride.Uid="ClearHistoryDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </NavigationView>
</Page>
