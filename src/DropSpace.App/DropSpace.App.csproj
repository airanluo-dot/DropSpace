<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DropSpace</AssemblyName>
    <Product>DropSpace</Product>
    <Description>DropSpace temporary file and clipboard workspace for Windows 10 version 1809 and later.</Description>
    <AssemblyTitle>DropSpace</AssemblyTitle>
    <Version>$(DropSpaceReleaseVersion)</Version>
    <AssemblyVersion>$(DropSpaceVersionPrefix).0</AssemblyVersion>
    <FileVersion>$(DropSpaceFileVersion)</FileVersion>
    <InformationalVersion>$(DropSpaceReleaseVersion)</InformationalVersion>
    <Win32Resource Condition="'$(OS)' == 'Windows_NT'">$(BaseIntermediateOutputPath)DropSpace.res</Win32Resource>
    <TargetFramework>net10.0-windows10.0.$(DropSpaceMinimumWindowsBuild).0</TargetFramework>
    <SupportedOSPlatformVersion>$(DropSpaceMinimumWindowsVersion)</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>$(DropSpaceMinimumWindowsVersion)</TargetPlatformMinVersion>
    <RootNamespace>DropSpace.App</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == ''">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <DropSpaceDeployment Condition="'$(DropSpaceDeployment)' == ''">Packaged</DropSpaceDeployment>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(DropSpaceDeployment)' == 'Packaged'">MSIX</WindowsPackageType>
    <WindowsPackageType Condition="'$(DropSpaceDeployment)' == 'Portable'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(DropSpaceDeployment)' == 'Portable'">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(DropSpaceDeployment)' == 'Portable'">true</SelfContained>
    <PublishSingleFile Condition="'$(DropSpaceDeployment)' == 'Portable'">true</PublishSingleFile>
    <IncludeAllContentForSelfExtract Condition="'$(DropSpaceDeployment)' == 'Portable'">true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DropSpaceWin32ResourceDependsOn Condition="'$(WindowsAppSDKSelfContained)' == 'true'">CreateWinRTRegistration</DropSpaceWin32ResourceDependsOn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DropSpace.Core\DropSpace.Core.csproj" />
    <ProjectReference Include="..\DropSpace.Infrastructure\DropSpace.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\AppIcon.ico" />
    <DropSpaceStringResource Include="Strings\**\*.resw" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectCapability Include="Msix" Condition="'$(DropSpaceDeployment)' == 'Packaged'" />
  </ItemGroup>
  <PropertyGroup>
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
  <Target
    Name="CompileDropSpaceBootstrapWin32Resource"
    BeforeTargets="PrepareForBuild"
    Condition="'$(OS)' == 'Windows_NT'"
    Inputs="$(MSBuildProjectDirectory)\DropSpace.rc;$(MSBuildProjectDirectory)\app.manifest;$(MSBuildProjectDirectory)\Assets\AppIcon.ico;$(MSBuildProjectDirectory)\..\..\RELEASE_VERSION;$(MSBuildProjectDirectory)\..\..\scripts\Compile-Win32Resource.ps1"
    Outputs="$(MSBuildProjectDirectory)\$(Win32Resource)">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Compile-Win32Resource.ps1&quot; -SourcePath &quot;$(MSBuildProjectDirectory)\DropSpace.rc&quot; -ManifestPath &quot;$(MSBuildProjectDirectory)\app.manifest&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\$(Win32Resource)&quot;" />
  </Target>
  <Target
    Name="CompileDropSpaceWin32Resource"
    BeforeTargets="CoreCompile"
    DependsOnTargets="$(DropSpaceWin32ResourceDependsOn)"
    Condition="'$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(ApplicationManifest)')" Text="The application manifest was not generated before Win32 resource compilation: $(ApplicationManifest)" />
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Compile-Win32Resource.ps1&quot; -SourcePath &quot;$(MSBuildProjectDirectory)\DropSpace.rc&quot; -ManifestPath &quot;$(ApplicationManifest)&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\$(Win32Resource)&quot;" />
    <PropertyGroup>
      <ApplicationManifest />
      <Win32Manifest />
      <NoWin32Manifest>true</NoWin32Manifest>
    </PropertyGroup>
  </Target>
  <Target
    Name="GenerateDropSpacePortableResourceIndex"
    BeforeTargets="PrepareForBundle"
    Condition="'$(DropSpaceDeployment)' == 'Portable' and '$(OS)' == 'Windows_NT'"
    Inputs="@(DropSpaceStringResource);$(MSBuildProjectDirectory)\..\..\scripts\Generate-PortableResourcesPri.ps1"
    Outputs="$(IntermediateOutputPath)DropSpace.resources.pri">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Generate-PortableResourcesPri.ps1&quot; -ProjectRoot &quot;$(MSBuildProjectDirectory)&quot; -OutputPath &quot;$(IntermediateOutputPath)DropSpace.resources.pri&quot; -ConfigurationPath &quot;$(IntermediateOutputPath)resources.priconfig.xml&quot;" />
  </Target>
  <Target
    Name="BundleDropSpacePortableResourceIndex"
    AfterTargets="PrepareForBundle"
    BeforeTargets="GenerateSingleFileBundle"
    DependsOnTargets="GenerateDropSpacePortableResourceIndex"
    Condition="'$(DropSpaceDeployment)' == 'Portable' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(IntermediateOutputPath)DropSpace.resources.pri')" Text="The portable localization resource index was not generated before single-file bundling." />
    <ItemGroup>
      <FilesToBundle Include="$(IntermediateOutputPath)DropSpace.resources.pri">
        <RelativePath>DropSpace.resources.pri</RelativePath>
      </FilesToBundle>
    </ItemGroup>
  </Target>
</Project>
