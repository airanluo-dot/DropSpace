<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DropSpace</AssemblyName>
    <Product>DropSpace</Product>
    <Description>DropSpace temporary file and clipboard workspace for Windows 11.</Description>
    <AssemblyTitle>DropSpace</AssemblyTitle>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-preview.1</InformationalVersion>
    <Win32Resource Condition="'$(OS)' == 'Windows_NT'">$(BaseIntermediateOutputPath)DropSpace.res</Win32Resource>
    <NoWin32Manifest Condition="'$(OS)' == 'Windows_NT'">true</NoWin32Manifest>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>DropSpace.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == ''">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <DropSpaceDeployment Condition="'$(DropSpaceDeployment)' == ''">Packaged</DropSpaceDeployment>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(DropSpaceDeployment)' == 'Packaged'">MSIX</WindowsPackageType>
    <WindowsPackageType Condition="'$(DropSpaceDeployment)' == 'Portable'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(DropSpaceDeployment)' == 'Portable'">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(DropSpaceDeployment)' == 'Portable'">true</SelfContained>
    <PublishSingleFile Condition="'$(DropSpaceDeployment)' == 'Portable'">true</PublishSingleFile>
    <IncludeAllContentForSelfExtract Condition="'$(DropSpaceDeployment)' == 'Portable'">true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DropSpace.Core\DropSpace.Core.csproj" />
    <ProjectReference Include="..\DropSpace.Infrastructure\DropSpace.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectCapability Include="Msix" Condition="'$(DropSpaceDeployment)' == 'Packaged'" />
  </ItemGroup>
  <PropertyGroup>
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
  <Target
    Name="CompileDropSpaceWin32Resource"
    BeforeTargets="PrepareForBuild"
    Condition="'$(OS)' == 'Windows_NT'"
    Inputs="$(MSBuildProjectDirectory)\DropSpace.rc;$(MSBuildProjectDirectory)\Assets\AppIcon.ico;$(MSBuildProjectDirectory)\..\..\scripts\Compile-Win32Resource.ps1"
    Outputs="$(Win32Resource)">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Compile-Win32Resource.ps1&quot; -SourcePath &quot;$(MSBuildProjectDirectory)\DropSpace.rc&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\$(Win32Resource)&quot;" />
  </Target>
</Project>
