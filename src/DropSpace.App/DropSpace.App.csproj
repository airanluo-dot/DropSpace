<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DropSpace</AssemblyName>
    <Product>DropSpace</Product>
    <Description>DropSpace temporary file and clipboard workspace for 64-bit Windows build 20348 and later.</Description>
    <AssemblyTitle>DropSpace</AssemblyTitle>
    <Version>$(DropSpaceReleaseVersion)</Version>
    <AssemblyVersion>$(DropSpaceVersionPrefix).0</AssemblyVersion>
    <FileVersion>$(DropSpaceFileVersion)</FileVersion>
    <InformationalVersion>$(DropSpaceReleaseVersion)</InformationalVersion>
    <Win32Resource Condition="'$(OS)' == 'Windows_NT'">$(BaseIntermediateOutputPath)DropSpace.res</Win32Resource>
    <TargetFramework>net10.0-windows10.0.$(DropSpaceMinimumWindowsBuild).0</TargetFramework>
    <SupportedOSPlatformVersion>$(DropSpaceMinimumWindowsVersion)</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>$(DropSpaceMinimumWindowsVersion)</TargetPlatformMinVersion>
    <RootNamespace>DropSpace.App</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == ''">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <DropSpaceDeployment Condition="'$(DropSpaceDeployment)' == ''">Packaged</DropSpaceDeployment>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(DropSpaceDeployment)' == 'Packaged'">MSIX</WindowsPackageType>
    <WindowsPackageType Condition="'$(DropSpaceDeployment)' == 'Portable'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(DropSpaceDeployment)' == 'Portable'">true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(DropSpaceDeployment)' == 'Portable'">true</SelfContained>
    <PublishSingleFile Condition="'$(DropSpaceDeployment)' == 'Portable'">true</PublishSingleFile>
    <IncludeAllContentForSelfExtract Condition="'$(DropSpaceDeployment)' == 'Portable'">true</IncludeAllContentForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DropSpaceWin32ResourceDependsOn Condition="'$(WindowsAppSDKSelfContained)' == 'true'">CreateWinRTRegistration</DropSpaceWin32ResourceDependsOn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DropSpace.Core\DropSpace.Core.csproj" />
    <ProjectReference Include="..\DropSpace.Infrastructure\DropSpace.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\AppIcon.ico" />
    <DropSpaceStringResource Include="Strings\**\*.resw" />
  </ItemGroup>
  <PropertyGroup>
    <CudaLyricsRuntimeRoot Condition="'$(CudaLyricsRuntimeRoot)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\cuda-runtime\win-x64</CudaLyricsRuntimeRoot>
    <AiLyricsRuntimeRoot>$(MSBuildProjectDirectory)\..\..\artifacts\ai-runtime\win-x64</AiLyricsRuntimeRoot>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(AiLyricsRuntimeRoot)\runtime-manifest.json')">
    <EmbeddedResource Include="$(AiLyricsRuntimeRoot)\runtime-manifest.json" LogicalName="DropSpace.AiLyricsRuntime.runtime-manifest.json" />
    <EmbeddedResource Include="$(AiLyricsRuntimeRoot)\llama-completion.exe" LogicalName="DropSpace.AiLyricsRuntime.llama-completion.exe" />
    <EmbeddedResource Include="$(AiLyricsRuntimeRoot)\llama-completion-avx2.exe" LogicalName="DropSpace.AiLyricsRuntime.llama-completion-avx2.exe" />
    <EmbeddedResource Include="$(AiLyricsRuntimeRoot)\llama-tokenize.exe" LogicalName="DropSpace.AiLyricsRuntime.llama-tokenize.exe" />
    <EmbeddedResource Include="$(AiLyricsRuntimeRoot)\plain-lyrics-worker.exe" LogicalName="DropSpace.AiLyricsRuntime.plain-lyrics-worker.exe" />
    <EmbeddedResource Include="$(AiLyricsRuntimeRoot)\plain-lyrics-worker-avx2.exe" LogicalName="DropSpace.AiLyricsRuntime.plain-lyrics-worker-avx2.exe" />
    <EmbeddedResource Include="$(AiLyricsRuntimeRoot)\plain-lyrics-worker-vulkan.exe" LogicalName="DropSpace.AiLyricsRuntime.plain-lyrics-worker-vulkan.exe" />
    <EmbeddedResource Include="$(AiLyricsRuntimeRoot)\LICENSE-llama.cpp" LogicalName="DropSpace.AiLyricsRuntime.LICENSE-llama.cpp" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(CudaLyricsRuntimeRoot)\cuda-runtime-manifest.json')">
    <EmbeddedResource Include="$(CudaLyricsRuntimeRoot)\cuda-runtime-manifest.json" LogicalName="DropSpace.CudaLyricsRuntime.cuda-runtime-manifest.json" />
    <EmbeddedResource Include="$(CudaLyricsRuntimeRoot)\cuda-runtime-download.json" LogicalName="DropSpace.CudaLyricsRuntime.cuda-runtime-download.json" />
  </ItemGroup>
  <Target Name="RequireCudaLyricsRuntimeForRelease" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(CudaLyricsRuntimeRoot)\cuda-runtime-manifest.json') or !Exists('$(CudaLyricsRuntimeRoot)\cuda-runtime-download.json')" Text="Supply the trusted CUDA download manifest before a Release build; CUDA binaries stay outside the base app." />
  </Target>
  <Target Name="VerifyCudaBuildBinding" BeforeTargets="CoreCompile"
          DependsOnTargets="AddSourceRevisionToInformationalVersion"
          Condition="'$(OS)' == 'Windows_NT' and Exists('$(CudaLyricsRuntimeRoot)\cuda-runtime-download.json')">
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Test-CudaBuildBinding.ps1&quot; -MetadataDirectory &quot;$(CudaLyricsRuntimeRoot)&quot; -InformationalVersion &quot;$(InformationalVersion)&quot;" />
  </Target>
  <Target Name="RequireAiLyricsRuntimeForRelease" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(AiLyricsRuntimeRoot)\runtime-manifest.json') or !Exists('$(AiLyricsRuntimeRoot)\llama-completion.exe') or !Exists('$(AiLyricsRuntimeRoot)\llama-completion-avx2.exe') or !Exists('$(AiLyricsRuntimeRoot)\llama-tokenize.exe') or !Exists('$(AiLyricsRuntimeRoot)\plain-lyrics-worker.exe') or !Exists('$(AiLyricsRuntimeRoot)\plain-lyrics-worker-avx2.exe') or !Exists('$(AiLyricsRuntimeRoot)\plain-lyrics-worker-vulkan.exe')" Text="Build and verify the pinned local AI runtime with scripts/Build-AiLyricsRuntime.ps1 before a Release build." />
  </Target>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectCapability Include="Msix" Condition="'$(DropSpaceDeployment)' == 'Packaged'" />
  </ItemGroup>
  <PropertyGroup>
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
  <Target
    Name="PrepareDropSpacePackageManifest"
    BeforeTargets="_ValidatePresenceOfAppxManifestItems"
    Condition="'$(DropSpaceDeployment)' == 'Packaged' and '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <DropSpacePackageManifestPath>$(IntermediateOutputPath)DropSpace.Package.appxmanifest</DropSpacePackageManifestPath>
    </PropertyGroup>
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\Package.appxmanifest"
      DestinationFiles="$(DropSpacePackageManifestPath)"
      SkipUnchangedFiles="false" />
    <XmlPoke
      XmlInputPath="$(DropSpacePackageManifestPath)"
      Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version"
      Value="$(DropSpacePackageVersion)" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(DropSpacePackageManifestPath)" />
    </ItemGroup>
  </Target>
  <Target
    Name="CompileDropSpaceBootstrapWin32Resource"
    BeforeTargets="PrepareForBuild"
    Condition="'$(OS)' == 'Windows_NT'"
    Inputs="$(MSBuildProjectDirectory)\DropSpace.rc;$(MSBuildProjectDirectory)\app.manifest;$(MSBuildProjectDirectory)\Assets\AppIcon.ico;$(MSBuildProjectDirectory)\..\..\RELEASE_VERSION;$(MSBuildProjectDirectory)\..\..\scripts\Compile-Win32Resource.ps1"
    Outputs="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(Win32Resource)'))">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Compile-Win32Resource.ps1&quot; -SourcePath &quot;$(MSBuildProjectDirectory)\DropSpace.rc&quot; -ManifestPath &quot;$(MSBuildProjectDirectory)\app.manifest&quot; -OutputPath &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(Win32Resource)'))&quot;" />
  </Target>
  <Target
    Name="CompileDropSpaceWin32Resource"
    BeforeTargets="CoreCompile"
    DependsOnTargets="$(DropSpaceWin32ResourceDependsOn)"
    Condition="'$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(ApplicationManifest)')" Text="The application manifest was not generated before Win32 resource compilation: $(ApplicationManifest)" />
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Compile-Win32Resource.ps1&quot; -SourcePath &quot;$(MSBuildProjectDirectory)\DropSpace.rc&quot; -ManifestPath &quot;$(ApplicationManifest)&quot; -OutputPath &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(Win32Resource)'))&quot;" />
    <PropertyGroup>
      <ApplicationManifest />
      <Win32Manifest />
      <NoWin32Manifest>true</NoWin32Manifest>
    </PropertyGroup>
  </Target>
  <Target
    Name="GenerateDropSpacePortableResourceIndex"
    BeforeTargets="PrepareForBundle"
    Condition="'$(DropSpaceDeployment)' == 'Portable' and '$(OS)' == 'Windows_NT'"
    Inputs="@(DropSpaceStringResource);$(MSBuildProjectDirectory)\..\..\scripts\Generate-PortableResourcesPri.ps1"
    Outputs="$(IntermediateOutputPath)DropSpace.resources.pri">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Generate-PortableResourcesPri.ps1&quot; -ProjectRoot &quot;$(MSBuildProjectDirectory)&quot; -OutputPath &quot;$(IntermediateOutputPath)DropSpace.resources.pri&quot; -ConfigurationPath &quot;$(IntermediateOutputPath)resources.priconfig.xml&quot;" />
  </Target>
  <Target
    Name="BundleDropSpacePortableResourceIndex"
    AfterTargets="PrepareForBundle"
    BeforeTargets="GenerateSingleFileBundle"
    DependsOnTargets="GenerateDropSpacePortableResourceIndex"
    Condition="'$(DropSpaceDeployment)' == 'Portable' and '$(OS)' == 'Windows_NT'">
    <Error Condition="!Exists('$(IntermediateOutputPath)DropSpace.resources.pri')" Text="The portable localization resource index was not generated before single-file bundling." />
    <ItemGroup>
      <FilesToBundle Include="$(IntermediateOutputPath)DropSpace.resources.pri">
        <RelativePath>DropSpace.resources.pri</RelativePath>
      </FilesToBundle>
    </ItemGroup>
  </Target>
</Project>
