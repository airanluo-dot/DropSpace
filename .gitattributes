* text=auto

*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.sln text eol=crlf
*.ps1 text eol=crlf

*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.sql text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.pfx binary

# Canonical brand-package files must retain their exact upstream bytes.
branding/master/*.txt -text

# Reviewed native evidence is hashed byte-for-byte, including Windows line endings.
scripts/ai-model-qa/evidence/** -text

# Original downloaded checksum evidence retains the public asset's exact bytes.
docs/dev/evidence/ten-language/beta19-SHA256SUMS.txt -text whitespace=cr-at-eol

# Pinned third-party orthography data/license retain upstream bytes.
src/DropSpace.Core/Lyrics/Data/*.txt -text
