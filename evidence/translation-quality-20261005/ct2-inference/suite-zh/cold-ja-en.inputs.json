    {
      "id": "09",
      "text": "月を見ていたのは君じゃなくて、僕だった。"
    },
    {
      "id": "10",
      "text": "その光は消えなかった、僕が目を閉じただけ。"
    },
    {
      "id": "11",
      "text": "帰らないとは言っていない、今夜は帰れないと言ったんだ。"
    }
