<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="diagnostic-profiles.json" LogicalName="DropSpace.SelectionDiagnosticProfiles.json" />
    <EmbeddedResource Include="identity-validation-v1.json" LogicalName="DropSpace.IdentityValidationV1.json" />
    <ProjectReference Include="../../src/DropSpace.Infrastructure/DropSpace.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Link unchanged production Windows owner/limits; no unrestricted Process.Start. -->
    <Compile Include="../../src/DropSpace.Infrastructure/Lyrics/LocalInferenceProcess.cs" Link="Production/LocalInferenceProcess.cs" />
    <Compile Include="../../src/DropSpace.Infrastructure/Lyrics/WindowsInferenceProcess.cs" Link="Production/WindowsInferenceProcess.cs" />
    <Compile Include="../../src/DropSpace.Infrastructure/Lyrics/CpuInferenceMemoryPolicy.cs" Link="Production/CpuInferenceMemoryPolicy.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(EvidenceRuntimeDirectory)' != ''">
    <EmbeddedResource Include="$(EvidenceRuntimeDirectory)/runtime-manifest.json" LogicalName="DropSpace.AiLyricsRuntime.runtime-manifest.json" />
    <EmbeddedResource Include="$(EvidenceRuntimeDirectory)/plain-lyrics-worker.exe" LogicalName="DropSpace.AiLyricsRuntime.plain-lyrics-worker.exe" />
    <EmbeddedResource Include="$(EvidenceRuntimeDirectory)/plain-lyrics-worker-avx2.exe" LogicalName="DropSpace.AiLyricsRuntime.plain-lyrics-worker-avx2.exe" />
    <EmbeddedResource Include="$(EvidenceRuntimeDirectory)/plain-lyrics-worker-vulkan.exe" LogicalName="DropSpace.AiLyricsRuntime.plain-lyrics-worker-vulkan.exe" />
  </ItemGroup>
</Project>
