<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <HotkeySourcePath Condition="'$(HotkeySourcePath)' == ''">../../src/DropSpace.App/Services/GlobalQuickPanelHotkeyService.cs</HotkeySourcePath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/DropSpace.Core/DropSpace.Core.csproj" />
    <Compile Include="$(HotkeySourcePath)" Link="Production/GlobalQuickPanelHotkeyService.cs" />
    <Compile Include="../../src/DropSpace.App/Services/GlobalMusicWindowHotkeyService.cs" Link="Production/GlobalMusicWindowHotkeyService.cs" />
    <Compile Include="../../src/DropSpace.App/Services/NativeSubscriberNotification.cs" Link="Production/NativeSubscriberNotification.cs" />
  </ItemGroup>
</Project>
