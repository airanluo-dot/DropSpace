<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RetrievalSourcePath Condition="'$(RetrievalSourcePath)' == ''">../../src/DropSpace.App/ViewModels/IslandRetrievalViewModel.cs</RetrievalSourcePath>
    <CardSourcePath Condition="'$(CardSourcePath)' == ''">../../src/DropSpace.App/ViewModels/ItemCardViewModel.cs</CardSourcePath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="../../src/DropSpace.Core/DropSpace.Core.csproj" />
    <Compile Include="$(RetrievalSourcePath)" Link="Production/IslandRetrievalViewModel.cs" />
    <Compile Include="$(CardSourcePath)" Link="Production/ItemCardViewModel.cs" />
    <Compile Include="../../src/DropSpace.App/ViewModels/QuickActionButtonViewModel.cs" Link="Production/QuickActionButtonViewModel.cs" />
  </ItemGroup>
</Project>
