<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DropSpace.Module.Worker</AssemblyName>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- The worker compiles the same wire records; it receives no host service/container DLL. -->
    <Compile Include="../../../src/DropSpace.Core/Dlc/ModuleContracts.cs" Link="Contract/ModuleContracts.cs" />
  </ItemGroup>
</Project>
