        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 대기열 대기 시간이 만료되었습니다. 다시 시도해 주세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
