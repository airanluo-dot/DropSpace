          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'activité du Presse-papiers était trop fréquente ; un événement a été ignoré."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad del portapapeles era demasiado frecuente; se omitió un evento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atividade da área de transferência era muito frequente; um evento foi ignorado."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена был слишком частым; одно событие было пропущено."
          }
        }
      }
    },
    "ClipboardItemCaptureFailed": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A clipboard item could not be recorded. Recording is still running."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "一个剪贴板项目未能记录；记录功能仍在运行。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法記錄此剪貼簿項目。剪貼簿記錄仍在進行。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボード項目を記録できませんでした。記録はまだ実行中です。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 항목을 기록할 수 없습니다. 기록이 계속 진행 중입니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zwischenablageelement konnte nicht aufgezeichnet werden. Die Aufzeichnung läuft noch."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément du presse-papiers n'a pas pu être enregistré. L'enregistrement est toujours en cours."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo grabar un elemento del portapapeles. La grabación aún está en marcha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gravar um item da área de transferência. A gravação ainda está em execução."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось записать элемент буфера обмена. Запись все еще идет."
          }
        }
      }
    },
    "ClipboardLimitInvalidContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The total size limit for a capture cannot be lower than the single-file size limit."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "单次文件总大小上限不能小于单个文件大小上限。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "擷取的總大小限制不能低於單一檔案大小限制。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャの合計サイズ制限は、単一ファイルのサイズ制限より小さくすることはできません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처의 총 크기 제한은 단일 파일 크기 제한보다 낮을 수 없습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gesamtgrößenbeschränkung für eine Aufnahme darf nicht niedriger sein als die Größenbeschränkung für eine einzelne Datei."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille limite totale d'une capture ne peut pas être inférieure à la taille limite d'un seul fichier."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite de tamaño total para una captura no puede ser inferior al límite de tamaño de un solo archivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de tamanho total para uma captura não pode ser inferior ao limite de tamanho de arquivo único."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий предел размера захвата не может быть ниже максимального размера одного файла."
          }
        }
      }
    },
