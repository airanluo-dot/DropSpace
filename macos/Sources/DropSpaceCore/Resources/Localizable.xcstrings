    "FileDragWakeModeDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart detection does not occupy the top edge while idle. Classic mode may be more compatible but keeps an invisible top input area active."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "智能检测空闲时不占用屏幕顶部；传统模式兼容范围可能更广，但会长期保留不可见顶部输入区域。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "空閒時智慧型偵測不佔據頂部邊緣。經典模式可能更相容，但會保持不可見的頂部輸入區域處於活動狀態。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "スマート検出は、アイドル状態では上端を占有しません。クラシック モードの方が互換性が高い可能性がありますが、非表示の上部入力領域がアクティブのままになります。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "유휴 상태에서는 스마트 감지가 상단 가장자리를 차지하지 않습니다. 클래식 모드는 호환성이 더 높지만 보이지 않는 상단 입력 영역을 활성 상태로 유지합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die intelligente Erkennung belegt im Leerlauf nicht die Oberkante. Der klassische Modus ist möglicherweise kompatibler, behält jedoch einen unsichtbaren oberen Eingabebereich bei."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection intelligente n'occupe pas le bord supérieur en cas d'inactivité. Le mode classique est peut-être plus compatible mais conserve une zone de saisie supérieure invisible active."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección inteligente no ocupa el borde superior mientras está inactiva. El modo clásico puede ser más compatible, pero mantiene activa un área de entrada superior invisible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A detecção inteligente não ocupa a borda superior durante o modo inativo. O modo clássico pode ser mais compatível, mas mantém ativa uma área de entrada superior invisível."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Интеллектуальное обнаружение не занимает верхний край во время простоя. Классический режим может быть более совместимым, но сохраняет активной невидимую верхнюю область ввода."
          }
        }
      }
    },
