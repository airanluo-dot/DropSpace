          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "SHA-256 チェックサムはファイルの内容を識別します。それをコピーして、別のファイルのチェックサムと比較します。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "SHA-256 체크섬은 파일 내용을 식별합니다. 다른 파일의 체크섬과 비교하려면 복사하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine SHA-256-Prüfsumme identifiziert den Dateiinhalt. Kopieren Sie es, um es mit der Prüfsumme einer anderen Datei zu vergleichen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Une somme de contrôle SHA-256 identifie le contenu du fichier. Copiez-le pour le comparer avec la somme de contrôle d'un autre fichier."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suma de comprobación SHA-256 identifica el contenido del archivo. Cópielo para compararlo con la suma de verificación de otro archivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma soma de verificação SHA-256 identifica o conteúdo do arquivo. Copie-o para comparar com a soma de verificação de outro arquivo."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрольная сумма SHA-256 идентифицирует содержимое файла. Скопируйте его, чтобы сравнить с контрольной суммой другого файла."
          }
        }
      }
    },
