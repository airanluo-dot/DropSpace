    "ClipboardBusyRetrying": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard is temporarily in use by another app. Retrying."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板暂时被其他程序占用，正在重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿暫時由其他應用程式使用，正在重試。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードは別のアプリによって一時的に使用されています。再試行中です。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드가 다른 앱에서 일시적으로 사용 중입니다. 재시도 중입니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage wird vorübergehend von einer anderen App verwendet. Erneuter Versuch."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers est temporairement utilisé par une autre application. Réessayer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra aplicación está utilizando temporalmente el portapapeles. Reintentando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência está temporariamente em uso por outro aplicativo. Tentando novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена временно используется другим приложением. Повторная попытка."
          }
        }
      }
    },
    "ClipboardCaptureStopped": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard recording stopped because of an internal error."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板记录因内部错误停止。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "由於內部錯誤，剪貼簿記錄已停止。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "内部エラーのため、クリップボードの記録が停止しました。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "내부 오류로 인해 클립보드 기록이 중지되었습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufzeichnung der Zwischenablage wurde aufgrund eines internen Fehlers gestoppt."
