    "MotionDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "System default respects Windows reduce-motion settings."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统会尊重 Windows 减少动态效果。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨系統時，會遵循 Windows 的減少動畫設定。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのデフォルトでは、Windows モーション削減設定が考慮されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 기본값은 Windows 모션 감소 설정을 따릅니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Systemstandard berücksichtigt Windows Einstellungen zur Bewegungsreduzierung."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système par défaut respecte les paramètres de réduction de mouvement Windows."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración predeterminada del sistema respeta Windows la configuración de reducción de movimiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão do sistema respeita as configurações de redução de movimento Windows."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию в системе учитываются настройки Windows уменьшения движения."
          }
        }
      }
    },
