    "Mac.InternetBackendMissing": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet Share is unavailable. Configure an HTTPS sharing service using DROPSPACE_SHARE_BACKEND_URL, then restart DropSpace. Existing shares can still be revoked."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "互联网分享不可用。请通过 DROPSPACE_SHARE_BACKEND_URL 配置 HTTPS 分享服务，然后重启 DropSpace。已有分享仍可撤销。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "網際網路分享無法使用。請透過 DROPSPACE_SHARE_BACKEND_URL 設定 HTTPS 分享服務，然後重新啟動 DropSpace。現有分享仍可撤銷。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット共有は利用できません。DROPSPACE_SHARE_BACKEND_URL で HTTPS 共有サービスを設定し、DropSpace を再起動してください。既存の共有は取り消せます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷 공유를 사용할 수 없습니다. DROPSPACE_SHARE_BACKEND_URL로 HTTPS 공유 서비스를 설정한 후 DropSpace를 다시 시작하세요. 기존 공유는 계속 취소할 수 있습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetfreigabe ist nicht verfügbar. Konfigurieren Sie einen HTTPS-Freigabedienst über DROPSPACE_SHARE_BACKEND_URL und starten Sie DropSpace neu. Bestehende Freigaben können weiterhin widerrufen werden."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage Internet est indisponible. Configurez un service HTTPS via DROPSPACE_SHARE_BACKEND_URL, puis redémarrez DropSpace. Les partages existants peuvent toujours être révoqués."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso compartido por Internet no está disponible. Configure un servicio HTTPS mediante DROPSPACE_SHARE_BACKEND_URL y reinicie DropSpace. Los enlaces existentes se pueden revocar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compartilhamento pela Internet está indisponível. Configure um serviço HTTPS com DROPSPACE_SHARE_BACKEND_URL e reinicie o DropSpace. Os compartilhamentos existentes ainda podem ser revogados."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмен через Интернет недоступен. Настройте службу HTTPS через DROPSPACE_SHARE_BACKEND_URL и перезапустите DropSpace. Существующие ссылки по-прежнему можно отозвать."
          }
        }
      }
    },
    "Mac.InternetDisabled": {
      "localizations": {
        "en-US": {
