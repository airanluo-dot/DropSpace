          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое устройство отклонило эту передачу."
          }
        }
      }
    },
    "FileTransferApprovalTimeout": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device did not respond in time. Try again when it is ready."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "对方设备未及时响应。请在对方准备好后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "對方裝置未及時回應。請在對方準備好後再試一次。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のデバイスから時間内に応答がありませんでした。相手の準備ができてから、もう一度お試しください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기가 제시간에 응답하지 않았습니다. 상대 기기가 준비되면 다시 시도하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das andere Gerät hat nicht rechtzeitig geantwortet. Versuchen Sie es erneut, wenn es bereit ist."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autre appareil n’a pas répondu à temps. Réessayez lorsqu’il sera prêt."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El otro dispositivo no ha respondido a tiempo. Vuelva a intentarlo cuando esté listo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O outro dispositivo não respondeu a tempo. Tente novamente quando ele estiver pronto."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое устройство не ответило вовремя. Повторите попытку, когда оно будет готово."
          }
        }
      }
    },
    "FileTransferNetworkError": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the other device failed. Check its transfer status before trying again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "与对方设备的连接失败。请先确认对方的接收情况，再重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "與對方裝置的連線失敗。請先確認對方的接收情況，再試一次。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のデバイスとの接続に失敗しました。再試行する前に、相手の受信状況を確認してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "상대 기기와 연결하지 못했습니다. 다시 시도하기 전에 상대 기기의 수신 상태를 확인하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum anderen Gerät ist fehlgeschlagen. Prüfen Sie dort den Übertragungsstatus, bevor Sie es erneut versuchen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à l’autre appareil a échoué. Vérifiez l’état du transfert sur cet appareil avant de réessayer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha fallado la conexión con el otro dispositivo. Compruebe el estado de la transferencia en él antes de volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com o outro dispositivo falhou. Verifique o status da transferência nele antes de tentar novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось установить или сохранить соединение с другим устройством. Проверьте состояние передачи на нём перед повторной попыткой."
          }
        }
      }
    },
    "FileTransferSourceError": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A source file is unavailable, unreadable, or has changed. Check the source files and try again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "源文件不存在、无法读取或已发生变化。请检查源文件后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "來源檔案不存在、無法讀取或已變更。請檢查來源檔案後再試一次。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルが見つからないか、読み取れないか、変更されています。元のファイルを確認して、もう一度お試しください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일이 없거나, 읽을 수 없거나, 변경되었습니다. 원본 파일을 확인한 후 다시 시도하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Quelldatei ist nicht verfügbar, nicht lesbar oder wurde geändert. Prüfen Sie die Quelldateien und versuchen Sie es erneut."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier source est indisponible, illisible ou a été modifié. Vérifiez les fichiers sources et réessayez."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo de origen no está disponible, no se puede leer o ha cambiado. Compruebe los archivos de origen y vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo de origem está indisponível, não pode ser lido ou foi alterado. Verifique os arquivos de origem e tente novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный файл недоступен, не читается или был изменён. Проверьте исходные файлы и повторите попытку."
          }
        }
      }
    },
    "FileTransferFailed": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer did not finish. Check the source files and the other device before trying again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "传输未完成。请检查源文件和对方设备的接收情况后再重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "傳輸未完成。請檢查來源檔案及對方裝置的接收情況後再試一次。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "転送が完了しませんでした。元のファイルと相手のデバイスの受信状況を確認してから、もう一度お試しください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "전송이 완료되지 않았습니다. 원본 파일과 상대 기기의 수신 상태를 확인한 후 다시 시도하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung wurde nicht abgeschlossen. Prüfen Sie die Quelldateien und den Empfangsstatus auf dem anderen Gerät, bevor Sie es erneut versuchen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert ne s’est pas terminé. Vérifiez les fichiers sources et la réception sur l’autre appareil avant de réessayer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia no se ha completado. Compruebe los archivos de origen y la recepción en el otro dispositivo antes de volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência não foi concluída. Verifique os arquivos de origem e o recebimento no outro dispositivo antes de tentar novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача не завершилась. Проверьте исходные файлы и результат получения на другом устройстве перед повторной попыткой."
          }
        }
      }
    },
