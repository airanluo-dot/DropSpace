    "NeteaseEnhancementErrorUnexpected": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation failed. You can retry; details are available in diagnostics."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失败，可重试。具体原因可在诊断记录中查看。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失敗。您可以重試；詳細資訊可在診斷中找到。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "操作は失敗しました。再試行できます。詳細は診断で確認できます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 실패했습니다. 다시 시도할 수 있습니다. 자세한 내용은 진단에서 확인할 수 있습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang ist fehlgeschlagen. Sie können es erneut versuchen; Einzelheiten finden Sie in der Diagnose."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération a échoué. Vous pouvez réessayer ; les détails sont disponibles dans les diagnostics."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación fracasó. Puedes volver a intentarlo; Los detalles están disponibles en diagnóstico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação falhou. Você pode tentar novamente; detalhes estão disponíveis em diagnósticos."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция провалилась. Вы можете повторить попытку; Подробности есть в диагностике."
          }
        }
      }
    },
    "NeteaseEnhancementErrorNotFound": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "NetEase Music was not found on this computer."
          }
        },
        "zh-CN": {
