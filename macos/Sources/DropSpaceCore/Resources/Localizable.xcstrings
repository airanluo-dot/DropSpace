    "UpdateChannelDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable receives release versions only. Beta receives Stable and prerelease versions, ordered by release number."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable 只接收正式版；Beta 接收正式版和测试版，并按数字版本顺序选择更新。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "穩定版僅接收發布版本。 Beta 收到穩定版和預發行版，按發行號排序。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "安定版はリリース バージョンのみを受け取ります。ベータ版では、リリース番号順に安定版とプレリリース バージョンが提供されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable은 릴리스 버전만 받습니다. 베타에는 릴리스 번호순으로 정렬된 안정 버전과 시험판 버전이 제공됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable erhält nur Release-Versionen. Beta erhält stabile und Vorabversionen, sortiert nach Release-Nummer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable reçoit uniquement les versions release. La bêta reçoit des versions stables et préliminaires, classées par numéro de version."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estable solo recibe versiones de lanzamiento. Beta recibe versiones estable y preliminar, ordenadas por número de versión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable recebe apenas versões de lançamento. Beta recebe versões estáveis ​​e de pré-lançamento, ordenadas por número de lançamento."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Стабильная версия получает только релизные версии. Бета-версия получает стабильную и предварительную версии, упорядоченные по номеру выпуска."
          }
        }
      }
    },
