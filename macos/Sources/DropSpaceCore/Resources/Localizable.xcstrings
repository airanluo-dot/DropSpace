    "EmptySpaceDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace stores references only. It never moves or deletes your original files."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 只保存引用，不会移动或删除原始文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 僅儲存引用。它永遠不會移動或刪除您的原始檔案。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace は参照のみを保存します。元のファイルを移動したり削除したりすることはありません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace는 참조만 저장합니다. 원본 파일을 이동하거나 삭제하지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace speichert nur Referenzen. Es verschiebt oder löscht niemals Ihre Originaldateien."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace stocke uniquement les références. Il ne déplace ni ne supprime jamais vos fichiers originaux."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace almacena solo referencias. Nunca mueve ni elimina sus archivos originales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace armazena apenas referências. Ele nunca move ou exclui seus arquivos originais."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace хранит только ссылки. Он никогда не перемещает и не удаляет исходные файлы."
          }
        }
      }
    },
