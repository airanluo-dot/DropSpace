    "IncomingTransferContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A trusted device wants to send {0} item(s), totaling {1} bytes. Files will be verified before they are committed to Downloads\\DropSpace."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "可信设备请求发送 {0} 项内容，共 {1} 字节。文件会在提交到“下载\\DropSpace”前完成校验。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "受信任的裝置想要傳送 {0} 個項目，共 {1} 位元組。檔案會先驗證，再存入 Downloads\\DropSpace。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できるデバイスが {0} 個の項目 (合計 {1} バイト) を送信しようとしています。ファイルは Downloads\\DropSpace にコミットされる前に検証されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 장치가 총 {1}바이트에 달하는 {0} 항목을 보내려고 합니다. 파일은 Downloads\\DropSpace에 커밋되기 전에 확인됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein vertrauenswürdiges Gerät möchte {0} Elemente mit insgesamt {1} Bytes senden. Die Dateien werden vor dem Speichern in Downloads\\DropSpace überprüft."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil de confiance souhaite envoyer {0} éléments, soit {1} octets. Les fichiers seront vérifiés avant d’être enregistrés dans Downloads\\DropSpace."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo de confianza quiere enviar {0} elementos, con un total de {1} bytes. Los archivos se verificarán antes de guardarse en Downloads\\DropSpace."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dispositivo confiável quer enviar {0} itens, com um total de {1} bytes. Os arquivos serão verificados antes de serem salvos em Downloads\\DropSpace."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверенное устройство хочет отправить {0} элементов общим объёмом {1} байт. Файлы будут проверены перед сохранением в Downloads\\DropSpace."
          }
        }
      }
    },
