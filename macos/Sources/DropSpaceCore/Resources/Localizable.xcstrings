    "ClearConfirmContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} unpinned Clipboard item(s) will be removed. Pinned items remain, and original files in Temporary Space are unaffected."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将从剪贴板移除 {0} 项未固定记录。固定项目会保留，临时空间中的原始文件不会受影响。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 取消固定的剪貼簿專案將會被刪除。固定的專案仍然存在，暫存空間中的原始檔案不受影響。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めされていないクリップボード項目を {0} 件削除します。ピン留めした項目は残り、一時スペース内の元のファイルには影響しません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 고정 해제된 클립보드 항목이 제거됩니다. 고정된 항목은 그대로 유지되며 임시 공간에 있는 원본 파일은 영향을 받지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} Nicht angeheftete Elemente in der Zwischenablage werden entfernt. Angeheftete Elemente bleiben bestehen und Originaldateien in Temporärer Bereich sind davon nicht betroffen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} les éléments du Presse-papiers non épinglés seront supprimés. Les éléments épinglés restent et les fichiers originaux dans Espace temporaire ne sont pas affectés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} Los elementos del Portapapeles que no estén fijados se eliminarán. Los elementos fijados permanecen y los archivos originales en Espacio temporal no se ven afectados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} itens não fixados da área de transferência serão removidos. Os itens fixados permanecem e os arquivos originais no Espaço temporário não são afetados."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} незакрепленные элементы буфера обмена будут удалены. Закрепленные элементы остаются, а исходные файлы в Временное пространство не затрагиваются."
          }
        }
      }
    },
