    "AutoCheckUpdatesDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks at most once per DropSpace process launch; no background timer runs."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "每次 DropSpace 进程启动最多检查一次；不会运行后台定时器。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "每次 DropSpace 程序啟動時最多檢查一次；沒有後臺計時器執行。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace プロセスの起動ごとに最大 1 回チェックします。バックグラウンドタイマーは実行されません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 프로세스 실행당 최대 한 번 확인합니다. 백그라운드 타이머가 실행되지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft höchstens einmal pro DropSpace Prozessstart; Es läuft kein Hintergrund-Timer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie au maximum une fois par lancement de processus DropSpace ; aucune minuterie d'arrière-plan ne s'exécute."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba como máximo una vez por cada DropSpace inicio del proceso; no se ejecuta ningún temporizador en segundo plano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica no máximo uma vez por inicialização do processo DropSpace; nenhum cronômetro em segundo plano é executado."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяется не более одного раза при каждом запуске процесса DropSpace; фоновый таймер не запускается."
          }
        }
      }
    },
    "AutoDownloadUpdatesTitle.Text": {
      "localizations": {
