    "AiLyricsLegacyModelsHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "These older model files are no longer used for translation. You can remove them to free disk space."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这些旧版模型文件已不再用于翻译，可删除以释放磁盘空间。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這些舊模型檔案不再用於翻譯。您可以刪除它們以釋放磁碟空間。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの古いモデル ファイルは、翻訳には使用されなくなりました。それらを削除してディスク領域を解放できます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 이전 모델 파일은 더 이상 번역에 사용되지 않습니다. 이를 제거하여 디스크 공간을 확보할 수 있습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese älteren Modelldateien werden nicht mehr für die Übersetzung verwendet. Sie können sie entfernen, um Speicherplatz freizugeben."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces anciens fichiers de modèles ne sont plus utilisés pour la traduction. Vous pouvez les supprimer pour libérer de l'espace disque."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos archivos de modelos antiguos ya no se utilizan para la traducción. Puede eliminarlos para liberar espacio en el disco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses arquivos de modelo mais antigos não são mais usados para tradução. Você pode removê-los para liberar espaço em disco."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти старые файлы моделей больше не используются для перевода. Вы можете удалить их, чтобы освободить место на диске."
          }
        }
      }
    },
