          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace принимает только файлы и папки из Windows общего ресурса."
          }
        }
      }
    },
    "ShareItemsNotAdded": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
