    "AutoInstallUpdatesDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Available only when the update passes trusted Authenticode publisher verification; it remains off for unsigned builds."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "只有更新通过可信 Authenticode 发布者验证时才可用；当前未签名构建保持关闭。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當更新通過受信任的 Authenticode 發行者驗證時才可用；未簽署的版本會保持關閉。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが信頼できる Authenticode 発行者の検証に合格した場合にのみ使用できます。未署名のビルドではオフのままです。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트가 신뢰할 수 있는 Authenticode 게시자 확인을 통과한 경우에만 사용할 수 있습니다. 서명되지 않은 빌드의 경우 꺼진 상태로 유지됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur verfügbar, wenn das Update die Überprüfung durch den vertrauenswürdigen Authenticode-Herausgeber besteht. Für nicht signierte Builds bleibt es deaktiviert."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible uniquement lorsque la mise à jour réussit la vérification de l'éditeur Authenticode de confiance ; il reste désactivé pour les versions non signées."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible solo cuando la actualización pasa la verificación del editor confiable de Authenticode; permanece desactivado para compilaciones sin firmar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível somente quando a atualização passa na verificação do editor Authenticode confiável; ele permanece desativado para compilações não assinadas."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно только в том случае, если обновление прошло проверку доверенного издателя Authenticode; он остается отключенным для неподписанных сборок."
          }
        }
      }
    },
