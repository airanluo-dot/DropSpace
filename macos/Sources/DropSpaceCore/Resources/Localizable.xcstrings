    "SettingsUpdateFailed": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update {0}. DropSpace attempted to restore the previous settings. Check permissions or connection status for this feature and retry. Diagnostic ID: {1}."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未能更新“{0}”，已尝试恢复原设置。请检查该功能的系统权限或连接状态后重试。诊断编号：{1}。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更新 {0}。 DropSpace 嘗試還原先前的設定。檢查此功能的許可權或連線狀態並重試。診斷 ID：{1}。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "{0}を更新できませんでした。 DropSpace は以前の設定を復元しようとしました。この機能の権限または接続ステータスを確認して、再試行してください。診断 ID: {1}。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0}을(를) 업데이트할 수 없습니다. DropSpace이(가) 이전 설정을 복원하려고 시도했습니다. 이 기능에 대한 권한이나 연결 상태를 확인하고 다시 시도하세요. 진단 ID: {1}."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} konnte nicht aktualisiert werden. DropSpace hat versucht, die vorherigen Einstellungen wiederherzustellen. Überprüfen Sie die Berechtigungen oder den Verbindungsstatus für diese Funktion und versuchen Sie es erneut. Diagnose-ID: {1}."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour {0}. DropSpace a tenté de restaurer les paramètres précédents. Vérifiez les autorisations ou l’état de connexion pour cette fonctionnalité et réessayez. ID de diagnostic : {1}."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar {0}. DropSpace intentó restaurar la configuración anterior. Verifique los permisos o el estado de la conexión para esta función y vuelva a intentarlo. ID de diagnóstico: {1}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar {0}. DropSpace tentou restaurar as configurações anteriores. Verifique as permissões ou o status da conexão para esse recurso e tente novamente. ID de diagnóstico: {1}."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить {0}. DropSpace попытался восстановить предыдущие настройки. Проверьте разрешения или состояние подключения для этой функции и повторите попытку. Идентификатор диагностики: {1}."
          }
        }
      }
    },
