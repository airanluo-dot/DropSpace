    "Mac.PlayerNeedsAccessibility": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission is required to read and use this player’s controls. Grant it in System Settings, then check again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "读取和使用此播放器的控件需要辅助功能权限。请在系统设置中授权，然后重新检测。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取和使用此播放器的控制項需要輔助使用權限。請在系統設定中授權，然後重新檢查。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレーヤーの操作にはアクセシビリティの許可が必要です。システム設定で許可し、再度確認してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이어 컨트롤을 읽고 사용하려면 손쉬운 사용 권한이 필요합니다. 시스템 설정에서 허용한 후 다시 확인하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Lesen und Verwenden dieser Steuerung ist die Berechtigung für Bedienungshilfen erforderlich. Erteilen Sie sie in den Systemeinstellungen und prüfen Sie erneut."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’accessibilité est nécessaire pour lire et utiliser ces commandes. Accordez-la dans Réglages Système, puis vérifiez à nouveau."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de accesibilidad para leer y usar estos controles. Concédalo en Ajustes del Sistema y vuelva a comprobarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária permissão de acessibilidade para ler e usar esses controles. Conceda-a nos Ajustes do Sistema e verifique novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Для чтения и использования команд плеера нужен Универсальный доступ. Разрешите его в Системных настройках и повторите проверку."
          }
        }
      }
    },
