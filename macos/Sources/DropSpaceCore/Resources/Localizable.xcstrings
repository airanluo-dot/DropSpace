    "RemoveFileReferenceContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the reference to “{0}” will be removed. The original file will not be moved or deleted."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "只会移除“{0}”的引用，原始文件不会被移动或删除。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅刪除對“{0}”的引用。原始檔案不會被移動或刪除。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "「{0}」への参照のみが削除されます。元のファイルは移動または削除されません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{0}\"에 대한 참조만 제거됩니다. 원본 파일은 이동되거나 삭제되지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Lediglich der Verweis auf „{0}“ wird entfernt. Die Originaldatei wird nicht verschoben oder gelöscht."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la référence à « {0} » sera supprimée. Le fichier original ne sera ni déplacé ni supprimé."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo se eliminará la referencia a “{0}”. El archivo original no se moverá ni eliminará."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente a referência a “{0}” será removida. O arquivo original não será movido ou excluído."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет удалена только ссылка на «{0}». Исходный файл не будет перемещен или удален."
          }
        }
      }
    },
    "RemoveStoredItemContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "“{0}” and the local copy kept by DropSpace will be removed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将移除“{0}”及 DropSpace 保存的本地副本。"
