    "EmptyPinnedDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin items from Temporary Space or Clipboard and they will appear together here."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "固定临时空间或剪贴板中的项目，它们就会集中显示在这里。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "固定暫存空間或剪貼簿中的專案，它們將一起出現在此。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "一時スペース またはクリップボードからアイテムをピン留めすると、ここに一緒に表示されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 공간 또는 클립보드의 항목을 고정하면 여기에 함께 표시됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Heften Sie Elemente aus Temporärer Bereich oder der Zwischenablage an und sie werden hier zusammen angezeigt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Épinglez les éléments de Espace temporaire ou du Presse-papiers et ils apparaîtront ensemble ici."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija elementos de Espacio temporal o Portapapeles y aparecerán juntos aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe itens do Espaço temporário ou da área de transferência e eles aparecerão juntos aqui."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепите элементы из Временное пространство или буфера обмена, и они появятся здесь вместе."
          }
        }
      }
    },
