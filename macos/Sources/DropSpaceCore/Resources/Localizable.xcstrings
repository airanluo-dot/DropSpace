    "TransferSentContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The trusted device accepted the transfer and DropSpace verified the content before commit."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "可信设备已接受传输，DropSpace 在提交前完成了内容校验。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "受信任的裝置接受了傳輸，並在提交之前 DropSpace 驗證了內容。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できるデバイスは転送を受け入れ、DropSpace はコミット前にコンテンツを検証しました。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 장치가 전송을 수락하고 DropSpace이 커밋하기 전에 콘텐츠를 확인했습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das vertrauenswürdige Gerät hat die Übertragung akzeptiert und DropSpace den Inhalt vor dem Übertragen überprüft."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil de confiance a accepté le transfert et DropSpace a vérifié le contenu avant la validation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo confiable aceptó la transferencia y DropSpace verificó el contenido antes de la confirmación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo confiável aceitou a transferência e DropSpace verificou o conteúdo antes de confirmar."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверенное устройство приняло передачу и DropSpace проверило содержимое перед фиксацией."
          }
        }
      }
    },
