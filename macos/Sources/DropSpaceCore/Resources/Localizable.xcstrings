    "EmptyClipboardDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy text, images, files, or folders and supported content will appear here."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "复制文本、图片、文件或文件夹后，支持的内容会出现在这里。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "複製文字、影象、檔案或資料夾，支援的內容將顯示在此。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト、画像、ファイル、フォルダーをコピーすると、サポートされているコンテンツがここに表示されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트, 이미지, 파일 또는 폴더를 복사하면 지원되는 콘텐츠가 여기에 표시됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden kopierter Text, Bilder, Dateien oder Ordner sowie unterstützte Inhalte angezeigt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
