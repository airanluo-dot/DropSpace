    "Mac.NeteaseNativeHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the playback controls exposed by this player. This connection currently provides no song details, artwork, lyrics, seeking or spectrum in DropSpace."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此播放器提供的播放控件。此连接目前不在 DropSpace 中提供歌曲信息、封面、歌词、进度定位或频谱。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此播放器提供的播放控制項。此連線目前不在 DropSpace 中提供歌曲資訊、封面、歌詞、進度定位或頻譜。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレーヤーが提供する再生操作を利用します。この接続では現在、DropSpace に曲情報、アートワーク、歌詞、シーク、スペクトラムを提供できません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이어가 제공하는 재생 컨트롤을 사용합니다. 이 연결은 현재 DropSpace에 곡 정보, 앨범 표지, 가사, 탐색 또는 스펙트럼을 제공하지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Wiedergabesteuerung dieses Players. Diese Verbindung bietet in DropSpace derzeit keine Titeldaten, Cover, Liedtexte, Positionswahl oder Spektrumanzeige."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les commandes de lecture fournies par ce lecteur. Cette connexion ne fournit actuellement ni informations sur le titre, ni pochette, paroles, recherche de position ou spectre dans DropSpace."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Use los controles de reproducción que ofrece este reproductor. Esta conexión aún no proporciona información de la canción, portada, letras, búsqueda de posición ni espectro en DropSpace."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os controles de reprodução oferecidos pelo player. Esta conexão ainda não fornece informações da música, capa, letras, busca de posição ou espectro no DropSpace."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте доступные команды воспроизведения этого плеера. Это подключение пока не предоставляет DropSpace сведения о песне, обложку, текст, перемотку или спектр."
          }
        }
      }
    },
