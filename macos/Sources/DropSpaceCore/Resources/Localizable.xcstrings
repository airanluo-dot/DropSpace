    "PairingSasContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify that the other device shows the same six-digit code: {0}. Only continue if both screens match."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "确认另一台设备显示相同的六位代码：{0}。只有两边一致时才继续。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認另一個裝置顯示相同的六位數配對碼：{0}。只有兩邊的配對碼一致時才能繼續。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスに同じ 6 桁のコード {0} が表示されていることを確認します。両方の画面が一致する場合にのみ続行します。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 장치에도 동일한 6자리 코드({0})가 표시되는지 확인하십시오. 두 화면이 모두 일치하는 경우에만 계속하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sicher, dass das andere Gerät denselben sechsstelligen Code anzeigt: {0}. Fahren Sie nur fort, wenn beide Bildschirme übereinstimmen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que l'autre appareil affiche le même code à six chiffres : {0}. Ne continuez que si les deux écrans correspondent."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique que el otro dispositivo muestre el mismo código de seis dígitos: {0}. Continúe solo si ambas pantallas coinciden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira se o outro dispositivo mostra o mesmo código de seis dígitos: {0}. Continue apenas se os códigos forem iguais nas duas telas."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что на другом устройстве отображается тот же шестизначный код: {0}. Продолжайте, только если оба экрана совпадают."
          }
        }
      }
    },
