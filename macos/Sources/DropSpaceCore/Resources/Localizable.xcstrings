    "AiLyricsGpuAccelerationHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer a compatible GPU for AI translation. If GPU acceleration is unavailable or fails, the app uses the CPU instead. Turn this off to use only the CPU. Changing this preference does not turn on AI or download a model."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用兼容的 GPU 加速 AI 翻译；GPU 不可用或运行失败时自动改用 CPU。关闭后仅使用 CPU。调整此选项不会启用 AI 或下载模型。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "首選相容的 GPU 進行 AI 翻譯。如果 GPU 加速不可用或失敗，應用程式將改用 CPU。關閉此功能即可僅使用 CPU。更改此首選項不會開啟 AI 或下載模型。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 翻訳には互換性のある GPU を優先します。 GPU アクセラレーションが利用できない場合、または失敗した場合、アプリは代わりに CPU を使用します。 CPUのみを使用する場合はオフにします。この設定を変更しても、AI がオンになったり、モデルがダウンロードされたりすることはありません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 번역에는 호환되는 GPU을 선호합니다. GPU 가속을 사용할 수 없거나 실패하는 경우 앱은 대신 CPU을 사용합니다. CPU만 사용하려면 이 기능을 끄세요. 이 기본 설정을 변경해도 AI가 켜지거나 모델이 다운로드되지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevorzugen Sie eine kompatible Übersetzung von GPU für KI. Wenn die GPU-Beschleunigung nicht verfügbar ist oder fehlschlägt, verwendet die App stattdessen die CPU-Beschleunigung. Schalten Sie dies aus, um nur CPU zu verwenden. Durch das Ändern dieser Einstellung wird weder KI aktiviert noch ein Modell heruntergeladen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférez une traduction GPU compatible pour IA. Si l'accélération GPU n'est pas disponible ou échoue, l'application utilise le CPU à la place. Désactivez cette option pour utiliser uniquement le CPU. La modification de cette préférence n'active pas IA et ne télécharge pas de modèle."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefiere una traducción GPU compatible para IA. Si la aceleración GPU no está disponible o falla, la aplicación utiliza CPU en su lugar. Desactívelo para usar solo CPU. Cambiar esta preferencia no activa IA ni descarga un modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefira uma tradução GPU compatível para IA. Se a aceleração GPU não estiver disponível ou falhar, o aplicativo usará o CPU. Desligue para usar apenas o CPU. Alterar esta preferência não ativa IA nem baixa um modelo."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочитайте совместимый перевод GPU для AI. Если ускорение GPU недоступно или не работает, приложение вместо этого использует CPU. Выключите это, чтобы использовать только CPU. Изменение этого предпочтения не включает AI и не загружает модель."
          }
        }
      }
    },
