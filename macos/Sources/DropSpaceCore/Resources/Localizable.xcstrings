    "WidgetsCompactHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Compact widgets are for an explicitly opened widget view. They never keep an idle island visible."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑小组件用于主动打开的小组件视图，不会让空闲灵动岛常驻。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "收合小工具適用於顯式開啟的小工具檢視。他們從不讓閒置的島嶼可見。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパクトなウィジェットは、自分でウィジェット表示を開いたときに使います。これを有効にしても、使用していないアイランドが表示されたままにはなりません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "축소 위젯은 사용자가 위젯 화면을 직접 열었을 때 사용됩니다. 위젯을 켜도 사용 중이 아닌 아일랜드를 계속 표시하지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakte Widgets sind für eine explizit geöffnete Widget-Ansicht vorgesehen. Sie sorgen nie dafür, dass eine leere Insel sichtbar bleibt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets compacts sont destinés à une vue de widget explicitement ouverte. Ils ne gardent jamais visible une île inactive."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los widgets compactos son para una vista de widget abierta explícitamente. Nunca mantienen visible una isla inactiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets compactos são para uma visualização de widget aberta explicitamente. Eles nunca mantêm uma ilha ociosa visível."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Компактные виджеты используются только в открытом вами представлении виджетов. Они не удерживают неактивный остров на экране."
          }
        }
      }
    },
