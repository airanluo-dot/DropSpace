    "LyricsFontSizeHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag or enter a size from 12 to 28. Decimals are welcome. Original lyrics and translations scale together."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动滑块或输入 12 至 28 之间的字号，支持小数。原文与译文将按固定比例一起缩放。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳或輸入 12 至 28 的大小，可以使用小數。原文與譯文會一起縮放。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグするか、12 ～ 28 のサイズを入力します。小数も使用できます。オリジナルの歌詞と翻訳は一緒にスケールされます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "12에서 28 사이의 크기를 드래그하거나 입력하세요. 소수점도 가능합니다. 원본 가사와 번역은 함께 확장됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie eine Größe zwischen 12 und 28 oder geben Sie sie ein. Dezimalstellen sind willkommen. Originaltexte und Übersetzungen passen zusammen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser ou entrez une taille de 12 à 28. Les décimales sont les bienvenues. Les paroles originales et les traductions évoluent ensemble."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre o ingrese un tamaño de 12 a 28. Los decimales son bienvenidos. Las letras originales y las traducciones se escalan juntas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste ou digite um tamanho de 12 a 28. Você pode usar casas decimais. A letra original e a tradução são redimensionadas juntas."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите или введите размер от 12 до 28. Десятичные знаки приветствуются. Оригинальные тексты песен и переводы масштабируются вместе."
          }
        }
      }
    },
    "LyricsFontSizeKeyboardHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the arrow keys for 0.1 steps, Page Up or Page Down for 1, or type a precise size in the numeric field."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "方向键每次调整 0.1，Page Up 或 Page Down 每次调整 1，也可在数字输入框中填写精确字号。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "方向鍵每次調整 0.1，Page Up 或 Page Down 每次調整 1；也可以在數字欄位輸入精確大小。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "0.1 ステップの場合は矢印キーを使用し、1 の場合は Page Up または Page Down を使用するか、数値フィールドに正確なサイズを入力します。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "0.1단계는 화살표 키를 사용하고 1은 Page Up 또는 Page Down을 사용하거나 숫자 필드에 정확한 크기를 입력합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Pfeiltasten für 0,1-Schritte, Page Up oder Page Down für 1, oder geben Sie eine genaue Größe in das numerische Feld ein."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les touches fléchées pour les pas de 0,1, Page Up ou Page Down pour 1, ou saisissez une taille précise dans le champ numérique."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice las teclas de flecha para pasos de 0,1, Page Up o Page Down para 1, o escriba un tamaño preciso en el campo numérico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as teclas de seta para passos de 0,1, Page Up ou Page Down para 1, ou digite um tamanho preciso no campo numérico."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте клавиши со стрелками для шага 0,1, Page Up или Page Down для шага 1 или введите точный размер в числовое поле."
          }
        }
      }
    },
    "LyricsFontSizeInvalid": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a number from 12 to 28. The preview keeps the last valid size."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 12 至 28 之间的数字。预览会保留上一次有效字号。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 12 到 28 之間的數字。預覽保留最後的有效尺寸。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "12 ～ 28 の数値を入力してください。プレビューでは、最後に有効なサイズが保持されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "12에서 28 사이의 숫자를 입력하세요. 미리보기에서는 마지막으로 유효한 크기를 유지합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine Zahl zwischen 12 und 28 ein. Die Vorschau behält die letzte gültige Größe."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nombre compris entre 12 et 28. L'aperçu conserve la dernière taille valide."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese un número del 12 al 28. La vista previa mantiene el último tamaño válido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um número de 12 a 28. A visualização mantém o último tamanho válido."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите число от 12 до 28. При предварительном просмотре сохраняется последний допустимый размер."
          }
        }
      }
    },
    "LyricsFontSizeRestored": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The last valid size was restored. Enter a number from 12 to 28."
          }
        },
        "zh-CN": {
