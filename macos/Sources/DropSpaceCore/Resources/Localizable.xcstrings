          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido compartido no contiene archivos ni carpetas a los que DropSpace pueda acceder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo compartilhado não contém arquivos ou pastas que o DropSpace possa acessar."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
