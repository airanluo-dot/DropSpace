    "IncomingHandoffContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} wants to add a {1} to your Temporary Space ({3} bytes):\n\n{2}\n\nNothing will be opened automatically."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 请求将一项{1}添加到你的临时空间（{3} 字节）：\n\n{2}\n\n不会自动打开内容。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 想要將{1}加入您的暫存空間（{3} 位元組）：\n\n{2}\n\n不會自動開啟任何內容。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} が一時スペースに {1} を追加しようとしています（{3} バイト）：\n\n{2}\n\n内容が自動で開かれることはありません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0}에서 {1}을(를) 임시 공간에 추가하려고 합니다({3}바이트):\n\n{2}\n\n아무것도 자동으로 열리지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} möchte {1} zu Ihrem Temporären Bereich hinzufügen ({3} Bytes):\n\n{2}\n\nEs wird nichts automatisch geöffnet."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} souhaite ajouter {1} à votre Espace temporaire ({3} octets) :\n\n{2}\n\nAucun contenu ne sera ouvert automatiquement."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} quiere añadir {1} a tu Espacio temporal ({3} bytes):\n\n{2}\n\nNo se abrirá ningún contenido automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} quer adicionar {1} ao seu Espaço temporário ({3} bytes):\n\n{2}\n\nNenhum conteúdo será aberto automaticamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} хочет добавить {1} во Временное пространство ({3} байт):\n\n{2}\n\nНичего не будет открыто автоматически."
          }
        }
      }
    },
