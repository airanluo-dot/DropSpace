    "QuickActionParametersDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a size and format to export a new image. The original stays unchanged."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择尺寸与格式后即可导出新图片，原文件不会被覆盖。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇匯出新影像的大小和格式。原來的保持不變。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい画像をエクスポートするサイズと形式を選択します。オリジナルは変更されません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "새 이미지를 내보내려면 크기와 형식을 선택하세요. 원본은 변경되지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Größe und ein Format, um ein neues Bild zu exportieren. Das Original bleibt unverändert."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une taille et un format pour exporter une nouvelle image. L'original reste inchangé."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un tamaño y formato para exportar una nueva imagen. El original permanece sin cambios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um tamanho e formato para exportar uma nova imagem. O original permanece inalterado."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите размер и формат для экспорта нового изображения. Оригинал остается неизменным."
          }
        }
      }
    },
