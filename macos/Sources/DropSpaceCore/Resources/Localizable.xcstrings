    "MusicRefreshHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect music, artwork and lyrics without restarting DropSpace. Settings and cached lyrics are kept."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接音乐、封面和歌词，无需重启 DropSpace。保留设置和已缓存的歌词。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連結音樂、藝術作品和歌詞，無需重新啟動 DropSpace。設定和快取的歌詞將被保留。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace を再起動せずに、音楽、アートワーク、歌詞を再接続します。設定とキャッシュされた歌詞は保持されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace을 다시 시작하지 않고도 음악, 작품, 가사를 다시 연결할 수 있습니다. 설정과 캐시된 가사는 유지됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie Musik, Bildmaterial und Texte erneut, ohne DropSpace neu starten zu müssen. Einstellungen und zwischengespeicherte Liedtexte bleiben erhalten."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez la musique, les illustrations et les paroles sans redémarrer DropSpace. Les paramètres et les paroles en cache sont conservés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a conectar música, ilustraciones y letras sin reiniciar DropSpace. Se mantienen la configuración y las letras en caché."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte músicas, ilustrações e letras sem reiniciar DropSpace. As configurações e as letras em cache são mantidas."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
