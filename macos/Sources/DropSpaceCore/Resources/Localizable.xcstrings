    "DlcDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage optional models, runtimes and feature components. Downloads start only when you choose them."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "统一管理额外下载的模型、运行库和功能组件。仅在你主动选择时下载。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "管理選用模型、執行時間和功能元件。僅當您選擇它們時才會開始下載。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "オプションのモデル、ランタイム、機能コンポーネントを管理します。ダウンロードは、選択した場合にのみ開始されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "선택적 모델, 런타임 및 기능 구성 요소를 관리합니다. 다운로드는 선택한 경우에만 시작됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten Sie optionale Modelle, Laufzeiten und Funktionskomponenten. Downloads beginnen erst, wenn Sie sie auswählen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez les modèles facultatifs, les environnements d’exécution et les composants de fonctionnalités. Les téléchargements ne démarrent que lorsque vous les choisissez."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Administre modelos opcionales, tiempos de ejecución y componentes de funciones. Las descargas comienzan solo cuando las eliges."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie modelos opcionais, tempos de execução e componentes de recursos. Os downloads só começam quando você os escolhe."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте дополнительными моделями, средами выполнения и компонентами функций. Загрузки начнутся только тогда, когда вы их выберете."
          }
        }
      }
    },
