    "MediaEstimatedTimeline": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated position. This player provides no reliable timeline; lyrics may be out of sync and seeking is unavailable."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "估算进度。播放器未提供可靠时间轴，歌词可能不同步，暂不支持拖动进度。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "估計位置。該玩家沒有提供可靠的時間表；歌詞可能不同步並且無法搜尋。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "推定位置。このプレーヤーは信頼できるタイムラインを提供しません。歌詞が同期していない可能性があり、シークが利用できません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 위치. 이 플레이어는 신뢰할 수 있는 타임라인을 제공하지 않습니다. 가사가 동기화되지 않아 검색을 사용할 수 없습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzte Position. Dieser Player bietet keine verlässliche Zeitleiste; Der Liedtext ist möglicherweise nicht synchron und die Suche ist nicht möglich."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Position estimée. Ce lecteur ne fournit aucune chronologie fiable ; les paroles peuvent être désynchronisées et la recherche n'est pas disponible."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Posición estimada. Este reproductor no proporciona una línea de tiempo confiable; Es posible que las letras no estén sincronizadas y la búsqueda no esté disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posição estimada. Este player não fornece um cronograma confiável; as letras podem estar fora de sincronia e a busca não está disponível."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Предполагаемая позиция. Этот проигрыватель не предоставляет достоверной временной шкалы; тексты песен могут быть не синхронизированы, и поиск недоступен."
          }
        }
      }
    },
