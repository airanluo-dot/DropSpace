    "CaptureFoldersDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Folders are not scanned recursively or copied; only external references are recorded."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹不会被递归扫描或复制；只记录外部引用。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "不會遞迴掃描或複製資料夾，僅記錄外部參照。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダーは再帰的にスキャンされたり、コピーされたりしません。外部参照のみが記録されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더는 반복적으로 검색되거나 복사되지 않습니다. 외부 참조만 기록됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner werden nicht rekursiv gescannt oder kopiert; Es werden nur externe Referenzen erfasst."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers ne sont pas analysés de manière récursive ni copiés ; seules les références externes sont enregistrées."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas no se escanean de forma recursiva ni se copian; sólo se registran referencias externas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas não são verificadas recursivamente ou copiadas; apenas referências externas são registradas."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки не сканируются рекурсивно и не копируются; записываются только внешние ссылки."
          }
        }
      }
    },
