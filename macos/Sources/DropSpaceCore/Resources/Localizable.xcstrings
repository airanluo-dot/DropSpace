            "state": "translated",
            "value": "Zeichnen Sie Dateien und Ordner auf"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer des fichiers et des dossiers"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar archivos y carpetas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave arquivos e pastas"
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись файлов и папок"
          }
        }
      }
    },
    "CaptureFilesDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorer copies are recorded as Clipboard references; original files are not moved or copied."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "资源管理器的复制操作会作为剪贴板引用记录，不会移动或复制原始文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "資源管理器副本被記錄為剪貼簿引用；原始檔案不會被移動或複製。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスプローラーでコピーした項目は、クリップボードへの参照として記録します。元のファイルを移動・複製することはありません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorer 복사본은 클립보드 참조로 기록됩니다. 원본 파일은 이동되거나 복사되지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorer-Kopien werden als Zwischenablagereferenzen aufgezeichnet; Originaldateien werden nicht verschoben oder kopiert."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies de l'Explorateur sont enregistrées en tant que références du Presse-papiers ; les fichiers originaux ne sont ni déplacés ni copiés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias del Explorador se registran como referencias del Portapapeles; Los archivos originales no se mueven ni se copian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias do Explorer são registradas como referências da área de transferência; os arquivos originais não são movidos ou copiados."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии проводника записываются как ссылки в буфер обмена; исходные файлы не перемещаются и не копируются."
          }
        }
      }
    },
