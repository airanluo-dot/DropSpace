          "stringUnit": {
            "state": "translated",
            "value": "La cola de espera de descarga expiró. Vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A espera da fila de download expirou. Por favor, tente novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание в очереди загрузки истекло. Пожалуйста, повторите попытку."
          }
        }
      }
    },
