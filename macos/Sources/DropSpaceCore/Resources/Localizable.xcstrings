    "QuickPanelHotkeyDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the existing Dynamic Island with keyboard navigation. Default: Win+Shift+Space."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "用键盘打开现有灵动岛并导航。默认：Win+Shift+Space。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用鍵盤導航開啟現有的動態島。預設值：Win+Shift+Space。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボード ナビゲーションを使用して既存の ダイナミックアイランド を開きます。デフォルト: Win+Shift+Space。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드로 탐색할 수 있는 다이내믹 아일랜드를 엽니다. 기본 단축키: Win+Shift+Space."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das vorhandene Dynamic Island mit Tastaturnavigation. Standard: Win+Shift+Space."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le Dynamic Island existant avec la navigation au clavier. Par défaut : Win+Shift+Space."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la Isla dinámica con navegación por teclado. Atajo predeterminado: Win+Shift+Space."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a Ilha dinâmica com navegação pelo teclado. Atalho padrão: Win+Shift+Space."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает существующий Динамический остров с помощью клавиатуры. По умолчанию: Win+Shift+Space."
          }
        }
      }
    },
