    "DefaultClipboardSyncModeDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selected mode applies when you pair a device. Accepting an incoming pairing does not enable automatic sending."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "主动配对设备时应用所选模式。接受其他设备发起的配对不会自动开启发送。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "主動配對裝置時套用所選模式。接受其他裝置發起的配對不會自動啟用傳送。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "自分からデバイスをペアリングすると、選択したモードが適用されます。相手からのペアリングを承認しても自動送信は有効になりません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 기기를 페어링하면 선택한 모드가 적용됩니다. 다른 기기의 페어링 요청을 수락해도 자동 전송은 켜지지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gewählte Modus gilt, wenn Sie ein Gerät koppeln. Das Annehmen einer eingehenden Kopplung aktiviert keinen automatischen Versand."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode choisi s’applique lorsque vous lancez le jumelage d’un appareil. Accepter une demande de jumelage n’active pas l’envoi automatique."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo elegido se aplica cuando inicias el emparejamiento con un dispositivo. Aceptar una solicitud de emparejamiento no activa el envío automático."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo escolhido é aplicado quando você inicia o pareamento de um dispositivo. Aceitar uma solicitação de pareamento não ativa o envio automático."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный режим применяется, когда вы инициируете сопряжение устройства. Принятие входящего запроса на сопряжение не включает автоматическую отправку."
          }
        }
      }
    },
