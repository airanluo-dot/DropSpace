    "FileTransferCanceledOutcomeUnknown": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending was canceled on this device. The other device may already have received some or all files. Check it before sending again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "已在本机取消发送。对方设备可能已收到部分或全部文件，请确认后再重新发送。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已在此裝置取消傳送。對方裝置可能已收到部分或全部檔案，請確認後再重新傳送。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで送信をキャンセルしました。相手のデバイスは、ファイルの一部またはすべてをすでに受信している可能性があります。再送信する前に確認してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 전송을 취소했습니다. 상대 기기가 이미 파일의 일부 또는 전부를 받았을 수 있습니다. 다시 보내기 전에 확인하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Senden wurde auf diesem Gerät abgebrochen. Das andere Gerät hat möglicherweise bereits einige oder alle Dateien empfangen. Prüfen Sie dies, bevor Sie erneut senden."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi a été annulé sur cet appareil. L’autre appareil a peut-être déjà reçu une partie ou la totalité des fichiers. Vérifiez avant de les renvoyer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío se ha cancelado en este dispositivo. Es posible que el otro dispositivo ya haya recibido algunos o todos los archivos. Compruébelo antes de volver a enviarlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio foi cancelado neste dispositivo. O outro dispositivo pode já ter recebido alguns ou todos os arquivos. Verifique antes de enviá-los novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка отменена на этом устройстве. Другое устройство могло уже получить часть файлов или все файлы. Проверьте это перед повторной отправкой."
          }
        }
      }
    },
    "FileTransferRejected": {
      "localizations": {
        "en-US": {
          "stringUnit": {
