    "DownloadRecoveryWarning": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Some downloads could not be restored. Check available storage and folder permissions."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "部分下载记录暂时无法恢复，请检查磁盘或目录权限。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "某些下載無法還原。檢查可用儲存和資料夾許可權。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のダウンロードを復元できませんでした。空き容量とフォルダーのアクセス権を確認してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 다운로드를 복원할 수 없습니다. 사용 가능한 저장 공간과 폴더 권한을 확인하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Downloads konnten nicht wiederhergestellt werden. Überprüfen Sie die verfügbaren Speicher- und Ordnerberechtigungen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains téléchargements n'ont pas pu être restaurés. Vérifiez les autorisations de stockage et de dossier disponibles."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas descargas no se pudieron restaurar. Verifique el almacenamiento disponible y los permisos de carpetas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns downloads não puderam ser restaurados. Verifique as permissões de armazenamento e pasta disponíveis."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые загрузки не удалось восстановить. Проверьте доступное хранилище и права доступа к папкам."
          }
        }
      }
    },
    "DownloadQueueTimedOut": {
      "localizations": {
        "en-US": {
