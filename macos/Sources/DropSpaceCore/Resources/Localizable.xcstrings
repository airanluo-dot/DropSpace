        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "「{0}」と DropSpace によって保存されているローカル コピーは削除されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "“{0}” 및 DropSpace에 보관된 로컬 복사본이 제거됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
