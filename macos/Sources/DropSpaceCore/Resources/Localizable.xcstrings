          }
        }
      }
    },
    "ShareProcessingFailed": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace could not process this share. Try again or use the top-edge drop target."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 无法处理本次分享。请重试或使用顶部拖放入口。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 無法處理此共用。再試一次或使用頂部邊緣放置目標。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace はこの共有を処理できませんでした。もう一度試すか、上端のドロップ ターゲットを使用してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 이 공유를 처리할 수 없습니다. 다시 시도하거나 위쪽 가장자리 놓기 대상을 사용하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace konnte diese Freigabe nicht verarbeiten. Versuchen Sie es erneut oder verwenden Sie das Drop-Ziel am oberen Rand."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace n'a pas pu traiter ce partage. Réessayez ou utilisez la cible de dépôt du bord supérieur."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace no pudo procesar este recurso compartido. Inténtelo de nuevo o utilice el objetivo de caída del borde superior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace não pôde processar este compartilhamento. Tente novamente ou use o destino para soltar na borda superior."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace не удалось обработать этот общий ресурс. Попробуйте еще раз или используйте цель перетаскивания верхнего края."
          }
        }
      }
    },
    "StartupRecoveryContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace could not finish starting. Some background services may still be running. Exit the app before inspecting or restoring its data directory, and check the local diagnostic log."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 未能完成启动，部分后台服务可能仍在运行。请先退出应用，再检查或恢复数据目录，并查看本地诊断日志。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 無法完成啟動。某些後臺服務可能仍在運作。在檢查或還原其資料目錄之前退出應用程式，並檢查本機診斷記錄檔。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace の起動を完了できませんでした。一部のバックグラウンド サービスがまだ実行されている可能性があります。データ ディレクトリを検査または復元する前にアプリを終了し、ローカルの診断ログを確認してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 시작을 완료할 수 없습니다. 일부 백그라운드 서비스가 아직 실행 중일 수 있습니다. 데이터 디렉터리를 검사하거나 복원하기 전에 앱을 종료하고 로컬 진단 로그를 확인하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace konnte den Start nicht abschließen. Einige Hintergrunddienste werden möglicherweise noch ausgeführt. Beenden Sie die App, bevor Sie ihr Datenverzeichnis überprüfen oder wiederherstellen, und überprüfen Sie das lokale Diagnoseprotokoll."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace n'a pas pu terminer le démarrage. Certains services d'arrière-plan peuvent encore être en cours d'exécution. Quittez l'application avant d'inspecter ou de restaurer son répertoire de données et consultez le journal de diagnostic local."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace no pudo terminar de iniciar. Es posible que algunos servicios en segundo plano aún se estén ejecutando. Salga de la aplicación antes de inspeccionar o restaurar su directorio de datos y verifique el registro de diagnóstico local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace não pôde terminar a inicialização. Alguns serviços em segundo plano ainda podem estar em execução. Saia do aplicativo antes de inspecionar ou restaurar seu diretório de dados e verifique o log de diagnóstico local."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace не удалось завершить запуск. Некоторые фоновые службы могут все еще работать. Выйдите из приложения перед проверкой или восстановлением каталога данных и проверьте локальный журнал диагностики."
          }
        }
      }
    },
