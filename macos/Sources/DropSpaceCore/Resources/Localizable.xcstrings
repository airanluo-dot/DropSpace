    "AiLyricsDownloadHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can download either model while AI is off and keep both. Only the selected model is used. Interrupted downloads resume when possible."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 AI 时也可下载模型，两个模型可同时保留，只会使用当前选中的一个。下载中断后，重试时会尽可能继续。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在 AI 關閉時下載任一模型並保留兩個模型。僅使用選定的型號。盡可能還原中斷的下載。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "AI がオフのときにどちらかのモデルをダウンロードし、両方を保持することができます。選択したモデルのみが使用されます。中断されたダウンロードは可能な場合には再開されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "AI이 꺼져 있는 동안 두 모델 중 하나를 다운로드하고 둘 다 유지할 수 있습니다. 선택한 모델만 사용됩니다. 중단된 다운로드는 가능하면 재개됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können jedes Modell herunterladen, während KI ausgeschaltet ist, und beide behalten. Es wird nur das ausgewählte Modell verwendet. Unterbrochene Downloads werden nach Möglichkeit fortgesetzt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez télécharger l'un ou l'autre modèle lorsque IA est désactivé et conserver les deux. Seul le modèle sélectionné est utilisé. Les téléchargements interrompus reprennent lorsque cela est possible."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes descargar cualquiera de los modelos mientras IA está apagado y conservar ambos. Sólo se utiliza el modelo seleccionado. Las descargas interrumpidas se reanudan cuando sea posible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode baixar qualquer modelo enquanto IA estiver desligado e manter ambos. Somente o modelo selecionado é usado. Os downloads interrompidos são retomados quando possível."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете загрузить любую модель, пока AI выключен, и сохранить обе. Используется только выбранная модель. Прерванные загрузки возобновляются, когда это возможно."
          }
        }
      }
    },
    "AiLyricsConfirmTitle": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Download a translation model?"
          }
        },
