    "DeviceServiceReady": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Device Handoff is ready. Windows Firewall status still requires the explicit receive capability check."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "设备交接已就绪。Windows 防火墙状态仍需通过明确的接收能力检查确认。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置切換已準備就緒。 Windows 防火牆狀態仍需要明確接收能力檢查。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのハンドオフの準備ができました。 Windows ファイアウォールのステータスでは、引き続き明示的な受信機能チェックが必要です。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 전달이 준비되었습니다. Windows 방화벽 상태에서는 여전히 명시적인 수신 기능 확인이 필요합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräteübergabe ist bereit. Windows Der Firewall-Status erfordert weiterhin die explizite Prüfung der Empfangsfähigkeit."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert de périphérique est prêt. Windows L'état du pare-feu nécessite toujours la vérification explicite de la capacité de réception."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia del dispositivo está lista. Windows El estado del firewall aún requiere la verificación explícita de la capacidad de recepción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência do dispositivo está pronta. Windows O status do firewall ainda requer a verificação explícita da capacidade de recebimento."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача устройства готова. Windows Статус брандмауэра по-прежнему требует явной проверки возможности приема."
          }
        }
      }
    },
