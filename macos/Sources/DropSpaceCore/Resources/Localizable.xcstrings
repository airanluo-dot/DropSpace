    "Mac.PlayerControlFailure": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The player did not complete the control request. Check its state before retrying."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "播放器未完成控制请求。请先检查其状态再重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "播放器未完成控制要求。請先檢查其狀態再重試。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "プレーヤーが操作要求を完了しませんでした。状態を確認してから再試行してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이어가 제어 요청을 완료하지 못했습니다. 상태를 확인한 후 다시 시도하세요."
          }
        },
        "de-DE": {
