    "OperationIncompleteContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The requested operation did not finish. If the problem continues, see the local diagnostic log."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请求的操作未能完成。如果问题持续存在，请查看本地诊断日志。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請求的操作未完成。如果問題仍然存在，請檢視本機診斷記錄檔。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "要求された操作は完了しませんでした。問題が解決しない場合は、ローカルの診断ログを参照してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 작업이 완료되지 않았습니다. 문제가 계속되면 로컬 진단 로그를 참조하십시오."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der angeforderte Vorgang wurde nicht abgeschlossen. Wenn das Problem weiterhin besteht, sehen Sie im lokalen Diagnoseprotokoll nach."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération demandée n'a pas abouti. Si le problème persiste, consultez le journal de diagnostic local."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación solicitada no finalizó. Si el problema continúa, consulte el registro de diagnóstico local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação solicitada não foi concluída. Se o problema persistir, consulte o log de diagnóstico local."
          }
        },
        "ru-RU": {
          "stringUnit": {
