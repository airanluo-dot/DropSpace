    "AiLyricsClearCacheConfirm": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove cached original lyrics, provider translations, and AI translations? Current inference will stop. Downloaded models and your lyric files are kept."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "删除缓存的原歌词、来源译文和 AI 译文？当前推理将停止。已下载模型和你的歌词文件会保留。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除快取的原始歌詞、提供者翻譯和 AI 翻譯？目前的推斷將停止。下載的模型和您的歌詞檔案將被保留。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされたオリジナルの歌詞、プロバイダーの翻訳、AI の翻訳を削除しますか?現在の推論は停止します。ダウンロードしたモデルと歌詞ファイルは保持されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시된 원본 가사, 제공자 번역, AI 번역을 삭제하시겠습니까? 현재 추론이 중지됩니다. 다운로드한 모델과 가사 파일은 보관됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischengespeicherte Originaltexte, Anbieterübersetzungen und KI Übersetzungen entfernen? Die aktuelle Schlussfolgerung wird beendet. Heruntergeladene Modelle und Ihre Textdateien bleiben erhalten."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les paroles originales mises en cache, les traductions du fournisseur et les traductions IA ? L'inférence actuelle s'arrêtera. Les modèles téléchargés et vos fichiers de paroles sont conservés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar letras originales almacenadas en caché, traducciones de proveedores y traducciones IA? La inferencia actual se detendrá. Los modelos descargados y sus archivos de letras se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover letras originais armazenadas em cache, traduções de provedores e traduções IA? A inferência atual será interrompida. Os modelos baixados e seus arquivos de letras são mantidos."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить кэшированные оригинальные тексты песен, переводы поставщиков и переводы AI? Текущий вывод будет остановлен. Загруженные модели и файлы с текстами песен сохраняются."
          }
        }
      }
    },
