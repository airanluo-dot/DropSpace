    "CloseBehaviorDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard recording continues when the app is hidden to the tray."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏到托盘时会继续记录剪贴板。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏至系統匣時，剪貼簿記錄仍會繼續。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがトレイに非表示になっている場合でも、クリップボードの記録は継続されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 트레이에 숨겨져 있으면 클립보드 기록이 계속됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufzeichnung der Zwischenablage wird fortgesetzt, wenn die App in der Taskleiste ausgeblendet wird."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement du Presse-papiers continue lorsque l'application est masquée dans la barre d'état."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación del portapapeles continúa cuando la aplicación está oculta en la bandeja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A registro da área de transferência continua quando o aplicativo está oculto na bandeja."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись в буфер обмена продолжается, когда приложение скрыто в трее."
          }
        }
      }
    },
