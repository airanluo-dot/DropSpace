    "LanguageDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes interface text only. Lyric translation has its own language setting."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "仅更改界面文案。歌词翻译使用独立的语言设置。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只更改介面文字。歌詞翻譯使用獨立的語言設定。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の表示文言だけを変更します。歌詞の翻訳先は別に設定できます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스 텍스트만 변경합니다. 가사 번역에는 자체 언어 설정이 있습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert nur die Texte der Benutzeroberfläche. Die Zielsprache für Liedtextübersetzungen wird separat eingestellt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie uniquement le texte de l'interface. La traduction des paroles a son propre paramètre de langue."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo el texto de la interfaz. La traducción de letras tiene su propia configuración de idioma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera apenas o texto da interface. A tradução de letras tem sua própria configuração de idioma."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
