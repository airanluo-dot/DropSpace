    "QuickActionsDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose up to three actions shown directly on each item. Automatic follows the available action registry; unavailable choices are skipped safely."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "为每项内容选择最多三个直接显示的操作。“自动”会遵循可用操作注册表；不可用的选择会被安全跳过。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "最多選擇每個專案上直接顯示的三個操作。自動遵循可用的操作登錄檔；不可用的選擇將被安全地跳過。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "各項目に直接表示されるアクションを 3 つまで選択します。自動では、利用可能なアクション レジストリに従います。使用できない選択肢は安全にスキップされます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "각 항목에 직접 표시되는 작업을 최대 3개까지 선택하세요. 자동은 사용 가능한 작업 레지스트리를 따릅니다. 사용할 수 없는 선택 항목은 안전하게 건너뜁니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie bis zu drei Aktionen aus, die direkt auf jedem Artikel angezeigt werden. Automatisch folgt der verfügbaren Aktionsregistrierung; Nicht verfügbare Auswahlmöglichkeiten werden sicher übersprungen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez jusqu'à trois actions affichées directement sur chaque élément. Automatique suit le registre d'actions disponible ; les choix indisponibles sont ignorés en toute sécurité."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija hasta tres acciones que se muestran directamente en cada elemento. Automático sigue el registro de acciones disponibles; las opciones no disponibles se omiten de forma segura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha até três ações mostradas diretamente em cada item. Automático segue o registro de ações disponíveis; as opções indisponíveis são ignoradas com segurança."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите до трех действий, отображаемых непосредственно над каждым элементом. Автоматически следует реестру доступных действий; недоступные варианты безопасно пропускаются."
          }
        }
      }
    },
