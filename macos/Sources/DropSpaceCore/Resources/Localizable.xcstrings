    "CaptureImagesDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the size and pixel limits below; images over the limits are skipped."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "大小和像素上限可在下方调整；超限图片会被跳过。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "調整下面的大小和畫素限制；超過限制的影象將被跳過。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のサイズとピクセル制限を調整します。制限を超えた画像はスキップされます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 크기와 픽셀 제한을 조정하세요. 한도를 초과하는 이미지는 건너뜁니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie unten die Größen- und Pixelgrenzen an. Bilder, die die Grenzwerte überschreiten, werden übersprungen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez les limites de taille et de pixels ci-dessous ; les images dépassant les limites sont ignorées."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste los límites de tamaño y píxeles a continuación; las imágenes que superan los límites se omiten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o tamanho e os limites de pixels abaixo; imagens acima dos limites são ignoradas."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрегулируйте размер и пределы пикселей ниже; изображения, выходящие за пределы, пропускаются."
          }
        }
      }
    },
