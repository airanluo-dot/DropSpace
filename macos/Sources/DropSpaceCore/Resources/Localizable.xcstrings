    "WindowsSharePortableStatus": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows share integration is unavailable in this version. Drag files into DropSpace instead."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本不支持 Windows 分享菜单，可拖入文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 共享整合在此版本中不可用。將檔案拖曳到 DropSpace 中。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 共有統合は、このバージョンでは利用できません。代わりに、ファイルを DropSpace にドラッグしてください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전에서는 Windows 공유 연동을 사용할 수 없습니다. 대신 파일을 DropSpace로 끌어오세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Share-Integration von Windows ist in dieser Version nicht verfügbar. Ziehen Sie stattdessen Dateien nach DropSpace."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intégration du partage Windows n'est pas disponible dans cette version. Faites plutôt glisser les fichiers vers DropSpace."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows la integración compartida no está disponible en esta versión. En su lugar, arrastre los archivos a DropSpace."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A integração de compartilhamento Windows não está disponível nesta versão. Arraste os arquivos parao DropSpace."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Интеграция с общим доступом Windows недоступна в этой версии. Вместо этого перетащите файлы в DropSpace."
          }
        }
      }
