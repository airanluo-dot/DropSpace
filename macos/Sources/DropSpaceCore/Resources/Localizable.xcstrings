    "PauseRecordingDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The paused state is retained after restart until you resume it."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停状态会在重启后保留，直到你手动恢复。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動後仍保持暫停，直到您繼續記錄。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止状態は、再起動後、再開するまで保持されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 중지된 상태는 다시 시작한 후에도 재개할 때까지 유지됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der pausierte Zustand bleibt nach dem Neustart erhalten, bis Sie ihn fortsetzen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état en pause est conservé après le redémarrage jusqu'à ce que vous le repreniez."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado de pausa se conserva después del reinicio hasta que lo reanude."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado pausado é mantido após a reinicialização até que você o retome."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние паузы сохраняется после перезапуска, пока вы его не возобновите."
          }
        }
      }
    },
