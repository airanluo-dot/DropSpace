    "LyricsCacheClearFailed": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyrics cache could not be cleared. Try again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未能清理歌词缓存，请重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法清除歌詞快取。再試一次。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞キャッシュをクリアできませんでした。もう一度やり直してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "가사 캐시를 지울 수 없습니다. 다시 시도해 보세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Songtext-Cache konnte nicht geleert werden. Versuchen Sie es erneut."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache des paroles n'a pas pu être vidé. Essayer à nouveau."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo borrar la caché de letras. Intentar otra vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível limpar o cache de letras. Tente novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось очистить кэш текстов песен. Попробуйте еще раз."
          }
        }
      }
    },
    "LyricsCacheMigrationFailed": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Some old lyrics cache files could not be removed. Clear the lyrics cache to retry. Downloaded models and your lyric files are kept."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "部分旧歌词缓存未能移除，请使用清理歌词缓存重试。已下载模型和你的歌词文件会保留。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "一些舊的歌詞快取檔案無法刪除。清除歌詞快取以重試。下載的模型和您的歌詞檔案將被保留。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の古い歌詞キャッシュ ファイルは削除できませんでした。歌詞キャッシュをクリアして再試行してください。ダウンロードしたモデルと歌詞ファイルは保持されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 오래된 가사 캐시 파일을 제거할 수 없습니다. 다시 시도하려면 가사 캐시를 삭제하세요. 다운로드한 모델과 가사 파일은 보관됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige alte Liedtext-Cache-Dateien konnten nicht entfernt werden. Leeren Sie den Liedtext-Cache, um es noch einmal zu versuchen. Heruntergeladene Modelle und Ihre Textdateien bleiben erhalten."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains anciens fichiers de cache de paroles n'ont pas pu être supprimés. Videz le cache des paroles pour réessayer. Les modèles téléchargés et vos fichiers de paroles sont conservés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos archivos de caché de letras antiguas no se pudieron eliminar. Borre el caché de letras para volver a intentarlo. Los modelos descargados y sus archivos de letras se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos de cache de letras antigas não puderam ser removidos. Limpe o cache de letras para tentar novamente. Os modelos baixados e seus arquivos de letras são mantidos."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые старые файлы кэша текстов песен удалить не удалось. Очистите кеш песен и повторите попытку. Загруженные модели и файлы с текстами песен сохраняются."
          }
        }
      }
    },
