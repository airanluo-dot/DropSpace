          }
        }
      }
    },
    "IslandForceShowOverFullscreenDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow an island with content or residence enabled to appear over fullscreen apps. When off, use the hide delay."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "允许已有内容或已开启常驻的灵动岛在全屏应用上显示。关闭后按隐藏延迟收起。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許啟用內容或住宅的島嶼出現在全螢幕應用程式上。關閉時，使用隱藏延遲。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "内容がある場合、または常時表示が有効な場合に、全画面アプリの上へアイランドを表示します。オフの場合は、設定した待ち時間で非表示にします。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠가 있거나 항상 표시가 켜진 아일랜드를 전체 화면 앱 위에 표시합니다. 끄면 숨기기까지 대기 시간을 적용합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie, dass eine Insel mit aktiviertem Inhalt oder Wohnsitz über Vollbild-Apps angezeigt wird. Wenn diese Option deaktiviert ist, verwenden Sie die Ausblendverzögerung."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez une île dont le contenu ou la résidence est activé à apparaître sur les applications en plein écran. Lorsqu'il est désactivé, utilisez le délai de masquage."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita que una isla con contenido o residencia habilitada aparezca en aplicaciones de pantalla completa. Cuando esté desactivado, utilice el retardo para ocultar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que uma ilha com conteúdo ou residência ativada apareça em aplicativos em tela cheia. Quando desligado, use o atraso de ocultação."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет острову с содержимым или включённым постоянным отображением появляться поверх полноэкранных приложений. Если выключено, применяется задержка скрытия."
          }
        }
      }
    },
