            "value": "가사를 일시적으로 사용할 수 없습니다. 다시 시도하려면 새로 고침을 선택하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Liedtexte sind vorübergehend nicht verfügbar. Wählen Sie „Aktualisieren“, um es erneut zu versuchen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paroles sont temporairement indisponibles. Sélectionnez Actualiser pour réessayer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las letras no están disponibles temporalmente. Seleccione Actualizar para intentarlo nuevamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As letras estão temporariamente indisponíveis. Selecione Atualizar para tentar novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Тексты временно недоступны. Выберите «Обновить», чтобы повторить попытку."
          }
        }
      }
    },
    "WidgetDropFailed": {
      "localizations": {
        "en-US": {
