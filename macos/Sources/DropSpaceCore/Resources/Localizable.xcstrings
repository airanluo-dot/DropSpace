    "TransferBusyContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Other transfers are still running or finishing. Try again after one completes."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "其他传输仍在进行或收尾。请等待其中一项结束后再试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "其他傳輸仍在進行或收尾。請等待其中一項結束後再試一次。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの転送がまだ進行中、または終了処理中です。いずれかが終了してから、もう一度お試しください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 전송이 아직 진행 중이거나 마무리 중입니다. 한 건이 끝난 후 다시 시도하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Übertragungen laufen noch oder werden gerade beendet. Versuchen Sie es erneut, sobald eine davon beendet ist."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres transferts sont encore en cours ou en train de se terminer. Réessayez une fois que l’un d’eux sera terminé."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otras transferencias en curso o finalizando. Vuelva a intentarlo cuando termine una de ellas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outras transferências ainda estão em andamento ou sendo finalizadas. Tente novamente quando uma delas terminar."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие передачи ещё выполняются или завершаются. Повторите попытку после завершения одной из них."
          }
        }
      }
    },
    "TransferPreparationLimitContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This selection contains too many folder entries or paths that are too long. Select fewer items or a smaller subfolder and try again."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "所选内容中的文件或文件夹过多，或路径过长。请选择更少的项目或较小的子文件夹，然后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所選內容中的檔案或資料夾過多，或路徑過長。請選取較少的項目或較小的子資料夾，然後再試一次。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した内容に含まれるフォルダー内の項目が多すぎるか、パスが長すぎます。選択する項目を減らすか、より小さいサブフォルダーを選択して、もう一度お試しください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 대상에 포함된 폴더 내 항목이 너무 많거나 경로가 너무 깁니다. 더 적은 항목이나 더 작은 하위 폴더를 선택한 후 다시 시도하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl enthält zu viele Ordnereinträge oder zu lange Pfade. Wählen Sie weniger Elemente oder einen kleineren Unterordner aus und versuchen Sie es erneut."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La sélection contient trop d’éléments dans les dossiers ou des chemins trop longs. Sélectionnez moins d’éléments ou un sous-dossier plus petit, puis réessayez."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección contiene demasiadas entradas de carpetas o rutas demasiado largas. Seleccione menos elementos o una subcarpeta más pequeña e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção contém entradas demais nas pastas ou caminhos muito longos. Selecione menos itens ou uma subpasta menor e tente novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранное содержимое включает слишком много элементов папок или слишком длинные пути. Выберите меньше элементов или подпапку меньшего размера и повторите попытку."
          }
        }
      }
    },
