    "ClearHistoryDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup keeps pinned items by default and never deletes original files referenced in Temporary Space."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "清理默认保留固定项目；不会删除临时空间中引用的原始文件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "預設情況下，清理會保留固定專案，並且絕不會刪除暫存空間中引用的原始檔案。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンアップはデフォルトでピン留めされたアイテムを保持し、一時スペース で参照されている元のファイルを削除することはありません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "정리는 기본적으로 고정된 항목을 유지하며 임시 공간에서 참조된 원본 파일을 삭제하지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereinigung behält standardmäßig angeheftete Elemente bei und löscht niemals die Originaldateien, auf die in Temporärer Bereich verwiesen wird."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage conserve les éléments épinglés par défaut et ne supprime jamais les fichiers originaux référencés dans Espace temporaire."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza mantiene los elementos fijados de forma predeterminada y nunca elimina los archivos originales a los que se hace referencia en Espacio temporal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza mantém os itens fixados por padrão e nunca exclui os arquivos originais referenciados no Espaço temporário."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа очистки по умолчанию сохраняет закрепленные элементы и никогда не удаляет исходные файлы, указанные в Временное пространство."
          }
        }
      }
    },
