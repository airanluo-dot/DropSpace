    "ShareFilesFoldersOnly": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace accepts only files and folders from Windows Share."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 只接受 Windows 分享中的文件和文件夹。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 僅接受來自 Windows 共享的檔案和資料夾。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace は、Windows 共有からのファイルとフォルダーのみを受け入れます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
