    "AiLyricsDownloadHelpSingle": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can download a model while AI is off. Interrupted downloads resume when possible."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 AI 时也可下载模型。下载中断后，重试时会尽可能继续。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在 AI 關閉時下載模型。盡可能還原中斷的下載。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "AIがオフのときにモデルをダウンロードできます。中断されたダウンロードは可能な場合には再開されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "AI이 꺼진 상태에서도 모델을 다운로드할 수 있습니다. 중단된 다운로드는 가능하면 재개됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können ein Modell herunterladen, während KI ausgeschaltet ist. Unterbrochene Downloads werden nach Möglichkeit fortgesetzt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez télécharger un modèle lorsque IA est désactivé. Les téléchargements interrompus reprennent lorsque cela est possible."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede descargar un modelo mientras IA está desactivado. Las descargas interrumpidas se reanudan cuando sea posible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode baixar um modelo enquanto IA está desligado. Os downloads interrompidos são retomados quando possível."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете загрузить модель, пока AI выключен. Прерванные загрузки возобновляются, когда это возможно."
          }
        }
      }
    },
    "AiLyricsStandardHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous Tencent Q4 model. Kept only for inspecting and removing old downloads."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版腾讯 Q4 模型，仅保留已下载文件的检查和删除功能。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "以前的騰訊 Q4 型號。僅保留用於檢查和刪除舊的下載。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "Tencent Q4 の前のモデル。古いダウンロードを検査および削除するためにのみ保存されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 Tencent Q4 모델. 오래된 다운로드를 검사하고 제거하는 용도로만 보관됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorheriges Tencent-Modell Q4. Wird nur zum Überprüfen und Entfernen alter Downloads aufbewahrt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle Tencent Q4 précédent. Conservé uniquement pour inspecter et supprimer les anciens téléchargements."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo anterior de Tencent Q4. Se conserva únicamente para inspeccionar y eliminar descargas antiguas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo Tencent anterior Q4. Mantido apenas para inspecionar e remover downloads antigos."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущая модель Tencent Q4. Сохраняется только для проверки и удаления старых загрузок."
          }
        }
      }
    },
