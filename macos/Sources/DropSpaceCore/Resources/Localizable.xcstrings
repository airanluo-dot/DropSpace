    "AiLyricsCudaDownloadBody": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "An NVIDIA GPU was detected. CUDA requires a separate runtime download of about {0} MiB. Your existing AI model will be reused. Download or remove it in DLC; until then Vulkan remains available with CPU fallback."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到 NVIDIA 显卡。CUDA 需要单独下载约 {0} MiB 的运行组件，已有 AI 模型不会重复下载。可在 DLC 页面下载或删除；暂不下载时继续使用 Vulkan，必要时回退 CPU。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "檢測到 NVIDIA GPU。 CUDA 需要大約 {0} MiB 的單獨執行時間下載。您現有的 AI 模型將會重複使用。在DLC中下載或刪除它；在此之前，Vulkan 仍然可用，並具有 CPU 後備。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA GPU が検出されました。 CUDA には、約 {0} MiB のランタイムを別途ダウンロードする必要があります。既存のAIモデルが再利用されます。 DLC でダウンロードまたは削除します。それまでは、Vulkan は CPU フォールバックで利用可能なままになります。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "NVIDIA GPU이(가) 감지되었습니다. CUDA에는 {0} MiB에 대한 별도의 런타임 다운로드가 필요합니다. 기존 AI 모델이 재사용됩니다. DLC에서 다운로드하거나 제거하세요. 그때까지는 Vulkan을 CPU 대체와 함께 사용할 수 있습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde ein NVIDIA GPU erkannt. CUDA erfordert einen separaten Laufzeit-Download von etwa {0} MiB. Ihr vorhandenes KI-Modell wird wiederverwendet. Laden Sie es herunter oder entfernen Sie es in DLC; bis dahin bleibt Vulkan mit CPU-Fallback verfügbar."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un NVIDIA GPU a été détecté. CUDA nécessite un téléchargement d'exécution distinct d'environ {0} MiB. Votre modèle IA existant sera réutilisé. Téléchargez-le ou supprimez-le dans DLC ; d'ici là, Vulkan reste disponible avec le repli CPU."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detectó un NVIDIA GPU. CUDA requiere una descarga de tiempo de ejecución independiente de aproximadamente {0} MiB. Se reutilizará su modelo IA existente. Descárgalo o elimínalo en DLC; hasta entonces, Vulkan permanece disponible con CPU respaldo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um NVIDIA GPU foi detectado. CUDA requer um download de tempo de execução separado de cerca de {0} MiB. Seu modelo IA existente será reutilizado. Baixe ou remova-o em DLC; até então Vulkan permanece disponível com CPU substituto."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружен NVIDIA GPU. Для CUDA требуется отдельная загрузка среды выполнения примерно {0} MiB. Ваша существующая модель AI будет использована повторно. Загрузите или удалите его в DLC; до тех пор Vulkan остается доступным с резервным вариантом CPU."
          }
        }
      }
    },
