    "MaxClipboardFileTotalMegabytesDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Must be at least the individual file limit; folders are not counted recursively."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "必须不小于单文件上限；文件夹不递归计入。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "必須至少為單一檔案限制；資料夾不進行遞迴計數。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも個々のファイルの制限値以上である必要があります。フォルダーは再帰的にカウントされません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "최소한 개별 파일 제한 이상이어야 합니다. 폴더는 재귀적으로 계산되지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Muss mindestens dem individuellen Dateilimit entsprechen; Ordner werden nicht rekursiv gezählt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Doit correspondre au moins à la limite de fichiers individuels ; les dossiers ne sont pas comptés de manière récursive."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Debe ser al menos el límite de archivos individuales; las carpetas no se cuentan de forma recursiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deve ser pelo menos o limite de arquivos individuais; pastas não são contadas recursivamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Должен быть не меньше индивидуального лимита файлов; папки не подсчитываются рекурсивно."
          }
        }
      }
    },
    "ClipboardPrivacyWarning.Message": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace cannot reliably identify every clipboard source and does not treat sensitive-content detection as a safety guarantee. Pause recording or clear history when needed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 无法可靠识别所有剪贴板来源，也不会把“敏感内容检测”当作安全保证。需要时请暂停记录或清除历史。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 無法可靠地識別每個剪貼簿來源，並且不將敏感內容偵測視為安全保證。需要時暫停記錄或清除歷史記錄。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace はすべてのクリップボード ソースを確実に識別することはできず、機密コンテンツの検出を安全保証として扱いません。必要に応じて録音を一時停止したり、履歴をクリアしたりできます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace는 모든 클립보드 소스를 안정적으로 식별할 수 없으며 민감한 콘텐츠 감지를 안전 보장으로 처리하지 않습니다. 필요한 경우 기록을 일시 중지하거나 기록을 지웁니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace kann nicht jede Zwischenablagequelle zuverlässig identifizieren und betrachtet die Erkennung vertraulicher Inhalte nicht als Sicherheitsgarantie. Unterbrechen Sie bei Bedarf die Aufnahme oder löschen Sie den Verlauf."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace ne peut pas identifier de manière fiable chaque source du presse-papiers et ne considère pas la détection de contenu sensible comme une garantie de sécurité. Suspendez l'enregistrement ou effacez l'historique si nécessaire."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace no puede identificar de manera confiable todas las fuentes del portapapeles y no trata la detección de contenido confidencial como una garantía de seguridad. Pause la grabación o borre el historial cuando sea necesario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace não consegue identificar com segurança todas as fontes da área de transferência e não trata a detecção de conteúdo confidencial como uma garantia de segurança. Pause a gravação ou limpe o histórico quando necessário."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace не может надежно идентифицировать каждый источник буфера обмена и не рассматривает обнаружение конфиденциального контента как гарантию безопасности. При необходимости приостановите запись или очистите историю."
          }
        }
      }
    },
