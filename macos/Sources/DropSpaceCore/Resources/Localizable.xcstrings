            "value": "La réponse de mise à jour n'a pas pu être validée."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo validar la respuesta de actualización."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta de atualização não pôde ser validada."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ на обновление не удалось проверить."
          }
        }
      }
    },
    "UpdateUntrustedAutoInstall": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Unattended installation is unavailable because the update publisher is not trusted."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "更新发布者不受信任，无法无人值守安装。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "由於更新發布者不受信任，無人值守安裝不可用。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "更新発行者が信頼されていないため、無人インストールは使用できません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 게시자를 신뢰할 수 없기 때문에 무인 설치를 사용할 수 없습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine unbeaufsichtigte Installation ist nicht verfügbar, da der Update-Herausgeber nicht vertrauenswürdig ist."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installation sans assistance n'est pas disponible car l'éditeur de mise à jour n'est pas approuvé."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación desatendida no está disponible porque no se confía en el editor de la actualización."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação autônoma não está disponível porque o editor da atualização não é confiável."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическая установка недоступна, поскольку издатель обновления не является доверенным."
          }
        }
      }
    },
