    "SmartDragExclusionsDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma-separated process names. This is best-effort: some elevated, protected, or short-lived source apps may not be identifiable."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "用逗号分隔进程名。此功能为尽力而为：部分提权、受保护或短暂存在的来源应用可能无法识别。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗號分隔的程序名稱。這是盡力而為：某些提升的、受保護的或短期的來源應用程式可能無法識別。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "カンマ区切りのプロセス名。これはベストエフォートです。一部の昇格された、保護された、または短期間のソース アプリは識別できない場合があります。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "쉼표로 구분된 프로세스 이름입니다. 이는 최선의 노력입니다. 일부 상승되거나 보호되거나 수명이 짧은 소스 앱은 식별되지 않을 수 있습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Kommas getrennte Prozessnamen. Dies ist die beste Lösung: Einige erhöhte, geschützte oder kurzlebige Quell-Apps sind möglicherweise nicht identifizierbar."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms de processus séparés par des virgules. Il s’agit de la meilleure solution : certaines applications sources élevées, protégées ou de courte durée peuvent ne pas être identifiables."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres de procesos separados por comas. Este es el mejor esfuerzo: es posible que algunas aplicaciones de origen elevadas, protegidas o de corta duración no sean identificables."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes de processos separados por vírgula. Este é o melhor esforço: alguns aplicativos de origem elevados, protegidos ou de curta duração podem não ser identificáveis."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена процессов, разделенные запятыми. Это лучшее, что можно сделать: некоторые исходные приложения с повышенными, защищенными или недолговечными исходными данными могут быть не идентифицированы."
          }
        }
      }
    },
