    "RevokeNearbyLinkContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke the link for “{0}”? Downloads already in progress may continue. Files already received will not be removed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销“{0}”的链接？已经开始的下载可能继续，已接收的文件不会被删除。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "要撤銷「{0}」的連結嗎？已開始的下載可能會繼續，已接收的檔案不會被刪除。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "「{0}」のリンクを取り消しますか？開始済みのダウンロードは続行される場合があります。受信済みのファイルは削除されません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "“{0}”의 링크를 취소할까요? 이미 진행 중인 다운로드는 계속될 수 있습니다. 이미 받은 파일은 삭제되지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Link für „{0}“ widerrufen? Bereits laufende Downloads können fortgesetzt werden. Bereits empfangene Dateien werden nicht entfernt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Révoquer le lien pour « {0} » ? Les téléchargements déjà en cours peuvent continuer. Les fichiers déjà reçus ne seront pas supprimés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Revocar el enlace de «{0}»? Las descargas que ya están en curso pueden continuar. Los archivos ya recibidos no se eliminarán."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revogar o link de “{0}”? Downloads que já estão em andamento podem continuar. Arquivos já recebidos não serão removidos."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Отозвать ссылку для «{0}»? Уже начавшиеся загрузки могут продолжиться. Уже полученные файлы не будут удалены."
          }
        }
      }
    },
