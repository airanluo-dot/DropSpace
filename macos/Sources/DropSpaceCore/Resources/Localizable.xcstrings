          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Horodatage des vers indisponible : la traduction défile à vitesse fixe."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay tiempos por verso; la traducción se desplaza a velocidad fija."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
