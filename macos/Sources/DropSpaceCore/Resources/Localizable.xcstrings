    "Mac.InternetLinkNotRetained": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The decryption link is kept only during this app session. After restarting, you can revoke the share but cannot recover its link here."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "解密链接仅保留在本次应用会话中。重启后仍可撤销分享，但无法在此恢复链接。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "解密連結僅保留於本次應用程式工作階段。重新啟動後仍可撤銷分享，但無法在此復原連結。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "復号リンクは現在のアプリセッション中のみ保持されます。再起動後も共有を取り消せますが、ここでリンクを復元することはできません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "복호화 링크는 현재 앱 세션에서만 보관됩니다. 다시 시작한 후에도 공유를 취소할 수 있지만 여기서 링크를 복구할 수는 없습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entschlüsselungslink wird nur in dieser App-Sitzung gespeichert. Nach einem Neustart können Sie die Freigabe widerrufen, den Link hier jedoch nicht wiederherstellen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien de déchiffrement est conservé uniquement pendant cette session. Après un redémarrage, vous pouvez révoquer le partage, mais pas récupérer son lien ici."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace de descifrado solo se conserva durante esta sesión. Tras reiniciar, puede revocar el enlace, pero no recuperarlo aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link de descriptografia é mantido apenas nesta sessão. Após reiniciar, você pode revogar o compartilhamento, mas não recuperar o link aqui."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка с ключом расшифровки хранится только в текущем сеансе приложения. После перезапуска можно отозвать доступ, но восстановить ссылку здесь нельзя."
          }
        }
      }
    },
    "Mac.ShareQRFailed": {
