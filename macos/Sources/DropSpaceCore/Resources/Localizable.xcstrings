    "LyricsSimplifiedGlowHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Cast soft light downward from the entire bottom edge and the lower 45° of each corner, with naturally fading ends. Turn off to surround the island."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "沿整个下边缘及两侧下圆角的45°弧段向下柔和散光，两端自然淡出。关闭后恢复全轮廓光效。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "由整個底部邊緣與各圓角下方 45° 向下投射柔和光線，兩端自然淡出。關閉此選項後，輝光會環繞整個動態島。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "下辺全体と各角の下側 45° から柔らかな光を下向きに放ち、端に向かって自然に薄めます。オフにするとアイランドの周囲全体を照らします。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "아래쪽 가장자리 전체와 각 모서리의 아래쪽 45°에서 아래로 부드러운 빛을 비추며, 끝부분은 자연스럽게 희미해집니다. 끄면 아일랜드 둘레 전체에 빛을 표시합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiches Licht fällt von der gesamten Unterkante und den unteren 45° jeder Ecke nach unten ab und läuft an den Enden sanft aus. Deaktivieren Sie diese Option, damit das Leuchten die Dynamic Island vollständig umgibt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projette une lumière douce vers le bas depuis tout le bord inférieur et les 45° inférieurs de chaque coin, avec un fondu naturel aux extrémités. Désactivez cette option pour que la lueur entoure toute la Dynamic Island."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyecta una luz suave hacia abajo desde todo el borde inferior y los 45° inferiores de cada esquina, que se desvanece de forma natural en los extremos. Desactiva esta opción para que el resplandor rodee toda la Isla dinámica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeta uma luz suave para baixo a partir de toda a borda inferior e dos 45° inferiores de cada canto, com um desvanecimento natural nas extremidades. Desative esta opção para que o brilho contorne toda a Ilha dinâmica."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягкий свет направлен вниз от всей нижней грани и нижних 45° каждого угла, плавно затухая по краям. Отключите этот параметр, чтобы свечение окружало весь Динамический остров."
          }
        }
      }
    },
