    "WindowsSharePackagedStatus": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Send to DropSpace from the Windows share menu."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "可通过 Windows 分享菜单发送到 DropSpace。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Windows 共用功能表傳送到 DropSpace。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
