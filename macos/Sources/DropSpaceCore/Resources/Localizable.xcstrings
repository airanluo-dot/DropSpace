      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Simplified Chinese or English independently of the interface language."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "独立于界面语言，选择简体中文或 English 歌词译文。"
