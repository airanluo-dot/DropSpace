    "NoPairedDevicesContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Find and pair a trusted Windows device in Settings → Devices & Sharing first."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置 → 设备与分享”中查找并配对可信 Windows 设备。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "首先在「設定」→「裝置和共用」中尋找並配對受信任的 Windows 裝置。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、[設定] → [デバイスと共有] で、信頼できる Windows デバイスを見つけてペアリングします。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 설정 → 장치 및 공유에서 신뢰할 수 있는 Windows 장치를 찾아 페어링하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen und koppeln Sie zunächst ein vertrauenswürdiges Windows-Gerät unter Einstellungen → Geräte & Freigabe."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez et associez d'abord un appareil Windows de confiance dans Paramètres → Appareils et partage."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque y vincule primero un dispositivo Windows confiable en Configuración → Dispositivos y uso compartido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre e emparelhe um dispositivo Windows confiável em Configurações → Dispositivos e compartilhamento primeiro."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала найдите и подключите доверенное устройство Windows в «Настройки» → «Устройства и общий доступ»."
          }
        }
      }
    },
