    "CrossDeviceClipboardDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync with paired devices. Enabling sync also enables device connection; disabling device connection stops sync."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "与已配对的设备同步。开启同步也会开启设备连接；关闭设备连接会停止同步。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "與已配對的裝置同步。啟用同步也會啟用裝置連線；關閉裝置連線會停止同步。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデバイスと同期します。同期を有効にするとデバイス接続も有効になり、デバイス接続を無効にすると同期が停止します。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 기기와 동기화합니다. 동기화를 켜면 기기 연결도 켜지며, 기기 연결을 끄면 동기화가 중지됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit gekoppelten Geräten synchronisieren. Das Aktivieren der Synchronisierung aktiviert auch die Geräteverbindung; das Deaktivieren der Geräteverbindung stoppt die Synchronisierung."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez avec les appareils jumelés. L’activation de la synchronisation active aussi la connexion aux appareils ; la désactivation de cette connexion arrête la synchronisation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza con los dispositivos emparejados. Al activar la sincronización también se activa la conexión entre dispositivos; al desactivar la conexión se detiene la sincronización."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize com dispositivos pareados. Ativar a sincronização também ativa a conexão entre dispositivos; desativar a conexão interrompe a sincronização."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация с сопряжёнными устройствами. Включение синхронизации также включает подключение устройств; отключение подключения останавливает синхронизацию."
          }
        }
      }
    },
