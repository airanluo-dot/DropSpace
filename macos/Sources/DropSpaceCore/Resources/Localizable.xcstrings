    "NearbyShareReady": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This Nearby link is HTTP and private-network only. It expires automatically; do not use it as an Internet-secure link."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "附近链接使用 HTTP 且仅限私有网络。链接会自动过期；请勿把它当作互联网安全链接。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此「附近」連結僅限 HTTP 和專用網路。自動失效；不要將其用作網路安全連結。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "この Nearby リンクは HTTP およびプライベート ネットワークのみです。有効期限は自動的に切れます。インターネットの安全なリンクとしては使用しないでください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Nearby 링크는 HTTP 및 개인 네트워크 전용입니다. 자동으로 만료됩니다. 인터넷 보안 링크로 사용하지 마십시오."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Nearby-Link ist nur über HTTP und ein privates Netzwerk verfügbar. Es läuft automatisch ab; Verwenden Sie es nicht als internetsicheren Link."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien à proximité est HTTP et réseau privé uniquement. Il expire automatiquement ; ne l'utilisez pas comme lien Internet sécurisé."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace cercano es HTTP y de red privada únicamente. Caduca automáticamente; no lo utilice como enlace seguro de Internet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link do Próximo é apenas HTTP e de rede privada. Expira automaticamente; não o use como um link seguro para a Internet."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка «Рядом» предназначена только для HTTP и частной сети. Срок его действия истекает автоматически; не используйте его в качестве защищенного Интернет-соединения."
          }
        }
      }
    },
    "EncryptedShareReady": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The manifest and file chunks are encrypted on this device. The decryption key is kept in the URL fragment."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "清单和文件分块已在本机加密。解密密钥保存在 URL 片段中。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "清單和檔案區塊在此裝置上加密。解密金鑰儲存在 URL 片段中。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "マニフェストとファイル チャンクはこのデバイス上で暗号化されます。復号化キーは URL フラグメントに保存されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "매니페스트와 파일 청크는 이 장치에서 암호화됩니다. 복호화 키는 URL 조각에 보관됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Manifest- und Dateiblöcke werden auf diesem Gerät verschlüsselt. Der Entschlüsselungsschlüssel wird im Fragment URL gespeichert."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le manifeste et les morceaux de fichiers sont chiffrés sur cet appareil. La clé de déchiffrement est conservée dans le fragment URL."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
