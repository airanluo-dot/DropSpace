    "MonitorDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic mode appears on the screen where a file drag occurs."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "自动模式会在文件拖拽所在屏幕出现。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自動模式會在發生檔案拖曳的螢幕上顯示。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルのドラッグが発生した画面には自動モードが表示されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 드래그가 발생한 화면에 자동 모드가 나타납니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Im automatischen Modus erscheint DropSpace auf dem Bildschirm, auf dem eine Datei gezogen wird."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode automatique apparaît sur l'écran où un glissement de fichier se produit."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo automático aparece en la pantalla donde se produce un arrastre de archivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo automático aparece na tela onde ocorre o arrastamento do arquivo."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране появляется автоматический режим, где происходит перетаскивание файла."
          }
        }
      }
    },
