    "DevicesSharingDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows-to-Windows handoff and clipboard sync are opt-in. Nearby links stay on a private network; Internet Share needs an explicitly configured HTTPS backend."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 到 Windows 的设备交接和剪贴板同步默认关闭。附近链接仅限私有网络；互联网分享需要明确配置 HTTPS 后端。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 到 Windows 切換和剪貼簿同步是可選的。附近的連結保留在專用網路上； Internet Share 需要明確設定的 HTTPS 後端。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows から Windows へのハンドオフとクリップボード同期はオプトインです。近くのリンクはプライベート ネットワーク上に残ります。インターネット共有には、明示的に構成された HTTPS バックエンドが必要です。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows-to-Windows 핸드오프 및 클립보드 동기화는 선택 사항입니다. 주변 링크는 개인 네트워크에 유지됩니다. 인터넷 공유에는 명시적으로 구성된 HTTPS 백엔드가 필요합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows-zu-Windows-Übergabe und Zwischenablagesynchronisierung sind optional. Nearby-Links bleiben in einem privaten Netzwerk; Internet Share benötigt ein explizit konfiguriertes HTTPS-Backend."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert Windows-vers-Windows et la synchronisation du presse-papiers sont facultatifs. Les liens à proximité restent sur un réseau privé ; Internet Share nécessite un backend HTTPS explicitement configuré."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia de Windows a Windows y la sincronización del portapapeles son opcionales. Los enlaces cercanos permanecen en una red privada; Internet Share necesita un backend HTTPS configurado explícitamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência Windows-para-Windows e a sincronização da área de transferência são opcionais. Os links próximos permanecem em uma rede privada; O Internet Share precisa de um back-end HTTPS explicitamente configurado."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача обслуживания Windows-к-Windows и синхронизация буфера обмена включены. Соседние ссылки остаются в частной сети; Internet Share требуется явно настроенная серверная часть HTTPS."
          }
        }
      }
    },
