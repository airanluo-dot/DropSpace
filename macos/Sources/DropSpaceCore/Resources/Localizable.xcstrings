    "NearbyLinksLifetime": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this window or keeping DropSpace in the menu bar keeps these links active. Quitting DropSpace or changing networks invalidates them."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此窗口或让 DropSpace 在菜单栏运行时，链接仍然有效。退出 DropSpace 或切换网络会使链接失效。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此視窗或讓 DropSpace 在選單列執行時，連結仍然有效。結束 DropSpace 或切換網路會使連結失效。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウを閉じても、DropSpace がメニューバーで動作している間はリンクが有効です。DropSpace を終了するかネットワークを変更すると無効になります。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창을 닫거나 DropSpace를 메뉴 막대에서 계속 실행해도 링크는 유지됩니다. DropSpace를 종료하거나 네트워크를 변경하면 링크가 무효화됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie dieses Fenster schließen oder DropSpace in der Menüleiste weiterlaufen lassen, bleiben die Links aktiv. Beim Beenden von DropSpace oder Wechseln des Netzwerks werden sie ungültig."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens restent actifs lorsque vous fermez cette fenêtre ou laissez DropSpace dans la barre des menus. Quitter DropSpace ou changer de réseau les rend invalides."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces siguen activos al cerrar esta ventana o mantener DropSpace en la barra de menús. Salir de DropSpace o cambiar de red los invalida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links continuam ativos quando você fecha esta janela ou mantém o DropSpace na barra de menus. Encerrar o DropSpace ou mudar de rede invalida os links."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки остаются активными после закрытия этого окна, пока DropSpace работает в строке меню. Выход из DropSpace или смена сети делает их недействительными."
          }
        }
      }
    },
    "NearbyLinksDisabled": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby Browser Share is off. Existing links still work until they expire or you revoke them; new sharing requests are disabled."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "附近浏览器分享已关闭，无法发起新的分享。现有链接仍会有效，直到到期或手动撤销。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "鄰近瀏覽器分享已關閉，無法開始新的分享。現有連結仍然有效，直到到期或手動撤銷。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "近隣ブラウザー共有はオフのため、新しい共有は開始できません。既存のリンクは、期限切れになるか取り消されるまで有効です。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 브라우저 공유가 꺼져 있어 새 공유를 시작할 수 없습니다. 기존 링크는 만료되거나 직접 취소할 때까지 유효합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Browserfreigabe im lokalen Netzwerk ist ausgeschaltet. Neue Freigaben können nicht gestartet werden. Vorhandene Links bleiben gültig, bis sie ablaufen oder widerrufen werden."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage à proximité par navigateur est désactivé. Aucun nouveau partage ne peut être lancé. Les liens existants restent valides jusqu’à leur expiration ou leur révocation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso compartido cercano por navegador está desactivado. No se pueden crear nuevos enlaces. Los enlaces existentes siguen siendo válidos hasta que caduquen o se revoquen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compartilhamento por proximidade via navegador está desativado. Novos compartilhamentos não podem ser iniciados. Os links existentes continuam válidos até expirarem ou serem revogados."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмен через браузер в локальной сети отключён. Новые ссылки создавать нельзя. Существующие ссылки действуют до истечения срока или отзыва."
          }
        }
      }
    },
    "NearbyLinkUnavailable": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This link is no longer active. It may have expired, been revoked, or become unavailable after a network change."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此链接已失效。它可能已到期、被撤销，或因网络变化而不可用。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此連結已失效。它可能已到期、遭撤銷，或因網路變更而無法使用。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクは無効になりました。期限切れ、取り消し、またはネットワークの変更が原因の可能性があります。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크는 더 이상 유효하지 않습니다. 만료되었거나 취소되었거나, 네트워크 변경으로 사용할 수 없게 되었을 수 있습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link ist nicht mehr aktiv. Er ist möglicherweise abgelaufen, wurde widerrufen oder ist nach einem Netzwerkwechsel nicht mehr verfügbar."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien n’est plus actif. Il a peut-être expiré, été révoqué ou cessé de fonctionner après un changement de réseau."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace ya no está activo. Puede haber caducado, haberse revocado o haber dejado de funcionar tras un cambio de red."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link não está mais ativo. Ele pode ter expirado, sido revogado ou ficado indisponível após uma mudança de rede."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка больше не действует. Её срок мог истечь, она могла быть отозвана или стать недоступной после смены сети."
          }
        }
      }
    },
