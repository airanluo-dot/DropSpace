    "NotificationAccessUnavailable": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification access is unavailable or was not granted. Enable notification access for the installed DropSpace app in Windows Settings."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "通知访问不可用或未获授权。请在 Windows 设置中为已安装的 DropSpace 开启通知访问权限。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "通知存取許可權不可用或未被授予。在 Windows 設定中啟用已安裝的 DropSpace 應用程式的通知存取許可權。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "通知へのアクセスが利用できないか、許可されませんでした。 Windows 設定で、インストールされている DropSpace アプリの通知アクセスを有効にします。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 액세스가 불가능하거나 권한이 부여되지 않았습니다. Windows 설정에서 설치된 DropSpace 앱에 대한 알림 액세스를 활성화하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Benachrichtigungszugriff ist nicht verfügbar oder wurde nicht gewährt. Aktivieren Sie den Benachrichtigungszugriff für die installierte DropSpace-App in den Windows-Einstellungen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès aux notifications n'est pas disponible ou n'a pas été accordé. Activez l'accès aux notifications pour l'application DropSpace installée dans les paramètres Windows."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a notificaciones no está disponible o no se concedió. Habilite el acceso a notificaciones para la aplicación DropSpace instalada en Windows Configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à notificação não está disponível ou não foi concedido. Habilite o acesso à notificação para o aplicativo DropSpace instalado em Windows Configurações."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к уведомлениям недоступен или не предоставлен. Включите доступ к уведомлениям для установленного приложения DropSpace в настройках Windows."
          }
        }
      }
    },
