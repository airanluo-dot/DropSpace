    "FirstRunPrivacyTitle": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what runs in the background"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "选择后台功能"
          }
        },
        "zh-TW": {
