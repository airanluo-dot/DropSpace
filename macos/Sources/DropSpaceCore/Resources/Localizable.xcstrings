    "StartWithWindowsDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose this during first setup or in Settings. Uses the current-user startup entry without administrator privileges."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "可在首次设置或此处开启，使用当前用户启动项，无需管理员权限。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在首次設定或“設定”中選擇此項。使用當前使用者啟動條目，無需管理員許可權。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のセットアップ時または設定でこれを選択します。管理者権限なしで現在のユーザーの起動エントリを使用します。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 설정하는 동안 또는 설정에서 이를 선택하세요. 관리자 권한 없이 현재 사용자 시작 항목을 사용합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie dies bei der Ersteinrichtung oder in den Einstellungen. Verwendet den Starteintrag des aktuellen Benutzers ohne Administratorrechte."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-le lors de la première configuration ou dans Paramètres. Utilise l'entrée de démarrage de l'utilisateur actuel sans privilèges d'administrateur."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija esto durante la primera configuración o en Configuración. Utiliza la entrada de inicio del usuario actual sin privilegios de administrador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha isto durante a primeira configuração ou em Configurações. Usa a entrada de inicialização do usuário atual sem privilégios de administrador."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите это во время первой настройки или в настройках. Использует запись запуска текущего пользователя без прав администратора."
          }
        }
      }
    },
