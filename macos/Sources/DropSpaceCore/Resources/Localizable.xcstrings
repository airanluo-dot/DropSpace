    },
    "NeteaseEnhancementErrorVerification": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete media control verification failed. The previous installation state has been restored. The player or enhancement component may lack some capabilities."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未能通过完整媒体控制验证，已恢复安装前状态。播放器或增强组件可能缺少部分能力。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "完整媒體控制驗證失敗。已還原之前的安裝狀態。播放器或增強元件可能缺乏某些功能。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なメディア コントロールの検証に失敗しました。以前のインストール状態が復元されました。プレーヤーまたは拡張コンポーネントには一部の機能が不足している可能性があります。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "완전한 미디어 제어 확인에 실패했습니다. 이전 설치 상태가 복원되었습니다. 플레이어 또는 향상 구성 요소에 일부 기능이 부족할 수 있습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vollständige Überprüfung der Medienkontrolle ist fehlgeschlagen. Der vorherige Installationszustand wurde wiederhergestellt. Dem Player oder der Erweiterungskomponente fehlen möglicherweise einige Funktionen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification complète du contrôle des médias a échoué. L'état d'installation précédent a été restauré. Le lecteur ou le composant d'amélioration peut manquer de certaines fonctionnalités."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en la verificación completa del control de medios. Se ha restablecido el estado de instalación anterior. Es posible que el reproductor o el componente de mejora carezcan de algunas capacidades."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na verificação completa do controle de mídia. O estado de instalação anterior foi restaurado. O player ou componente de aprimoramento pode não ter alguns recursos."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Полная проверка контроля мультимедиа не удалась. Предыдущее состояние установки восстановлено. Плееру или компоненту расширения могут не хватать некоторых возможностей."
          }
        }
      }
    },
    "NeteaseEnhancementErrorPermission": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows denied access to the player installation. Run DropSpace as administrator and retry."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 拒绝了安装目录访问。请以管理员身份运行 DropSpace 后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 拒絕存取播放器安裝。以管理員身分執行 DropSpace 並重試。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows はプレーヤーのインストールへのアクセスを拒否しました。 DropSpace を管理者として実行し、再試行してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 플레이어 설치에 대한 액세스가 거부되었습니다. DropSpace을 관리자로 실행하고 다시 시도하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows hat den Zugriff auf die Player-Installation verweigert. Führen Sie DropSpace als Administrator aus und versuchen Sie es erneut."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows a refusé l'accès à l'installation du lecteur. Exécutez DropSpace en tant qu'administrateur et réessayez."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows negó el acceso a la instalación del reproductor. Ejecute DropSpace como administrador y vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows negou acesso à instalação do player. Execute DropSpace como administrador e tente novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows запрещен доступ к установке плеера. Запустите DropSpace от имени администратора и повторите попытку."
          }
        }
      }
    },
    "NeteaseEnhancementErrorConflict": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "An existing component could not be safely replaced. Your existing installation was preserved."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "现有组件无法安全替换，已保留原有安装。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全地更換現有元件。您現有的安裝已保留。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のコンポーネントを安全に交換できませんでした。既存のインストールは保存されました。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 구성 요소를 안전하게 교체할 수 없습니다. 기존 설치가 보존되었습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vorhandene Komponente konnte nicht sicher ersetzt werden. Ihre bestehende Installation wurde beibehalten."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un composant existant n'a pas pu être remplacé en toute sécurité. Votre installation existante a été préservée."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un componente existente no se pudo reemplazar de manera segura. Se conservó su instalación existente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um componente existente não pôde ser substituído com segurança. Sua instalação existente foi preservada."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующий компонент невозможно безопасно заменить. Существующая установка была сохранена."
          }
        }
      }
    },
    "NeteaseEnhancementErrorIntegrity": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Component integrity verification failed. Nothing from this download was installed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "增强组件完整性验证失败，本次下载未安装。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "元件完整性驗證失敗。此下載中的任何內容均未安裝。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "コンポーネントの整合性の検証に失敗しました。このダウンロードからは何もインストールされませんでした。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "구성요소 무결성 확인에 실패했습니다. 이 다운로드에서는 아무것도 설치되지 않았습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Überprüfung der Komponentenintegrität ist fehlgeschlagen. Von diesem Download wurde nichts installiert."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de l'intégrité des composants a échoué. Rien de ce téléchargement n'a été installé."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en la verificación de la integridad del componente. No se instaló nada de esta descarga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação da integridade do componente falhou. Nada deste download foi instalado."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка целостности компонента не удалась. Ничего из этой загрузки не установилось."
          }
        }
      }
    },
    "NeteaseEnhancementErrorNetwork": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The official component source could not be reached. Please retry later."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法访问官方组件来源，请稍后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取官方元件來源。請稍後重試。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "公式コンポーネントのソースにアクセスできませんでした。後で再試行してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "공식 구성 요소 소스에 연결할 수 없습니다. 나중에 다시 시도해 주세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die offizielle Komponentenquelle konnte nicht erreicht werden. Bitte versuchen Sie es später noch einmal."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La source officielle du composant n'a pas pu être contactée. Veuillez réessayer plus tard."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo localizar la fuente oficial del componente. Vuelva a intentarlo más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte oficial do componente não pôde ser encontrada. Tente novamente mais tarde."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Официальный источник компонента недоступен. Пожалуйста, повторите попытку позже."
          }
        }
      }
    },
    "NeteaseEnhancementErrorRuntime": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A required runtime component is unavailable. The enhancement was not installed."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "必要运行组件不可用，尚未安装增强。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "所需的執行時元件不可用。未安裝增強功能。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なランタイム コンポーネントが利用できません。拡張機能はインストールされていませんでした。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "필수 런타임 구성요소를 사용할 수 없습니다. 향상된 기능이 설치되지 않았습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erforderliche Laufzeitkomponente ist nicht verfügbar. Die Erweiterung wurde nicht installiert."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un composant d'exécution requis n'est pas disponible. L'amélioration n'a pas été installée."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un componente de tiempo de ejecución requerido no está disponible. La mejora no se instaló."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um componente de tempo de execução necessário não está disponível. O aprimoramento não foi instalado."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Необходимый компонент среды выполнения недоступен. Расширение не установлено."
          }
        }
      }
    },
    "NeteaseEnhancementErrorRollback": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic recovery could not finish. Use Reinstall or Remove enhancement to recover."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "自动恢复未能完成，请使用重新安装或移除增强恢复。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自動還原無法完成。使用重新安裝或刪除增強功能進行復原。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "自動回復を完了できませんでした。回復するには、再インストールまたは削除の拡張機能を使用します。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 복구를 완료할 수 없습니다. 복구하려면 향상된 기능 다시 설치 또는 제거를 사용하십시오."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Wiederherstellung konnte nicht abgeschlossen werden. Verwenden Sie zur Wiederherstellung die Erweiterung „Neu installieren“ oder „Entfernen“."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération automatique n'a pas pu se terminer. Utilisez l’amélioration Réinstaller ou Supprimer pour récupérer."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación automática no pudo finalizar. Utilice Reinstalar o Quitar mejora para recuperar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação automática não pôde ser concluída. Use Reinstalar ou Remover aprimoramento para recuperar."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическое восстановление не удалось завершить. Используйте улучшение «Переустановить или удалить» для восстановления."
          }
        }
      }
    },
    "NeteaseEnhancementErrorCanceled": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation was canceled."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已取消。"
          }
        },
        "zh-TW": {
