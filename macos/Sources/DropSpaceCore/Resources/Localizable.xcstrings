    "OverlayPlacementPersistenceWarning.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This display has a runtime-only identity. Custom placement is unavailable until a persistent display identity is available."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "此显示器当前使用运行时身份标识。获得持久显示器身份前，无法使用自定义位置。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此顯示具有僅執行時標識。在持久顯示標識可用之前，自訂放置不可用。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "この表示には実行時のみの ID があります。永続的な表示 ID が使用可能になるまで、カスタム配置は使用できません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스플레이에는 런타임 전용 ID가 있습니다. 영구 디스플레이 ID를 사용할 수 있을 때까지 사용자 정의 배치를 사용할 수 없습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anzeige hat eine reine Laufzeitidentität. Die benutzerdefinierte Platzierung ist erst verfügbar, wenn eine dauerhafte Anzeigeidentität verfügbar ist."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet affichage a une identité d’exécution uniquement. L'emplacement personnalisé n'est pas disponible tant qu'une identité d'affichage persistante n'est pas disponible."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla tiene una identidad de solo tiempo de ejecución. La ubicación personalizada no está disponible hasta que esté disponible una identidad de visualización persistente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta exibição possui uma identidade somente de tempo de execução. O posicionamento personalizado fica indisponível até que uma identidade de exibição persistente esteja disponível."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот дисплей имеет идентификатор только во время выполнения. Пользовательское размещение недоступно, пока не будет доступен постоянный идентификатор отображения."
          }
        }
      }
    },
