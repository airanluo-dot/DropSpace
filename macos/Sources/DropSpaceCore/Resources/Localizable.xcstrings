    "WidgetNoRoom": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not enough empty space. Resize or remove another widget first."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "没有足够的空白位置。请先缩小或移除其他组件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有足夠的空白空間。首先調整大小或刪除另一個小工具。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "十分な空きスペースがありません。まず別のウィジェットのサイズを変更するか削除してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 공간이 부족합니다. 먼저 다른 위젯의 크기를 조정하거나 제거하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht genügend Leerraum vorhanden. Ändern Sie zuerst die Größe oder entfernen Sie ein anderes Widget."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas assez d'espace vide. Redimensionnez ou supprimez d'abord un autre widget."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio vacío. Cambie el tamaño o elimine otro widget primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço vazio suficiente. Redimensione ou remova outro widget primeiro."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно пустого места. Сначала измените размер или удалите другой виджет."
          }
        }
      }
    },
