    "ShareNoAccessibleItems": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared content contains no files or folders that DropSpace can access."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "分享内容中没有 DropSpace 可以访问的文件或文件夹。"
          }
        },
        "zh-TW": {
          "stringUnit": {
