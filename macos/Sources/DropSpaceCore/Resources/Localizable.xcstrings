    "WidgetsEditorHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to a highlighted slot; same-size widgets can swap. Select a widget and use arrows to nudge it, or edit position and size then Apply layout. Undo restores your last change."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动组件到亮框落点；同尺寸组件可交换。也可选中后用方向按钮微调，修改位置和尺寸后点“应用位置与尺寸”。不满意可撤销上一步。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳到突出顯示的插槽；相同大小的小工具可以交換。選擇一個小工具並使用箭頭輕移它，或編輯位置和大小，然後套用佈局。復原可還原您上次的變更。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライト表示されたスロットにドラッグします。同じサイズのウィジェットは交換できます。ウィジェットを選択し、矢印を使用して微調整するか、位置とサイズを編集してレイアウトを適用します。元に戻すと、最後の変更が復元されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "강조 표시된 슬롯으로 드래그하세요. 동일한 크기의 위젯은 교체될 수 있습니다. 위젯을 선택하고 화살표를 사용하여 조금씩 움직이거나 위치와 크기를 편집한 다음 레이아웃을 적용하세요. 실행 취소는 마지막 변경 사항을 복원합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie es in einen hervorgehobenen Steckplatz. Widgets gleicher Größe können ausgetauscht werden. Wählen Sie ein Widget aus und verwenden Sie die Pfeile, um es zu verschieben, oder bearbeiten Sie Position und Größe und wenden Sie dann das Layout an. Mit „Rückgängig“ wird Ihre letzte Änderung wiederhergestellt."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser vers un emplacement en surbrillance ; les widgets de même taille peuvent être échangés. Sélectionnez un widget et utilisez les flèches pour le déplacer, ou modifiez la position et la taille, puis appliquez la mise en page. Annuler restaure votre dernière modification."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre a una ranura resaltada; Los widgets del mismo tamaño se pueden intercambiar. Seleccione un widget y use flechas para empujarlo, o edite la posición y el tamaño y luego aplique el diseño. Deshacer restaura su último cambio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para um slot destacado; widgets do mesmo tamanho podem ser trocados. Selecione um widget e use as setas para movê-lo ou edite a posição e o tamanho e depois Aplicar layout. Desfazer restaura sua última alteração."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите в выделенный слот; Виджеты одинакового размера могут меняться местами. Выберите виджет и перемещайте его с помощью стрелок или отредактируйте положение и размер, а затем примените макет. Отменить восстанавливает ваше последнее изменение."
          }
        }
      }
    },
    "WidgetsExpandedMode": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanded · 4 rows × 8 columns"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "展开 · 4 行 × 8 列"
