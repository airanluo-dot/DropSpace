    "ClearNothingContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no unpinned items to clear in the selected time range."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "所选时间范围内没有可清理的未固定项目。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在所選時間範圍內沒有要清除的未固定專案。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した期間には、消去できるピン留めされていない項目がありません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기간에는 삭제할 고정 해제된 항목이 없습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Im ausgewählten Zeitraum sind keine nicht angehefteten Elemente zum Löschen vorhanden."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a aucun élément non épinglé à supprimer dans la plage horaire sélectionnée."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay elementos sin fijar para borrar en el intervalo de tiempo seleccionado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há itens não fixados para limpar no período selecionado."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "В выбранном временном диапазоне нет незакрепленных элементов, которые можно было бы удалить."
          }
        }
      }
    },
