    "ClipboardListenerRegistrationFailed": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The system clipboard listener could not be registered. See the diagnostic log."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "系统剪贴板监听注册失败；请查看诊断日志。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法註冊系統剪貼簿偵聽器。請參閱診斷記錄檔。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "システム クリップボード リスナーを登録できませんでした。診断ログを参照してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 클립보드 리스너를 등록할 수 없습니다. 진단 로그를 참조하십시오."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der System-Zwischenablage-Listener konnte nicht registriert werden. Sehen Sie sich das Diagnoseprotokoll an."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écouteur du presse-papiers du système n'a pas pu être enregistré. Voir le journal de diagnostic."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo registrar el detector del portapapeles del sistema. Consulte el registro de diagnóstico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ouvinte da área de transferência do sistema não pôde ser registrado. Consulte o log de diagnóstico."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зарегистрировать прослушиватель системного буфера обмена. Смотрите журнал диагностики."
          }
        }
      }
    },
