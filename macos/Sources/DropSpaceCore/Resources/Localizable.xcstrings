    "AiLyricsDeleteConfirm": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete {0} and its partial download? If this model is enabled, AI translation will be turned off. Other models and original lyrics are kept."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "删除{0}及未完成的下载？如果它正在启用，将关闭 AI 翻译。其他模型和原歌词会保留。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 {0} 及其部分下載？如果啟用此模型，AI 翻譯將會關閉。其他模型和原始歌詞均保留。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} とその部分ダウンロードを削除しますか?このモデルが有効な場合、AI 変換はオフになります。他のモデルとオリジナルの歌詞は保持されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 및 부분 다운로드를 삭제하시겠습니까? 이 모델이 활성화되면 AI 번역이 꺼집니다. 다른 모델과 원 가사는 그대로 유지됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} und seinen teilweisen Download löschen? Wenn dieses Modell aktiviert ist, wird die KI-Übersetzung deaktiviert. Andere Modelle und Originaltexte bleiben erhalten."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer {0} et son téléchargement partiel ? Si ce modèle est activé, la traduction IA sera désactivée. Les autres modèles et paroles originales sont conservés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar {0} y su descarga parcial? Si este modelo está habilitado, la traducción IA se desactivará. Se mantienen otros modelos y letras originales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir {0} e seu download parcial? Se este modelo estiver habilitado, a tradução IA será desativada. Outros modelos e letras originais são mantidos."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить {0} и его частичную загрузку? Если эта модель включена, перевод AI будет отключен. Другие модели и оригинальные тексты песен сохранены."
          }
        }
      }
    },
