    "DownloadConnectionsHint": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared by files, models and components. Connections increase as the transfer makes progress. Small files and servers without safe range support use fewer connections."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "所有文件、模型和组件共享此连接上限。连接会随实际下载进展逐渐增加，小文件或不支持安全分段的服务器使用较少连接。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案、模型與元件共用此設定。連線數會隨傳輸進度增加。小型檔案與不支援安全分段請求的伺服器會使用較少連線。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル、モデル、コンポーネントで共通の設定です。転送の進行に合わせて接続数を増やします。小さなファイルや安全な範囲リクエストに対応しないサーバーでは、接続数を抑えます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "파일, 모델, 구성 요소에 공통으로 적용됩니다. 전송이 진행됨에 따라 연결 수가 늘어납니다. 작은 파일이나 안전한 범위 요청을 지원하지 않는 서버에서는 더 적은 연결을 사용합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Dateien, Modellen und Komponenten geteilt. Mit fortschreitender Übertragung nehmen die Verbindungen zu. Kleine Dateien und Server ohne Unterstützung für sichere Bereiche benötigen weniger Verbindungen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagé par fichiers, modèles et composants. Les connexions augmentent à mesure que le transfert progresse. Les petits fichiers et serveurs sans prise en charge de la plage sécurisée utilisent moins de connexions."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartido por archivos, modelos y componentes. Las conexiones aumentan a medida que avanza la transferencia. Los archivos pequeños y los servidores sin soporte de rango seguro utilizan menos conexiones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhado por arquivos, modelos e componentes. As conexões aumentam à medida que a transferência avança. Arquivos pequenos e servidores sem suporte de intervalo seguro usam menos conexões."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Совместно используются файлы, модели и компоненты. Количество соединений увеличивается по мере продвижения передачи. Небольшие файлы и серверы без поддержки безопасного диапазона используют меньше соединений."
          }
        }
      }
    },
