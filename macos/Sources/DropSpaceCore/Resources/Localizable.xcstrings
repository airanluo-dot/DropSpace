{
  "sourceLanguage": "en-US",
  "strings": {
    "AppDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A local temporary workspace for files and clipboard history."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "用于文件和剪贴板历史记录的本地临时工作区。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在本機暫存檔案與剪貼簿記錄的工作空間。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルとクリップボード履歴用のローカル一時ワークスペース。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 및 클립보드 기록을 위한 로컬 임시 작업 공간입니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein lokaler temporärer Arbeitsbereich für Dateien und den Verlauf der Zwischenablage."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace de travail temporaire local pour les fichiers et l'historique du presse-papiers."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio de trabajo temporal local para archivos y el historial del portapapeles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um espaço de trabalho temporário local para arquivos e histórico da área de transferência."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальное временное рабочее пространство для файлов и истории буфера обмена."
          }
        }
      }
    },
