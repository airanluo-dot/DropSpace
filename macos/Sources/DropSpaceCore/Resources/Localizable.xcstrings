    "DlcCudaPurpose": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline AI lyrics acceleration on compatible NVIDIA GPUs; reuses installed models."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "在兼容的 NVIDIA 显卡上加速离线 AI 歌词翻译，复用已安装模型。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在相容的 NVIDIA GPU 上離線 AI 歌詞加速；重複使用已安裝的模型。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "互換性のある NVIDIA GPU でのオフライン AI 歌詞の高速化。インストールされたモデルを再利用します。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "호환되는 NVIDIA GPU에서 오프라인 AI 가사 가속; 설치된 모델을 재사용합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-KI Liedtextbeschleunigung auf kompatiblen NVIDIA GPUs; Verwendet installierte Modelle wieder."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Accélération des paroles IA hors ligne sur les GPU NVIDIA compatibles ; réutilise les modèles installés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceleración de letras IA sin conexión en GPU NVIDIA compatibles; reutiliza los modelos instalados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceleração de letras offline IA em GPUs NVIDIA compatíveis; reutiliza modelos instalados."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Ускорение локального перевода песен с ИИ на совместимых GPU NVIDIA; используются уже установленные модели."
          }
        }
      }
    },
