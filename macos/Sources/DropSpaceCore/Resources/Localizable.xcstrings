    "NeteaseEnhancementDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable complete media controls, playback progress and related features in DropSpace."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "让网易云完整支持 DropSpace 的媒体控制、播放进度和相关功能。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在 DropSpace 中啟用完整的媒體控制、播放進度和相關功能。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace で完全なメディア コントロール、再生の進行状況、および関連機能を有効にします。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace에서 완전한 미디어 제어, 재생 진행 및 관련 기능을 활성화합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie vollständige Mediensteuerung, Wiedergabefortschritt und zugehörige Funktionen in DropSpace."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les commandes multimédias complètes, la progression de la lecture et les fonctionnalités associées dans DropSpace."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite controles multimedia completos, progreso de reproducción y funciones relacionadas en DropSpace."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite controles completos de mídia, progresso da reprodução e recursos relacionados em DropSpace."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите полное управление мультимедиа, ходом воспроизведения и сопутствующими функциями в DropSpace."
          }
        }
      }
    },
