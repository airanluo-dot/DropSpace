    "ClipboardEventDropped": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard activity was too frequent; one event was skipped."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板活动过于频繁，已跳过一个事件。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿活動過於頻繁；跳過了一項活動。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードのアクティビティが頻繁すぎました。 1 つのイベントがスキップされました。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드 활동이 너무 빈번했습니다. 이벤트 하나를 건너뛰었습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
