    "LyricsGlowDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "AI lyrics glows when an AI translation is shown. Music glows during playback, even with AI off. Turning AI on selects AI lyrics; turning it off selects Off. You can change this here."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“AI 歌词”在显示 AI 译文时发光；“音乐”在播放音乐时发光，关闭 AI 也可使用。启用 AI 会选择“AI 歌词”，关闭 AI 会选择“关闭”。你可以在这里手动更改。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 AI 譯文時，「AI 歌詞」模式會發出輝光。「音樂」模式會在播放時發出輝光，即使 AI 已關閉。啟用 AI 時會選擇「AI 歌詞」；停用 AI 時會選擇「關閉」。您可以在這裡調整。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "「AI 歌詞」では AI の訳文が表示されるときにグローが点灯します。「音楽」では AI がオフでも再生中に点灯します。AI をオンにすると「AI 歌詞」、オフにすると「オフ」が選択されます。ここで変更できます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 가사 모드는 AI 번역이 표시될 때 광채를 켭니다. 음악 모드는 AI가 꺼져 있어도 재생 중에 광채를 켭니다. AI를 켜면 AI 가사가 선택되고, 끄면 끄기가 선택됩니다. 여기에서 변경할 수 있습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "„KI-Liedtexte“ aktiviert das Leuchten, wenn eine KI-Übersetzung angezeigt wird. „Musik“ aktiviert es während der Wiedergabe, auch bei ausgeschalteter KI. Beim Einschalten der KI wird „KI-Liedtexte“ ausgewählt, beim Ausschalten „Aus“. Sie können dies hier ändern."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "« Paroles par IA » active la lueur lorsqu’une traduction par IA est affichée. « Musique » l’active pendant la lecture, même si l’IA est désactivée. Activer l’IA sélectionne « Paroles par IA » ; la désactiver sélectionne « Désactivé ». Vous pouvez modifier ce choix ici."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "«Letras con IA» activa el resplandor al mostrar una traducción de IA. «Música» lo activa durante la reproducción, incluso con la IA desactivada. Activar la IA selecciona «Letras con IA»; desactivarla selecciona «Desactivado». Puedes cambiarlo aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Letras por IA” ativa o brilho quando uma tradução por IA é exibida. “Música” ativa o brilho durante a reprodução, mesmo com a IA desativada. Ativar a IA seleciona “Letras por IA”; desativá-la seleciona “Desativado”. Você pode alterar essa opção aqui."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим «Текст песни с ИИ» включает свечение при отображении перевода ИИ. Режим «Музыка» включает его во время воспроизведения, даже если ИИ отключён. При включении ИИ выбирается «Текст песни с ИИ», при отключении — «Выкл.». Здесь можно изменить этот выбор."
          }
        }
      }
    },
    "LyricsGlowKeyboardHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the arrow keys to choose Off, AI lyrics, or Music. Home selects Off; End selects Music."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方向键选择关闭、AI 歌词或音乐。Home 键选择关闭，End 键选择音乐。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方向鍵選擇「關閉」、「AI 歌詞」或「音樂」。Home 選擇「關閉」；End 選擇「音樂」。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印キーで「オフ」「AI 歌詞」「音楽」を選択します。Home は「オフ」、End は「音楽」を選択します。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표 키로 끄기, AI 가사, 음악을 선택하세요. Home 키는 끄기, End 키는 음악을 선택합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie mit den Pfeiltasten „Aus“, „KI-Liedtexte“ oder „Musik“. Home wählt „Aus“, End wählt „Musik“."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les flèches pour choisir « Désactivé », « Paroles par IA » ou « Musique ». Home sélectionne « Désactivé » ; End sélectionne « Musique »."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las flechas para elegir «Desactivado», «Letras con IA» o «Música». Home selecciona «Desactivado» y End selecciona «Música»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as setas para escolher Desativado, Letras por IA ou Música. Home seleciona Desativado; End seleciona Música."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите стрелками «Выкл.», «Текст песни с ИИ» или «Музыка». Home выбирает «Выкл.», End — «Музыка»."
          }
        }
      }
    },
