    "RevokeShareContent": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This invalidates the link and removes its encrypted objects from the configured backend. Continue?"
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "这会使链接失效，并从已配置的后端删除其加密对象。继续吗？"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這會使連結無效並從設定的後端刪除其加密物件。繼續？"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、リンクが無効になり、その暗号化されたオブジェクトが構成されたバックエンドから削除されます。続く？"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 링크가 무효화되고 구성된 백엔드에서 암호화된 개체가 제거됩니다. 계속하다?"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Link ungültig und seine verschlüsselten Objekte aus dem konfigurierten Backend entfernt. Weitermachen?"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela invalide le lien et supprime ses objets chiffrés du backend configuré. Continuer?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto invalida el enlace y elimina sus objetos cifrados del backend configurado. ¿Continuar?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso invalida o link e remove seus objetos criptografados do back-end configurado. Continuar?"
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Это делает ссылку недействительной и удаляет ее зашифрованные объекты из настроенной серверной части. Продолжать?"
          }
        }
      }
    },
