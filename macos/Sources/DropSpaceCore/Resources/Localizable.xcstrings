          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O player não concluiu a solicitação. Verifique o estado antes de tentar novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Плеер не выполнил запрос управления. Проверьте его состояние перед повторной попыткой."
          }
        }
      }
    },
    "Mac.MediaApplicationsHelp": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Only players with an available native adapter can supply music information. Selecting an application does not grant system permissions or add missing player capabilities."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "只有具有可用原生适配的播放器才能提供音乐信息。勾选应用不会授予系统权限，也不会补上播放器尚不支持的能力。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只有具備可用原生介接的播放器才能提供音樂資訊。勾選 App 不會授予系統權限，也不會補上播放器尚未支援的功能。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能なネイティブ連携があるプレーヤーのみ音楽情報を提供できます。アプリを選択しても、システム権限は付与されず、未対応の機能は追加されません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 네이티브 연동이 있는 플레이어만 음악 정보를 제공할 수 있습니다. 앱을 선택해도 시스템 권한이 부여되거나 지원하지 않는 기능이 추가되지는 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Player mit verfügbarer nativer Anbindung können Musikinformationen liefern. Die Auswahl einer App erteilt keine Systemberechtigungen und ergänzt keine fehlenden Playerfunktionen."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les lecteurs disposant d’une intégration native disponible peuvent fournir les informations musicales. Sélectionner une application n’accorde aucune autorisation système et n’ajoute pas de fonctions manquantes."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los reproductores con una integración nativa disponible pueden proporcionar información musical. Seleccionar una aplicación no concede permisos del sistema ni añade funciones que falten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente players com integração nativa disponível podem fornecer informações musicais. Selecionar um aplicativo não concede permissões do sistema nem adiciona funções ausentes."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведения о музыке доступны только от плееров с поддерживаемой нативной интеграцией. Выбор приложения не предоставляет системных разрешений и не добавляет недостающих функций плеера."
          }
        }
      }
    }
  },
  "version": "1.0"
}
