    "DownloadError": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Operation failed. Check the URL, folder access and disk space, then retry."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失败，请检查下载地址、目录权限和磁盘空间后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失敗。檢查 URL、資料夾存取許可權和磁碟空間，然後重試。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "操作が失敗しました。 URL、フォルダアクセス、ディスク容量を確認し、再実行してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 실패했습니다. URL, 폴더 액세스 및 디스크 공간을 확인한 후 다시 시도하십시오."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang ist fehlgeschlagen. Überprüfen Sie URL, den Ordnerzugriff und den Speicherplatz und versuchen Sie es dann erneut."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération a échoué. Vérifiez le URL, l'accès au dossier et l'espace disque, puis réessayez."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación falló. Verifique URL, acceso a la carpeta y espacio en disco, luego vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação falhou. Verifique o URL, o acesso à pasta e o espaço em disco e tente novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция не удалась. Проверьте URL, доступ к папке и место на диске, затем повторите попытку."
          }
        }
      }
    },
