    "SettingsRecoveryFailed": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous settings could not be fully restored. Restart DropSpace before changing settings again. Diagnostic ID: {1}."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完整恢复原设置。请重启 DropSpace 后再修改设置。诊断编号：{1}。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完全還原先前的設定。再次更改設定之前，請重新啟動 DropSpace。診斷 ID：{1}。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の設定を完全に復元できませんでした。再度設定を変更する前にDropSpaceを再起動してください。診断 ID: {1}。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 설정을 완전히 복원할 수 없습니다. 설정을 다시 변경하기 전에 DropSpace을 다시 시작하십시오. 진단 ID: {1}."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorherige Einstellungen konnten nicht vollständig wiederhergestellt werden. Starten Sie DropSpace neu, bevor Sie die Einstellungen erneut ändern. Diagnose-ID: {1}."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres précédents n'ont pas pu être entièrement restaurés. Redémarrez DropSpace avant de modifier à nouveau les paramètres. ID de diagnostic : {1}."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración anterior no se pudo restaurar por completo. Reinicie DropSpace antes de volver a cambiar la configuración. ID de diagnóstico: {1}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações anteriores não puderam ser totalmente restauradas. Reinicie DropSpace antes de alterar as configurações novamente. ID de diagnóstico: {1}."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущие настройки не удалось полностью восстановить. Перезапустите DropSpace перед повторным изменением настроек. Идентификатор диагностики: {1}."
          }
        }
      }
    },
