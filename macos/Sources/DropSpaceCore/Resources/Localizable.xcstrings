      }
    },
    "AutoDownloadUpdatesDescription.Text": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads only to DropSpace’s own cache and installs only after size and SHA-256 verification."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "仅下载到 DropSpace 自有缓存，完成大小与 SHA-256 验证后才可安装。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅下載到 DropSpace 自己的快取，並且僅在大小和 SHA-256 驗證後安裝。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace 自体のキャッシュにのみダウンロードされ、サイズと SHA-256 の検証後にのみインストールされます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "DropSpace의 자체 캐시에만 다운로드하고 크기 및 SHA-256 확인 후에만 설치합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt nur in den eigenen Cache von DropSpace herunter und installiert erst nach Größen- und SHA-256-Überprüfung."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge uniquement dans le cache de DropSpace et s'installe uniquement après vérification de la taille et de SHA-256."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descarga solo en la propia caché de DropSpace y se instala solo después de la verificación del tamaño y SHA-256."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz download apenas para o próprio cache do DropSpace e instala somente após verificação de tamanho e SHA-256."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает только в собственный кэш DropSpace и устанавливает только после проверки размера и SHA-256."
          }
        }
      }
    },
