    "AiLyricsResourcesUnavailable": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Local translation could not confirm enough available memory. Free memory or choose the smaller model, then retry."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无法确认有足够的可用内存进行本地翻译。请释放内存或选择较小模型后重试。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本機翻譯無法確認足夠的可用記憶體。釋放記憶體或選擇較小的型號，然後重試。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル翻訳では、十分な使用可能なメモリを確認できませんでした。メモリを解放するか、より小さいモデルを選択して、再試行してください。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 번역에서 사용 가능한 메모리가 충분한지 확인할 수 없습니다. 메모리를 확보하거나 더 작은 모델을 선택한 후 다시 시도하세요."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Übersetzung konnte nicht bestätigen, dass genügend Speicher verfügbar ist. Geben Sie Speicher frei oder wählen Sie das kleinere Modell und versuchen Sie es erneut."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction locale n'a pas pu confirmer qu'il y avait suffisamment de mémoire disponible. Libérez de la mémoire ou choisissez le modèle le plus petit, puis réessayez."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción local no pudo confirmar suficiente memoria disponible. Libere memoria o elija el modelo más pequeño y luego vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução local não pôde confirmar memória disponível suficiente. Libere memória ou escolha o modelo menor e tente novamente."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный перевод не смог подтвердить наличие достаточного количества доступной памяти. Освободите память или выберите меньшую модель и повторите попытку."
          }
        }
      }
    },
