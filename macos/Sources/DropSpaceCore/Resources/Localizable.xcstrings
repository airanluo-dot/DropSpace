    "DlcVisualCppInstallNotice": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The runtime will be downloaded from Microsoft and installed. Windows may request administrator permission."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "将从微软下载并安装运行库，Windows 可能请求管理员权限。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "執行時將從 Microsoft 下載並安裝。 Windows 可能會請求管理員許可權。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ランタイムは Microsoft からダウンロードされ、インストールされます。 Windows は管理者の許可を要求する場合があります。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft에서 런타임을 다운로드하여 설치합니다. Windows에서 관리자 권한을 요청할 수 있습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Laufzeit wird von Microsoft heruntergeladen und installiert. Windows kann eine Administratorberechtigung anfordern."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le runtime sera téléchargé depuis Microsoft et installé. Windows peut demander l'autorisation de l'administrateur."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de ejecución se descargará desde Microsoft y se instalará. Windows puede solicitar permiso de administrador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de execução será baixado de Microsoft e instalado. Windows pode solicitar permissão de administrador."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Среда выполнения будет загружена с Microsoft и установлена. Windows может запросить разрешение администратора."
          }
        }
      }
    },
    "DlcNeteaseRemoveNotice": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing the enhancement will restart NetEase Music. Your library and playlists will be preserved."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "移除增强组件会重新启动网易云音乐。你的资料库和歌单将保留。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除增強功能將重新啟動 NetEase Music。您的資料庫和播放清單將會保留。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能を削除すると、NetEase Music が再起動されます。ライブラリとプレイリストは保存されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "확장 기능을 제거하면 NetEase Music이 다시 시작됩니다. 라이브러리와 재생목록은 유지됩니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Entfernen der Erweiterung wird NetEase Music neu gestartet. Ihre Bibliothek und Wiedergabelisten bleiben erhalten."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de l'amélioration entraînera le redémarrage de NetEase Music. Votre bibliothèque et vos playlists seront préservées."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar la mejora se reiniciará NetEase Music. Su biblioteca y listas de reproducción se conservarán."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A remoção do aprimoramento reiniciará NetEase Music. Sua biblioteca e playlists serão preservadas."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление улучшения приведет к перезапуску NetEase Music. Ваша библиотека и плейлисты будут сохранены."
          }
        }
      }
    },
