    "PageDescriptionClipboard": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically records copied text, images, files, and folder references."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "自动记录复制的文本、图片、文件与文件夹引用。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "自動記錄複製的文字、影象、檔案和資料夾引用。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーされたテキスト、画像、ファイル、フォルダー参照を自動的に記録します。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "복사된 텍스트, 이미지, 파일 및 폴더 참조를 자동으로 기록합니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet kopierte Texte, Bilder, Dateien und Ordnerverweise automatisch auf."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre automatiquement le texte, les images, les fichiers et les références de dossiers copiés."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra automáticamente texto, imágenes, archivos y referencias de carpetas copiados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra automaticamente textos copiados, imagens, arquivos e referências de pastas."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически записывает скопированный текст, изображения, файлы и ссылки на папки."
          }
        }
      }
    },
    "PageDescriptionPinned": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned items from Temporary Space and Clipboard are not cleared automatically by retention rules."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "来自临时空间和剪贴板的固定项目，不会因保留期限自动清理。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "保留規則不會自動清除暫存空間和剪貼簿中的固定專案。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "一時スペースとクリップボードでピン留めした項目は、保存期限の設定では自動消去されません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 공간 및 클립보드에 고정된 항목은 보관 규칙에 따라 자동으로 삭제되지 않습니다."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeheftete Elemente aus Temporärer Bereich und der Zwischenablage werden durch Aufbewahrungsregeln nicht automatisch gelöscht."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments épinglés de Espace temporaire et du Presse-papiers ne sont pas automatiquement effacés par les règles de conservation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos fijados de Espacio temporal y el Portapapeles no se borran automáticamente según las reglas de retención."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens fixados do Espaço temporário e da área de transferência não são limpos automaticamente pelas regras de retenção."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепленные элементы из Временное пространство и буфера обмена не удаляются автоматически правилами хранения."
          }
        }
      }
    },
    "PageDescriptionSettings": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Local storage, privacy, appearance, and window behavior."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "本地存储、隐私、外观和窗口行为。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本機儲存、隱私、外觀和視窗行為。"
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル ストレージ、プライバシー、外観、ウィンドウの動作。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 저장소, 개인 정보 보호, 모양 및 창 동작."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaler Speicher, Datenschutz, Erscheinungsbild und Fensterverhalten."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage local, confidentialité, apparence et comportement des fenêtres."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenamiento local, privacidad, apariencia y comportamiento de las ventanas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenamento local, privacidade, aparência e comportamento da janela."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальное хранилище, конфиденциальность, внешний вид и поведение окон."
          }
        }
      }
    },
    "PageDescriptionSpace": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag files and folders here when they do not have a permanent home yet."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "把暂时无处归类的文件与文件夹拖到这里。"
          }
